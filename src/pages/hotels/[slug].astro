---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HotelCard from '../../components/HotelCard.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import StayVisual from '../../components/StayVisual.astro';
import TripEssentials from '../../components/TripEssentials.astro';
import Faq from '../../components/Faq.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection } from 'astro:content';
import { ownPhoto } from '../../lib/images';
import photoCredits from '../../data/photo-credits.json';
import { startPrice } from '../../lib/site';
import { withTracking, AFFILIATE_REL, expediaSearchUrl, mapsUrl } from '../../lib/affiliate';

export async function getStaticPaths() {
  const hotels = await getCollection('hotels', h => h.data.status !== 'draft' && h.data.status !== 'archived');
  return hotels.map(hotel => ({
    params: { slug: hotel.slug },
    props: { hotel },
  }));
}

const { hotel } = Astro.props;
const { Content } = await hotel.render();

const allHotels = await getCollection('hotels', h => h.data.status !== 'draft' && h.data.status !== 'archived');
const relatedHotels = allHotels
  .filter(h => h.slug !== hotel.slug && h.data.category === hotel.data.category)
  .slice(0, 4);

const allCategories = await getCollection('categories');
const category = allCategories.find(c => c.slug === hotel.data.category);

const priceLabels = ['', 'Budget', 'Moderate', 'Upscale', 'Luxury', 'Ultra-Luxury'];

const seo = hotel.data.seo || {};
const metaTitle = seo.metaTitle || `${hotel.data.name} — ${hotel.data.destination} | StayAtNiche`;
const metaDesc  = seo.metaDescription || hotel.data.description;

// Only this hotel's own photos are ever shown (never a generic category picture).
const photo = ownPhoto(hotel.data.coverImage, hotel.slug);
const credit = (photoCredits as Record<string, any>)[hotel.slug];
const gallery = hotel.data.gallery.map((g: string) => ownPhoto(g)).filter(Boolean) as string[];
const hotelImageOg = photo ? `https://stayatniche.com${photo}` : 'https://stayatniche.com/og-default.png';

const bookUrlTracked = withTracking(hotel.data.bookingUrl, { campaign: 'hotel-detail', content: hotel.slug });
const isBooking = /booking\.com/.test(hotel.data.bookingUrl);
const q = encodeURIComponent(`${hotel.data.name}, ${hotel.data.destination.split(',')[0]}`);
const offers = [
  ...(isBooking ? [{ name: 'Booking.com', note: 'Free cancellation on many rooms', url: withTracking(hotel.data.bookingUrl, { campaign: 'hotel-offer', content: hotel.slug }) }] : []),
  { name: 'Expedia', note: 'Bundle with flights to save', url: withTracking(`https://www.expedia.com/Hotel-Search?destination=${q}&adults=2`, { campaign: 'hotel-offer', content: hotel.slug }) },
  ...(!isBooking ? [{ name: 'Official partner', note: 'Check availability', url: bookUrlTracked }] : []),
];
const from = startPrice(hotel.data.priceRange);
const mapSrc = hotel.data.coordinates ? (() => { const { lat, lng } = hotel.data.coordinates!; const d = 0.35, f = (x: number) => x.toFixed(4); return `https://www.openstreetmap.org/export/embed.html?bbox=${f(lng - d)}%2C${f(lat - d * 0.6)}%2C${f(lng + d)}%2C${f(lat + d * 0.6)}&layer=mapnik&marker=${lat}%2C${lng}`; })() : null;
const facts = [
  ['Typical price', `${hotel.data.priceRange} / night`],
  ['Price level', priceLabels[hotel.data.priceIndicator]],
  ...(hotel.data.seasonalInfo ? [['Best time to go', hotel.data.seasonalInfo.bestTime]] : []),
  ...(hotel.data.checkInOut ? [['Check-in / out', `${hotel.data.checkInOut.checkIn} / ${hotel.data.checkInOut.checkOut}`]] : []),
  ...(hotel.data.bestFor.length ? [['Best for', hotel.data.bestFor.slice(0, 3).join(', ')]] : []),
  ['Editor score', `${hotel.data.rating.toFixed(1)} / 10`],
];
const expediaUrl = expediaSearchUrl(hotel.data.destination, hotel.data.country);
const locQuery = hotel.data.coordinates
  ? `${hotel.data.coordinates.lat},${hotel.data.coordinates.lng}`
  : `${hotel.data.name} ${hotel.data.destination}`;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://stayatniche.com/" },
    { "@type": "ListItem", "position": 2, "name": "Categories", "item": "https://stayatniche.com/categories/" },
    ...(category ? [{ "@type": "ListItem", "position": 3, "name": category.data.title, "item": `https://stayatniche.com/categories/${hotel.data.category}/` }] : []),
    { "@type": "ListItem", "position": category ? 4 : 3, "name": hotel.data.name, "item": `https://stayatniche.com/hotels/${hotel.slug}/` },
  ],
};

const hotelJsonLd = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "name": hotel.data.name,
  "description": hotel.data.description,
  "url": `https://stayatniche.com/hotels/${hotel.slug}`,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": hotel.data.destination,
    "addressCountry": hotel.data.country,
  },
  ...(hotel.data.coordinates ? {
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": hotel.data.coordinates.lat,
      "longitude": hotel.data.coordinates.lng,
    }
  } : {}),
  "image": hotelImageOg,
  // NOTE: no aggregateRating on purpose. We don't collect guest reviews, and
  // marking up an editorial score as one violates Google's review guidelines.
  "priceRange": hotel.data.priceRange,
  ...(hotel.data.amenities.length ? {
    "amenityFeature": hotel.data.amenities.map((n: string) => ({ "@type": "LocationFeatureSpecification", "name": n, "value": true })),
  } : {}),
  ...(hotel.data.checkInOut ? { "checkinTime": hotel.data.checkInOut.checkIn, "checkoutTime": hotel.data.checkInOut.checkOut } : {}),
  "isPartOf": { "@type": "WebSite", "name": "StayAtNiche", "url": "https://stayatniche.com/" },
};

const fromPrice = hotel.data.priceRange.split(/\s[-–]\s/)[0];
const faqItems: { q: string; a: string }[] = [
  {
    q: `Where is ${hotel.data.name}?`,
    a: `${hotel.data.name} is in ${hotel.data.destination}, ${hotel.data.country}${hotel.data.address ? ` (${hotel.data.address})` : ''}. It is featured in our ${category?.data.title ?? 'unique stays'} collection.`,
  },
  {
    q: `How much does ${hotel.data.name} cost per night?`,
    a: `Rates typically run ${hotel.data.priceRange} per night (${priceLabels[hotel.data.priceIndicator]?.toLowerCase()} tier). Prices change with season and availability, so check live rates before you plan.`,
  },
  ...(hotel.data.seasonalInfo ? [{
    q: `When is the best time to visit ${hotel.data.name}?`,
    a: `${hotel.data.seasonalInfo.bestTime}.${hotel.data.seasonalInfo.notes ? ' ' + hotel.data.seasonalInfo.notes : ''}`,
  }] : []),
  ...(hotel.data.bestFor.length ? [{
    q: `Who is ${hotel.data.name} best for?`,
    a: `${hotel.data.name} suits ${hotel.data.bestFor.join(', ').toLowerCase()}.`,
  }] : []),
  ...(hotel.data.checkInOut ? [{
    q: `What are the check-in and check-out times at ${hotel.data.name}?`,
    a: `Check-in is from ${hotel.data.checkInOut.checkIn} and check-out is by ${hotel.data.checkInOut.checkOut}. Confirm with the property when you book.`,
  }] : []),
  ...(hotel.data.nearbyAttractions.length ? [{
    q: `What is there to do near ${hotel.data.name}?`,
    a: `Nearby: ${hotel.data.nearbyAttractions.map((n: any) => `${n.name} (${n.distance})`).join('; ')}.`,
  }] : []),
];
---

<BaseLayout title={metaTitle} description={metaDesc} image={hotelImageOg} heroImage={photo ?? undefined} type="article" hideBottomNav={true} updatedTime={hotel.data.updatedDate?.toISOString()}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(hotelJsonLd)} />

  <article class="mx-auto max-w-7xl px-4 pb-8 pt-6 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="font-body text-sm text-warm-500">
      <a href="/" class="hover:text-warm-950">Home</a> <span class="mx-1 text-warm-300">/</span>
      <a href={`/categories/${hotel.data.category}/`} class="hover:text-warm-950">{category?.data.title ?? 'Stays'}</a> <span class="mx-1 text-warm-300">/</span>
      <span class="text-warm-800">{hotel.data.name}</span>
    </nav>

    <header class="mt-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow text-gold-600">{category?.data.title ?? hotel.data.category.replace(/-/g, ' ')}{hotel.data.editorsPick || hotel.data.featured ? ' · Editor’s pick' : ''}</p>
        <h1 class="mt-2 font-display text-5xl leading-[.95] text-warm-950 sm:text-6xl lg:text-7xl">{hotel.data.name}</h1>
        <p class="mt-3 font-body text-[15px] text-warm-600">{hotel.data.destination}, {hotel.data.country} <span class="mx-1.5 text-warm-300">·</span> <span class="font-semibold text-warm-950">★ {hotel.data.rating.toFixed(1)}</span> <span class="text-warm-500">editor score</span></p>
      </div>
      <div class="flex gap-2">
        <button type="button" data-save={hotel.slug} aria-pressed="false" class="save-btn inline-flex items-center gap-2 rounded-full border border-warm-300 bg-white px-4 py-2 font-body text-sm font-semibold text-warm-900 hover:border-warm-500">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3 5.5 6.2 5.5c1.9 0 3.2 1 3.8 2 .6-1 1.9-2 3.8-2 3.2 0 5 3.1 3.7 6.3C19.5 16.4 12 21 12 21Z"/></svg>Save
        </button>
        <button type="button" data-share class="inline-flex items-center gap-2 rounded-full border border-warm-300 bg-white px-4 py-2 font-body text-sm font-semibold text-warm-900 hover:border-warm-500">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 12v7a1 1 0 001 1h14a1 1 0 001-1v-7M12 3v12M7 8l5-5 5 5"/></svg>Share
        </button>
      </div>
    </header>

    <!-- Visual -->
    <div class:list={['mt-6 grid gap-2 overflow-hidden rounded-2xl', gallery.length ? 'md:grid-cols-[2fr_1fr]' : '']}>
      <div class:list={['group overflow-hidden bg-warm-100', photo ? 'aspect-[16/10] md:aspect-[16/8]' : 'aspect-[16/10] md:aspect-[16/6]']}>
        <StayVisual slug={hotel.slug} name={hotel.data.name} category={hotel.data.category} destination={hotel.data.destination} country={hotel.data.country} coverImage={hotel.data.coverImage} eager size="hero" />
      </div>
      {gallery.length > 0 && (
        <div class="hidden grid-rows-2 gap-2 md:grid">
          {gallery.slice(0, 2).map((g, i) => <img src={g} alt={`${hotel.data.name}, photo ${i + 2}`} class="h-full w-full object-cover" loading="lazy" />)}
        </div>
      )}
    </div>
    {!photo && <p class="mt-2 font-body text-xs text-warm-400">Photos of this property are on its booking pages.</p>}
    {photo && credit && (
      <p class="mt-2 font-body text-xs text-warm-400">Photo: <a href={credit.source} target="_blank" rel="noopener noreferrer" class="underline">{credit.author}</a>, {credit.licenseUrl ? <a href={credit.licenseUrl} target="_blank" rel="noopener noreferrer license" class="underline">{credit.license}</a> : credit.license}, via Wikimedia Commons</p>
    )}

    <div class="mt-10 grid gap-12 lg:grid-cols-[1fr_380px] lg:gap-16">
      <!-- Main column -->
      <div class="min-w-0">
        <p class="font-display text-[1.7rem] leading-snug text-warm-900 sm:text-3xl">{hotel.data.description}</p>

        <dl class="mt-10 grid grid-cols-2 border-t border-warm-200 sm:grid-cols-3">
          {facts.map(([k, v]) => (
            <div class="border-b border-warm-200 py-4 pr-4">
              <dt class="eyebrow text-warm-500">{k}</dt>
              <dd class="mt-1.5 font-body text-[15px] font-medium text-warm-950">{v}</dd>
            </div>
          ))}
        </dl>

        {hotel.data.highlights.length > 0 && (
          <section class="mt-12">
            <h2 class="font-display text-3xl leading-none text-warm-950">Why it’s on the list</h2>
            <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
              {hotel.data.highlights.map((h: string) => (
                <li class="flex gap-3 font-body text-[15px] text-warm-800"><span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold-500"></span>{h}</li>
              ))}
            </ul>
          </section>
        )}

        <div class="prose prose-lg mt-12 max-w-none font-body prose-headings:font-display prose-headings:font-normal prose-headings:text-warm-950 prose-h2:text-3xl prose-p:text-warm-700 prose-p:leading-[1.75] prose-a:text-forest-700 prose-strong:text-warm-950">
          <Content />
        </div>

        <AdSlot slot="hotel-inline" />

        {(hotel.data.amenities.length > 0 || hotel.data.prosAndCons) && (
          <section class="mt-12 grid gap-10 border-t border-warm-200 pt-10 sm:grid-cols-2">
            {hotel.data.amenities.length > 0 && (
              <div>
                <h2 class="font-display text-3xl leading-none text-warm-950">What’s included</h2>
                <ul class="mt-5 space-y-2.5">
                  {hotel.data.amenities.map((a: string) => <li class="flex gap-3 font-body text-[15px] text-warm-800"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-forest-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{a}</li>)}
                </ul>
              </div>
            )}
            {hotel.data.prosAndCons && (
              <div>
                <h2 class="font-display text-3xl leading-none text-warm-950">Good to know</h2>
                <ul class="mt-5 space-y-2.5">
                  {hotel.data.prosAndCons.pros.map((x: string) => <li class="flex gap-3 font-body text-[15px] text-warm-800"><span class="font-semibold text-forest-700">+</span>{x}</li>)}
                  {hotel.data.prosAndCons.cons.map((x: string) => <li class="flex gap-3 font-body text-[15px] text-warm-800"><span class="font-semibold text-gold-700">−</span>{x}</li>)}
                </ul>
              </div>
            )}
          </section>
        )}

        <section class="mt-12 border-t border-warm-200 pt-10">
          <h2 class="font-display text-3xl leading-none text-warm-950">Where it is</h2>
          <p class="mt-2 font-body text-[15px] text-warm-600">{hotel.data.address ?? `${hotel.data.destination}, ${hotel.data.country}`}</p>
          {mapSrc && (
            <div class="mt-5 aspect-[16/9] overflow-hidden rounded-xl border border-warm-200 bg-warm-100">
              <iframe src={mapSrc} title={`Map of ${hotel.data.name}`} loading="lazy" class="h-full w-full" referrerpolicy="no-referrer"></iframe>
            </div>
          )}
          <a href={mapsUrl(locQuery)} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block font-body text-sm font-semibold text-warm-950 underline underline-offset-4">Open in Google Maps ↗</a>
          {hotel.data.nearbyAttractions.length > 0 && (
            <ul class="mt-6 divide-y divide-warm-200 border-y border-warm-200">
              {hotel.data.nearbyAttractions.map((a: any) => <li class="flex justify-between gap-4 py-3 font-body text-[15px]"><span class="text-warm-800">{a.name}</span><span class="tabular-nums text-warm-500">{a.distance}</span></li>)}
            </ul>
          )}
        </section>

        <div class="mt-12 border-t border-warm-200 pt-10">
          <TripEssentials destination={hotel.data.destination} country={hotel.data.country} subId={hotel.slug} />
        </div>

        <div class="mt-12">
          <Faq items={faqItems} heading="Quick answers" />
        </div>
      </div>

      <!-- Booking card -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-2xl border border-warm-200 bg-white p-6 shadow-card">
          <p class="font-body text-sm text-warm-600">{from ? <>From <span class="font-display text-4xl text-warm-950">${from.toLocaleString('en-US')}</span> / night</> : 'Rates vary'}</p>
          <p class="mt-1 font-body text-xs text-warm-500">Typical range {hotel.data.priceRange}. Live price depends on dates.</p>
          <a href={offers[0].url} target="_blank" rel={AFFILIATE_REL} data-cta="primary" class="mt-5 flex w-full items-center justify-center rounded-xl bg-forest-700 px-5 py-4 font-body text-[15px] font-semibold text-white transition hover:bg-forest-800">Check availability on {offers[0].name}</a>
          <p class="mt-5 eyebrow text-warm-500">Compare</p>
          <ul class="mt-2 divide-y divide-warm-200 border-y border-warm-200">
            {offers.map(o => (
              <li><a href={o.url} target="_blank" rel={AFFILIATE_REL} class="group flex items-center justify-between py-3">
                <span><span class="block font-body text-sm font-semibold text-warm-950">{o.name}</span><span class="block font-body text-xs text-warm-500">{o.note}</span></span>
                <span class="font-body text-sm font-semibold text-forest-700 group-hover:underline">View ↗</span>
              </a></li>
            ))}
          </ul>
          <p class="mt-4 font-body text-[11px] leading-relaxed text-warm-400">We may earn a commission if you book, at no extra cost to you. <a href="/disclosure/" class="underline">Disclosure</a></p>
        </div>
        {hotel.data.seasonalInfo?.notes && (
          <div class="mt-4 rounded-2xl bg-warm-100 p-5">
            <p class="eyebrow text-warm-500">Timing tip</p>
            <p class="mt-2 font-body text-sm leading-relaxed text-warm-800">{hotel.data.seasonalInfo.notes}</p>
          </div>
        )}
      </aside>
    </div>
  </article>

  {relatedHotels.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-end justify-between border-b border-warm-200 pb-5">
        <h2 class="font-display text-4xl leading-none text-warm-950">More {category?.data.title.toLowerCase()}</h2>
        <a href={`/categories/${hotel.data.category}/`} class="font-body text-sm font-semibold text-warm-950 underline underline-offset-4">See all</a>
      </div>
      <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {relatedHotels.map(h => (
          <HotelCard name={h.data.name} destination={h.data.destination} country={h.data.country} description={h.data.description} priceRange={h.data.priceRange} priceIndicator={h.data.priceIndicator} rating={h.data.rating} highlights={h.data.highlights} bookingUrl={h.data.bookingUrl} slug={h.slug} category={h.data.category} featured={h.data.featured} coverImage={h.data.coverImage} />
        ))}
      </div>
    </section>
  )}

  <!-- Mobile booking bar -->
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-warm-200 bg-white/95 px-4 pb-[calc(.75rem+env(safe-area-inset-bottom))] pt-3 backdrop-blur lg:hidden">
    <div class="mx-auto flex max-w-lg items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class="truncate font-body text-sm font-semibold text-warm-950">{from ? `From $${from.toLocaleString('en-US')}` : hotel.data.priceRange} <span class="font-normal text-warm-500">/ night</span></p>
        <p class="truncate font-body text-xs text-warm-500">{hotel.data.name}</p>
      </div>
      <a href={offers[0].url} target="_blank" rel={AFFILIATE_REL} class="flex-shrink-0 rounded-xl bg-forest-700 px-6 py-3 font-body text-sm font-semibold text-white">Check rates</a>
    </div>
  </div>
  <div class="h-20 lg:hidden"></div>

  <script is:inline>
    document.querySelectorAll('[data-share]').forEach(function (b) {
      b.addEventListener('click', function () {
        var d = { title: document.title, url: location.href };
        if (navigator.share) navigator.share(d).catch(function () {});
        else if (navigator.clipboard) navigator.clipboard.writeText(location.href).then(function () { b.lastChild.textContent = 'Link copied'; });
      });
    });
  </script>
</BaseLayout>
