---
import HotelView from '../../views/HotelView.astro';
import { localized } from '../../i18n/content';

export async function getStaticPaths() {
  return (await localized('hotels', 'en')).map(hotel => ({ params: { slug: hotel.slug }, props: { hotel } }));
}
---
<HotelView locale="en" hotel={Astro.props.hotel} />
