---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HotelCard from '../../components/HotelCard.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import AffiliateBookingBox from '../../components/AffiliateBookingBox.astro';
import TransportationBox from '../../components/TransportationBox.astro';
import TravelServicesBox from '../../components/TravelServicesBox.astro';
import { getCollection } from 'astro:content';
import { resolveImage, sizedImage } from '../../lib/images';
import { withTracking, AFFILIATE_REL, expediaSearchUrl, mapsUrl } from '../../lib/affiliate';

export async function getStaticPaths() {
  const hotels = await getCollection('hotels', h => h.data.status !== 'draft' && h.data.status !== 'archived');
  return hotels.map(hotel => ({
    params: { slug: hotel.slug },
    props: { hotel },
  }));
}

const { hotel } = Astro.props;
const { Content } = await hotel.render();

const allHotels = await getCollection('hotels', h => h.data.status !== 'draft' && h.data.status !== 'archived');
const relatedHotels = allHotels
  .filter(h => h.slug !== hotel.slug && h.data.category === hotel.data.category)
  .slice(0, 4);

const allCategories = await getCollection('categories');
const category = allCategories.find(c => c.slug === hotel.data.category);

const priceLabels = ['', 'Budget', 'Moderate', 'Upscale', 'Luxury', 'Ultra-Luxury'];

const seo = hotel.data.seo || {};
const metaTitle = seo.metaTitle || `${hotel.data.name} — ${hotel.data.destination} | StayAtNiche`;
const metaDesc  = seo.metaDescription || hotel.data.description;

const hotelImage = resolveImage(hotel.data.coverImage, { category: hotel.data.category, slug: hotel.slug });
const hotelImageLg = sizedImage(hotelImage, 1600);
const hotelImageOg = sizedImage(hotelImage, 1200);

const bookUrlTracked = withTracking(hotel.data.bookingUrl, { campaign: 'hotel-detail', content: hotel.slug });
const expediaUrl = expediaSearchUrl(hotel.data.destination, hotel.data.country);
const locQuery = hotel.data.coordinates
  ? `${hotel.data.coordinates.lat},${hotel.data.coordinates.lng}`
  : `${hotel.data.name} ${hotel.data.destination}`;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://stayatniche.com/" },
    { "@type": "ListItem", "position": 2, "name": "Categories", "item": "https://stayatniche.com/categories/" },
    ...(category ? [{ "@type": "ListItem", "position": 3, "name": category.data.title, "item": `https://stayatniche.com/categories/${hotel.data.category}/` }] : []),
    { "@type": "ListItem", "position": category ? 4 : 3, "name": hotel.data.name, "item": `https://stayatniche.com/hotels/${hotel.slug}/` },
  ],
};

const hotelJsonLd = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "name": hotel.data.name,
  "description": hotel.data.description,
  "url": `https://stayatniche.com/hotels/${hotel.slug}`,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": hotel.data.destination,
    "addressCountry": hotel.data.country,
  },
  ...(hotel.data.coordinates ? {
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": hotel.data.coordinates.lat,
      "longitude": hotel.data.coordinates.lng,
    }
  } : {}),
  "image": hotelImageOg,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": hotel.data.rating,
    "bestRating": 10,
    "ratingCount": hotel.data.reviewCount,
  },
  "priceRange": hotel.data.priceRange,
};
---

<BaseLayout title={metaTitle} description={metaDesc} image={hotelImageOg} heroImage={hotelImageLg} type="article">

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(hotelJsonLd)} />

  <!-- Hero -->
  <section class="relative bg-warm-50 overflow-hidden pt-8 pb-12">
    <div class="dot-pattern absolute inset-0 opacity-70 pointer-events-none" />

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex flex-wrap items-center gap-1.5 text-warm-500 text-sm font-body mb-8">
        <a href="/" class="hover:text-warm-800 transition-colors">Home</a>
        <span class="text-warm-300">/</span>
        <a href="/categories" class="hover:text-warm-800 transition-colors">Categories</a>
        <span class="text-warm-300">/</span>
        {category && (
          <>
            <a href={`/categories/${hotel.data.category}`} class="hover:text-warm-800 transition-colors">
              {category.data.title}
            </a>
            <span class="text-warm-300">/</span>
          </>
        )}
        <span class="text-warm-800 font-medium">{hotel.data.name}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start">

        <!-- Left: hotel info -->
        <div class="lg:col-span-2">
          <!-- Category badge -->
          <a
            href={`/categories/${hotel.data.category}`}
            class="inline-flex items-center gap-2 bg-warm-100 hover:bg-warm-200 border border-warm-200 rounded-full px-3.5 py-1.5 mb-5 transition-colors"
          >
            <CategoryIcon slug={hotel.data.category} size={14} class="text-forest-600" />
            <span class="font-body text-warm-700 text-xs font-semibold">
              {category?.data.title || hotel.data.category.replace(/-/g, ' ')}
            </span>
          </a>

          <!-- Badges row -->
          <div class="flex flex-wrap gap-2 mb-4">
            {hotel.data.featured && (
              <span class="inline-flex items-center gap-1.5 bg-gold-100 text-gold-700 border border-gold-200 rounded-full px-3 py-1 text-xs font-body font-semibold">
                <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1l2.6 5.9 6.4.6-4.9 4.3 1.5 6.2L10 15l-5.6 2.9 1.5-6.2L1 7.5l6.4-.6L10 1z"/></svg>
                Featured
              </span>
            )}
            {hotel.data.editorsPick && (
              <span class="inline-flex items-center gap-1.5 bg-forest-100 text-forest-700 border border-forest-200 rounded-full px-3 py-1 text-xs font-body font-semibold">
                <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2l2 4.5 4.9.6-3.6 3.3.9 4.8L10 13l-4.2 2.2.9-4.8L3.1 7.1l4.9-.6L10 2z"/></svg>
                Editor's pick
              </span>
            )}
            {hotel.data.trending && (
              <span class="inline-flex items-center gap-1.5 bg-warm-200 text-warm-700 border border-warm-300 rounded-full px-3 py-1 text-xs font-body font-semibold">
                <svg class="w-3 h-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 14l4-4 3 3 5-6"/><path stroke-linecap="round" stroke-linejoin="round" d="M11 7h5v5"/></svg>
                Trending
              </span>
            )}
          </div>

          <h1 class="font-display text-4xl sm:text-5xl font-bold text-warm-950 mb-4 leading-tight">
            {hotel.data.name}
          </h1>

          <!-- Meta row -->
          <div class="flex flex-wrap items-center gap-5 mb-6">
            <div class="flex items-center gap-1.5 text-warm-600 font-body text-sm">
              <svg class="w-4 h-4 text-warm-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {hotel.data.destination}, {hotel.data.country}
            </div>
            <div class="flex items-center gap-1.5">
              <div class="flex items-center gap-1 bg-gold-50 border border-gold-200 rounded-full px-3 py-1">
                <svg class="w-3.5 h-3.5 text-gold-500 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <span class="font-display font-bold text-warm-900 text-sm">{hotel.data.rating}</span>
                <span class="font-body text-warm-500 text-xs">/ 10</span>
              </div>
              <span class="font-body text-warm-500 text-xs">({hotel.data.reviewCount.toLocaleString()} reviews)</span>
            </div>
          </div>

          <p class="font-body text-warm-700 text-lg leading-relaxed max-w-2xl">
            {hotel.data.description}
          </p>
        </div>

        <!-- Right: booking card (sticky) -->
        <div class="lg:sticky lg:top-28 space-y-4">
          <!-- Price summary -->
          <div class="bg-white rounded-2xl border border-warm-200 shadow-card-hover p-5">
            <div class="flex items-end justify-between mb-4">
              <div>
                <span class="font-body text-warm-400 text-xs uppercase tracking-wider">From</span>
                <div class="font-display text-2xl font-bold text-warm-950 mt-0.5">{hotel.data.priceRange.split(/\s[-–]\s/)[0]}</div>
                <span class="font-body text-warm-400 text-xs">per night</span>
              </div>
              <span class="bg-warm-100 text-warm-600 font-body text-xs px-3 py-1 rounded-full border border-warm-200">
                {priceLabels[hotel.data.priceIndicator]}
              </span>
            </div>

            <!-- Why guests love it -->
            {hotel.data.highlights.length > 0 && (
              <div class="pt-4 border-t border-warm-100">
                <p class="font-body text-warm-400 text-xs uppercase tracking-wider font-semibold mb-3">Why guests love it</p>
                {hotel.data.highlights.slice(0, 3).map((h: string) => (
                  <div class="flex items-start gap-2 mb-2">
                    <svg class="w-4 h-4 text-forest-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                    <span class="font-body text-warm-600 text-sm">{h}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Multi-partner booking box -->
          <AffiliateBookingBox
            hotelName={hotel.data.name}
            destination={hotel.data.destination}
            country={hotel.data.country}
            bookingUrl={hotel.data.bookingUrl}
            priceRange={hotel.data.priceRange}
            type="hotel"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Cover image / Gallery -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="rounded-3xl overflow-hidden h-72 sm:h-[480px] relative bg-warm-100">
      <img
        src={hotelImageLg}
        srcset={`${sizedImage(hotelImage, 800)} 800w, ${sizedImage(hotelImage, 1200)} 1200w, ${hotelImageLg} 1600w`}
        sizes="(max-width: 1024px) 100vw, 1200px"
        alt={hotel.data.name}
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        width="1600"
        height="900"
      />
    </div>
    {hotel.data.gallery && hotel.data.gallery.length > 0 && (
      <div class="grid grid-cols-3 sm:grid-cols-4 gap-2 mt-2">
        {hotel.data.gallery.slice(0, 8).map((img: string, i: number) => {
          const resolved = resolveImage(img, { category: hotel.data.category, slug: hotel.slug });
          return (
            <div class="rounded-xl overflow-hidden aspect-square bg-warm-100">
              <img src={sizedImage(resolved, 400)} alt={`${hotel.data.name} — photo ${i + 1}`} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" width="400" height="400" />
            </div>
          );
        })}
      </div>
    )}
  </section>

  <!-- Detailed content -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

      <!-- Main review content -->
      <div class="lg:col-span-2">
        <div class="prose prose-warm max-w-none
          prose-headings:font-display prose-headings:text-warm-950
          prose-p:font-body prose-p:text-warm-700 prose-p:leading-relaxed
          prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-10 prose-h2:mb-4
          prose-h3:text-xl prose-h3:font-bold prose-h3:mt-7 prose-h3:mb-3
          prose-strong:text-warm-900 prose-a:text-forest-600 hover:prose-a:underline">
          <Content />
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-5">

        <!-- Amenities -->
        {hotel.data.amenities.length > 0 && (
          <div class="bg-white rounded-2xl border border-warm-200 shadow-card p-6">
            <h3 class="font-display text-lg font-bold text-warm-950 mb-4">Amenities</h3>
            <div class="grid grid-cols-2 gap-x-4 gap-y-2.5">
              {hotel.data.amenities.map((amenity: string) => (
                <div class="flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-forest-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                  <span class="font-body text-warm-600 text-sm">{amenity}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Best For -->
        {hotel.data.bestFor.length > 0 && (
          <div class="bg-white rounded-2xl border border-warm-200 shadow-card p-6">
            <h3 class="font-display text-lg font-bold text-warm-950 mb-4">Best For</h3>
            <div class="flex flex-wrap gap-2">
              {hotel.data.bestFor.map((tag: string) => (
                <span class="bg-warm-100 text-warm-700 font-body text-xs px-3 py-1.5 rounded-full border border-warm-200 font-medium">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Pros & Cons -->
        {hotel.data.prosAndCons && (
          <div class="bg-white rounded-2xl border border-warm-200 shadow-card p-6">
            <h3 class="font-display text-lg font-bold text-warm-950 mb-4">Pros & Cons</h3>
            {hotel.data.prosAndCons.pros?.length > 0 && (
              <div class="mb-4">
                <p class="font-body text-xs font-semibold text-forest-600 uppercase tracking-wider mb-2">Pros</p>
                {hotel.data.prosAndCons.pros.map((p: string) => (
                  <div class="flex items-start gap-2 mb-1.5">
                    <svg class="w-3.5 h-3.5 text-forest-500 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" d="M10 4v12M4 10h12"/></svg>
                    <span class="font-body text-warm-600 text-sm">{p}</span>
                  </div>
                ))}
              </div>
            )}
            {hotel.data.prosAndCons.cons?.length > 0 && (
              <div>
                <p class="font-body text-xs font-semibold text-red-500 uppercase tracking-wider mb-2">Cons</p>
                {hotel.data.prosAndCons.cons.map((c: string) => (
                  <div class="flex items-start gap-2 mb-1.5">
                    <svg class="w-3.5 h-3.5 text-red-400 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" d="M4 10h12"/></svg>
                    <span class="font-body text-warm-600 text-sm">{c}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        <!-- Seasonal info -->
        {hotel.data.seasonalInfo && (
          <div class="bg-warm-50 rounded-2xl border border-warm-200 p-6">
            <h3 class="font-display text-base font-bold text-warm-950 mb-3">Best Time to Visit</h3>
            <p class="font-body text-forest-700 text-sm font-semibold mb-1">{hotel.data.seasonalInfo.bestTime}</p>
            {hotel.data.seasonalInfo.notes && (
              <p class="font-body text-warm-600 text-xs leading-relaxed">{hotel.data.seasonalInfo.notes}</p>
            )}
          </div>
        )}

        <!-- Location -->
        <div class="bg-white rounded-2xl border border-warm-200 shadow-card p-6">
          <h3 class="font-display text-lg font-bold text-warm-950 mb-4">Location</h3>
          <div class="bg-warm-100 rounded-xl h-36 flex items-center justify-center mb-3 border border-warm-200">
            <div class="text-center">
              <svg class="w-8 h-8 text-warm-400 mx-auto mb-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <p class="font-body text-warm-600 text-sm font-medium">{hotel.data.destination}</p>
              <p class="font-body text-warm-400 text-xs">{hotel.data.country}</p>
            </div>
          </div>
          {hotel.data.address && (
            <p class="font-body text-warm-500 text-sm mt-1 mb-3">{hotel.data.address}</p>
          )}
          <a
            href={mapsUrl(locQuery)}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full border border-warm-200 hover:border-forest-400 hover:bg-forest-50 text-warm-700 hover:text-forest-700 font-body text-sm font-medium px-4 py-2.5 rounded-xl transition-all mt-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            View on Google Maps
          </a>
        </div>
      <!-- Nearby attractions -->
        {hotel.data.nearbyAttractions.length > 0 && (
          <div class="bg-white rounded-2xl border border-warm-200 shadow-card p-6">
            <h3 class="font-display text-lg font-bold text-warm-950 mb-4">Nearby Attractions</h3>
            <div class="space-y-2.5">
              {hotel.data.nearbyAttractions.map((attraction: any) => (
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-start gap-2">
                    <svg class="w-3 h-3 text-gold-400 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1l2.6 5.9 6.4.6-4.9 4.3 1.5 6.2L10 15l-5.6 2.9 1.5-6.2L1 7.5l6.4-.6L10 1z"/></svg>
                    <span class="font-body text-warm-700 text-sm">{attraction.name}</span>
                  </div>
                  <span class="font-body text-warm-400 text-xs flex-shrink-0 mt-0.5">{attraction.distance}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- How to Get There -->
        <TransportationBox
          destination={hotel.data.destination}
          country={hotel.data.country}
          category={hotel.data.category}
        />

        <!-- Travel Essentials -->
        <TravelServicesBox
          destination={hotel.data.destination}
          country={hotel.data.country}
        />

      </div>
    </div>
  </section>

  <!-- Sticky booking CTA (mobile) -->
  <div class="fixed bottom-0 left-0 right-0 z-40 lg:hidden bg-white border-t border-warm-200 px-4 py-3 shadow-lg">
    <div class="flex items-center gap-3 max-w-lg mx-auto">
      <div class="flex-1 min-w-0">
        <p class="font-body text-warm-400 text-xs">From</p>
        <p class="font-display font-bold text-warm-950 text-base truncate">{hotel.data.priceRange.split(/\s[-–]\s/)[0]}<span class="font-body text-warm-400 text-xs font-normal"> / night</span></p>
      </div>
      <a
        href={bookUrlTracked}
        target="_blank"
        rel={AFFILIATE_REL}
        class="flex-shrink-0 bg-forest-600 hover:bg-forest-700 text-white font-body font-bold text-sm px-6 py-3 rounded-full transition-all active:scale-95"
      >
        Check rates
      </a>
    </div>
  </div>

  <!-- CTA Banner -->
  <section class="bg-warm-100 border-y border-warm-200 mb-16 lg:mb-0">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <h2 class="font-display text-2xl font-bold text-warm-950 mb-4">
        Ready to book {hotel.data.name}?
      </h2>
      <p class="font-body text-warm-600 text-sm mb-8">Compare rates across platforms. Free cancellation on most rooms.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={bookUrlTracked}
          target="_blank"
          rel={AFFILIATE_REL}
          class="inline-flex items-center justify-center gap-2 bg-forest-600 hover:bg-forest-700 text-white font-body font-bold text-base px-8 py-4 rounded-full transition-all hover:shadow-lg active:scale-95"
        >
          Check availability
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a
          href={expediaUrl}
          target="_blank"
          rel={AFFILIATE_REL}
          class="inline-flex items-center justify-center gap-2 bg-[#00356B] hover:bg-[#002a55] text-white font-body font-bold text-base px-8 py-4 rounded-full transition-all hover:shadow-lg active:scale-95"
        >
          Compare on Expedia
        </a>
      </div>
      <p class="font-body text-warm-400 text-xs mt-4">
        Affiliate links — we earn a small commission at no extra cost to you.
      </p>
    </div>
  </section>

  <!-- Related hotels -->
  {relatedHotels.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="font-display text-2xl font-bold text-warm-950 mb-8">
        More <span class="text-gold-500">{category?.data.title}</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {relatedHotels.map(h => (
          <HotelCard
            name={h.data.name}
            destination={h.data.destination}
            country={h.data.country}
