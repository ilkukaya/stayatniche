---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slugify, isLive } from '../../lib/site';
const hotels = await getCollection('hotels', isLive);
const m = new Map<string, number>();
for (const h of hotels) m.set(h.data.country, (m.get(h.data.country) ?? 0) + 1);
const rows = [...m.entries()].filter(([, n]) => n >= 2).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<BaseLayout title="Unusual Hotels by Country" description="Browse extraordinary hotels country by country: treehouses, caves, safari lodges, overwater villas and more.">
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-4xl font-bold text-warm-950">Unusual hotels by country</h1>
    <p class="mt-3 font-body text-warm-600">Pick a country to compare its most extraordinary stays.</p>
    <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {rows.map(([c, n]) => (
        <li><a href={`/countries/${slugify(c)}/`} class="flex items-center justify-between rounded-xl border border-warm-200 bg-white px-4 py-3 font-body text-sm hover:border-forest-400"><span class="font-semibold text-warm-900">{c}</span><span class="text-warm-400">{n}</span></a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
