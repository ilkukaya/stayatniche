---
import DestinationView from '../../views/DestinationView.astro';
import { localized } from '../../i18n/content';

export async function getStaticPaths() {
  return (await localized('destinations', 'en')).map(dest => ({ params: { slug: dest.slug }, props: { dest } }));
}
---
<DestinationView locale="en" dest={Astro.props.dest} />
