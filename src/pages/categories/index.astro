---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { getCollection } from 'astro:content';

const allCategories = await getCollection('categories');
const sortedCategories = allCategories.sort((a, b) => a.data.order - b.data.order);
const featuredCategories = sortedCategories.filter(c => c.data.featured);
const otherCategories    = sortedCategories.filter(c => !c.data.featured);
---

<BaseLayout
  title="All Niche Hotel Categories | StayAtNiche"
  description="Browse all extraordinary hotel categories — treehouses, caves, underwater rooms, castles, floating hotels, and bubble domes. Find your perfect niche stay."
>

  <!-- Hero -->
  <section class="relative bg-warm-50 overflow-hidden py-16">
    <div class="dot-pattern absolute inset-0 opacity-80 pointer-events-none" />
    <div class="absolute -top-20 -right-20 w-80 h-80 bg-gold-100/70 rounded-full blur-3xl pointer-events-none" />
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <nav class="flex items-center justify-center gap-2 text-warm-500 text-sm font-body mb-8">
        <a href="/" class="hover:text-warm-800 transition-colors">Home</a>
        <span class="text-warm-300">/</span>
        <span class="text-warm-800 font-medium">Categories</span>
      </nav>
      <div class="inline-flex items-center gap-2 bg-white border border-warm-200 rounded-full px-4 py-1.5 mb-6 shadow-soft">
        <span class="text-gold-500 text-sm">✦</span>
        <span class="font-body text-warm-600 text-sm font-medium">{sortedCategories.length} unique categories worldwide</span>
      </div>
      <h1 class="font-display text-5xl font-bold text-warm-950 mb-4 leading-tight">
        Every Stay is<br /><span class="text-gold-500">Extraordinary</span>
      </h1>
      <p class="font-body text-warm-600 text-lg max-w-2xl mx-auto leading-relaxed">
        We've scoured the globe to find the most remarkable accommodation types.
        Each category is a gateway to experiences that will stay with you forever.
      </p>
    </div>
  </section>

  <!-- Featured categories (if any) -->
  {featuredCategories.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-gold-500">✦</span>
        <h2 class="font-display text-2xl font-bold text-warm-950">Editor's Picks</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {featuredCategories.map(category => (
          <CategoryCard
            title={category.data.title}
            description={category.data.description}
            icon={category.data.icon}
            coverImage={category.data.coverImage}
            slug={category.slug}
            stats={category.data.stats}
            featured={category.data.featured}
          />
        ))}
      </div>
    </section>
  )}

  <!-- All categories -->
  <section class="bg-warm-100 border-y border-warm-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      {featuredCategories.length > 0 && (
        <h2 class="font-display text-2xl font-bold text-warm-950 mb-8">All Categories</h2>
      )}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {(featuredCategories.length > 0 ? otherCategories : sortedCategories).map(category => (
          <CategoryCard
            title={category.data.title}
            description={category.data.description}
            icon={category.data.icon}
            coverImage={category.data.coverImage}
            slug={category.slug}
            stats={category.data.stats}
            featured={category.data.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <h2 class="font-display text-3xl font-bold text-warm-950 mb-4">
      Can't decide? Let us inspire you.
    </h2>
    <p class="font-body text-warm-600 mb-8">
      Browse our hand-picked featured stays across all categories — selected for wow factor, value, and uniqueness.
    </p>
    <a
      href="/#featured"
      class="inline-flex items-center gap-2 bg-forest-600 hover:bg-forest-700 text-white font-body font-semibold px-8 py-4 rounded-full transition-all hover:shadow-lg"
    >
      View Featured Stays
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </section>

</BaseLayout>
