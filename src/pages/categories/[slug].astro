---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HotelCard from '../../components/HotelCard.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map(category => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const { Content } = await category.render();

// Get hotels in this category
const allHotels = await getCollection('hotels');
const categoryHotels = allHotels.filter(h => h.data.category === category.slug);

// Get related categories (all except current)
const allCategories = await getCollection('categories');
const relatedCategories = allCategories
  .filter(c => c.slug !== category.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title={category.data.metaTitle || `${category.data.title} | StayAtNiche`}
  description={category.data.metaDescription || category.data.description}
>
  <!-- Hero -->
  <section class="relative bg-stone-950 pt-20 pb-16 overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, #d4a574 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-stone-500 text-sm font-body mb-8">
        <a href="/" class="hover:text-gold-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/categories" class="hover:text-gold-400 transition-colors">Categories</a>
        <span>/</span>
        <span class="text-stone-300">{category.data.title}</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="flex-1">
          <div class="text-6xl mb-6">{category.data.icon}</div>
          <h1 class="font-display text-5xl font-bold text-white mb-4">
            {category.data.title}
          </h1>
          <p class="font-body text-stone-400 text-lg leading-relaxed max-w-2xl">
            {category.data.description}
          </p>
        </div>

        <!-- Stats card -->
        <div class="bg-stone-900 rounded-2xl border border-stone-800 p-8 flex-shrink-0 w-full lg:w-72">
          <h3 class="font-display text-white font-semibold mb-6">Category Stats</h3>
          <div class="space-y-4">
            <div class="flex justify-between items-center">
              <span class="font-body text-stone-400 text-sm">Total Stays</span>
              <span class="font-display text-gold-400 font-bold">{category.data.stats.hotelCount}</span>
            </div>
            <div class="border-t border-stone-800"></div>
            <div class="flex justify-between items-center">
              <span class="font-body text-stone-400 text-sm">Avg. Price/Night</span>
              <span class="font-display text-gold-400 font-bold">${category.data.stats.avgPrice}</span>
            </div>
            <div class="border-t border-stone-800"></div>
            <div class="flex justify-between items-center">
              <span class="font-body text-stone-400 text-sm">Top Destination</span>
              <span class="font-display text-gold-400 font-bold text-right text-sm">{category.data.stats.topDestination}</span>
            </div>
          </div>
          <a
            href="/categories"
            class="block w-full text-center mt-6 border border-stone-700 hover:border-gold-500 text-stone-300 hover:text-gold-400 font-body text-sm px-4 py-2 rounded-full transition-colors"
          >
            All Categories
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="prose prose-invert prose-gold max-w-none
      prose-headings:font-display prose-headings:text-white
      prose-p:font-body prose-p:text-stone-400 prose-p:leading-relaxed
      prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-10 prose-h2:mb-4
      prose-strong:text-white">
      <Content />
    </div>
  </section>

  <!-- Hotels in this category -->
  {categoryHotels.length > 0 && (
    <section class="bg-stone-900/50 border-y border-stone-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <h2 class="font-display text-3xl font-bold text-white mb-8">
          {category.data.title} <span class="text-gold-400">Stays</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {categoryHotels.map(hotel => (
            <HotelCard
              name={hotel.data.name}
              destination={hotel.data.destination}
              country={hotel.data.country}
              description={hotel.data.description}
              priceRange={hotel.data.priceRange}
              priceIndicator={hotel.data.priceIndicator}
              rating={hotel.data.rating}
              reviewCount={hotel.data.reviewCount}
              highlights={hotel.data.highlights}
              bookingUrl={hotel.data.bookingUrl}
              slug={hotel.slug}
              category={hotel.data.category}
              featured={hotel.data.featured}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related categories -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="font-display text-2xl font-bold text-white mb-8">
      Explore Other <span class="text-gold-400">Categories</span>
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {relatedCategories.map(cat => (
        <CategoryCard
          title={cat.data.title}
          description={cat.data.description}
          icon={cat.data.icon}
          slug={cat.slug}
          stats={cat.data.stats}
          featured={cat.data.featured}
        />
      ))}
    </div>
  </section>
</BaseLayout>
