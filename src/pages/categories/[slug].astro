---
import CategoryView from '../../views/CategoryView.astro';
import { localized } from '../../i18n/content';

export async function getStaticPaths() {
  return (await localized('categories', 'en')).map(category => ({ params: { slug: category.slug }, props: { category } }));
}
---
<CategoryView locale="en" category={Astro.props.category} />
