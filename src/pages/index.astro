---
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from '../components/HotelCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import Faq from '../components/Faq.astro';
import { getCollection } from 'astro:content';
import { resolveImage } from '../lib/images';
import { AFFILIATE_REL, withTracking } from '../lib/affiliate';
import { isLive, startPrice, slugify } from '../lib/site';

const hotels = (await getCollection('hotels', isLive));
const cats = (await getCollection('categories')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const dests = await getCollection('destinations');
const posts = (await getCollection('blog', p => p.data.status !== 'draft'))
  .sort((a, b) => +new Date(b.data.publishedDate) - +new Date(a.data.publishedDate)).slice(0, 3);

const byScore = [...hotels].sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.rating - a.data.rating);
const trending = byScore.slice(0, 10);
const countries = [...new Set(hotels.map(h => h.data.country))].sort();
const stats = { hotels: hotels.length, types: cats.length, countries: countries.length };

const budgets = [
  { label: 'Under $300', sub: 'Smart splurges', q: 'lt300', count: hotels.filter(h => startPrice(h.data.priceRange) < 300).length, art: 'jungle-lodges' },
  { label: '$300 to $800', sub: 'The sweet spot', q: '300-800', count: hotels.filter(h => { const p = startPrice(h.data.priceRange); return p >= 300 && p <= 800; }).length, art: 'cave-hotels' },
  { label: '$800 and up', sub: 'Once-in-a-lifetime', q: 'gt800', count: hotels.filter(h => startPrice(h.data.priceRange) > 800).length, art: 'overwater-bungalows' },
];
const continents = ['europe', 'asia', 'africa', 'north-america', 'south-america', 'oceania', 'middle-east'].map(c => ({
  slug: c,
  label: c.replace(/-/g, ' ').replace(/\b\w/g, m => m.toUpperCase()),
  count: dests.filter(d => slugify(d.data.continent) === c).length,
})).filter(c => c.count > 0);

const faq = [
  { q: 'What are the most unusual types of hotels in the world?', a: `StayAtNiche covers ${stats.types} types of unusual stays: treehouse hotels, cave hotels, underwater rooms, overwater bungalows, ice hotels, safari lodges, bubble hotels, castle hotels, floating hotels, cliffside hotels, desert camps, jungle lodges, lighthouse hotels and train hotels.` },
  { q: 'Are unusual hotels more expensive than regular hotels?', a: 'Not always. Prices range from around $100 a night for simple cave rooms and glamping domes to $1,000+ for underwater suites and private-island bungalows. Each listing shows a typical nightly range; always check live rates for your dates.' },
  { q: 'When should I book a treehouse, ice or underwater hotel?', a: 'Book 6 to 12 months ahead for peak seasons. Ice hotels are seasonal (roughly December to April), aurora stays fill up early in winter, and small properties with only a handful of rooms often sell out first.' },
  { q: 'How does StayAtNiche make money?', a: 'We earn a commission when you book through some of our links, at no extra cost to you. Links are marked as sponsored and our scores are editorial. See our affiliate disclosure for the full list of partners.' },
];
const fmt = (d: Date | string) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<BaseLayout
  title="StayAtNiche: The World's Most Extraordinary Stays"
  description="Find unusual hotels worth the trip: treehouses, cave hotels, underwater rooms, safari lodges, ice hotels and more. Compare prices and book with confidence."
>

  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-forest-950 text-white">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(1200px_500px_at_85%_-10%,rgba(248,147,30,.35),transparent),radial-gradient(900px_500px_at_0%_110%,rgba(46,155,94,.35),transparent)]"></div>
    <div class="absolute inset-0 -z-10 opacity-[.07] [background-image:radial-gradient(#fff_1px,transparent_1px)] [background-size:26px_26px]"></div>

    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 pb-12 pt-10 sm:px-6 lg:grid-cols-[1.15fr_.85fr] lg:gap-14 lg:px-8 lg:pb-20 lg:pt-16">
      <div>
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3.5 py-1.5 font-body text-xs font-semibold tracking-wide text-white/90">
          <span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>
          {stats.hotels} stays · {stats.countries} countries · {stats.types} kinds of unusual
        </p>
        <h1 class="font-display text-[2.6rem] font-bold leading-[1.02] tracking-tight sm:text-6xl lg:text-[4.25rem]">
          Sleep somewhere <span class="italic text-gold-400">unforgettable.</span>
        </h1>
        <p class="mt-5 max-w-xl font-body text-lg leading-relaxed text-white/75">
          Treehouses above the Arctic Circle, rooms under the sea, castles, caves and camps. We find the stays worth crossing an ocean for, then show you where to book them.
        </p>

        <!-- Search panel -->
        <form action="/hotels/" method="get" class="mt-8 rounded-3xl bg-white p-2 text-warm-900 shadow-2xl shadow-black/30 sm:p-2.5">
          <div class="grid gap-1 sm:grid-cols-[1.1fr_1fr_.8fr_auto] sm:items-center">
            <label class="block rounded-2xl px-4 py-2.5 transition hover:bg-warm-50 focus-within:bg-warm-50">
              <span class="block font-body text-[11px] font-bold uppercase tracking-wider text-warm-500">Type of stay</span>
              <select name="type" class="mt-0.5 w-full bg-transparent font-body text-[15px] font-semibold text-warm-950 focus:outline-none">
                <option value="">Anything unusual</option>
                {cats.map(c => <option value={c.slug}>{c.data.title}</option>)}
              </select>
            </label>
            <label class="block rounded-2xl px-4 py-2.5 transition hover:bg-warm-50 focus-within:bg-warm-50 sm:border-l sm:border-warm-200">
              <span class="block font-body text-[11px] font-bold uppercase tracking-wider text-warm-500">Where</span>
              <input name="q" list="places" autocomplete="off" placeholder="Country or place" class="mt-0.5 w-full bg-transparent font-body text-[15px] font-semibold text-warm-950 placeholder:font-medium placeholder:text-warm-400 focus:outline-none" />
              <datalist id="places">{countries.map(c => <option value={c} />)}</datalist>
            </label>
            <label class="block rounded-2xl px-4 py-2.5 transition hover:bg-warm-50 focus-within:bg-warm-50 sm:border-l sm:border-warm-200">
              <span class="block font-body text-[11px] font-bold uppercase tracking-wider text-warm-500">Budget / night</span>
              <select name="price" class="mt-0.5 w-full bg-transparent font-body text-[15px] font-semibold text-warm-950 focus:outline-none">
                <option value="">Any</option>
                <option value="lt300">Under $300</option>
                <option value="300-800">$300 to $800</option>
                <option value="gt800">$800 and up</option>
              </select>
            </label>
            <button type="submit" class="flex items-center justify-center gap-2 rounded-2xl bg-forest-600 px-6 py-4 font-body text-sm font-bold text-white transition hover:bg-forest-700 active:scale-[.98] sm:h-full">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/></svg>
              Find stays
            </button>
          </div>
        </form>

        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 font-body text-sm text-white/70">
          <span class="font-semibold text-white/90">Popular:</span>
          {[['Overwater bungalows', '/categories/overwater-bungalows/'], ['Safari lodges', '/categories/safari-lodges/'], ['Ice hotels', '/categories/ice-hotels/'], ['Cave hotels', '/categories/cave-hotels/']].map(([l, h]) => (
            <a href={h} class="underline decoration-white/30 underline-offset-4 transition hover:text-white hover:decoration-white">{l}</a>
          ))}
        </div>
      </div>

      <!-- Poster stack -->
      <div class="relative hidden lg:block" aria-hidden="true">
        <div class="relative mx-auto aspect-[4/5] w-full max-w-md">
          <a tabindex="-1" href="/categories/treehouse-hotels/" class="absolute left-0 top-6 w-[62%] rotate-[-4deg] overflow-hidden rounded-3xl shadow-2xl ring-4 ring-white/90 transition duration-500 hover:rotate-0">
            <img src={resolveImage(undefined, { category: 'treehouse-hotels' })} alt="" class="aspect-[3/4] w-full object-cover" width="600" height="800" fetchpriority="high" />
          </a>
          <a tabindex="-1" href="/categories/underwater-rooms/" class="absolute right-0 top-0 w-[52%] rotate-[5deg] overflow-hidden rounded-3xl shadow-2xl ring-4 ring-white/90 transition duration-500 hover:rotate-0">
            <img src={resolveImage(undefined, { category: 'underwater-rooms' })} alt="" class="aspect-square w-full object-cover" width="600" height="600" loading="lazy" />
          </a>
          <a tabindex="-1" href="/categories/desert-camps/" class="absolute bottom-0 right-6 w-[58%] rotate-[-2deg] overflow-hidden rounded-3xl shadow-2xl ring-4 ring-white/90 transition duration-500 hover:rotate-0">
            <img src={resolveImage(undefined, { category: 'desert-camps' })} alt="" class="aspect-[4/3] w-full object-cover" width="600" height="450" loading="lazy" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORY RAIL -->
  <section class="border-b border-warm-200 bg-white" aria-label="Browse by type of stay">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ul class="scrollbar-hide -mx-4 flex gap-1 overflow-x-auto px-4 py-3 sm:mx-0 sm:px-0 lg:justify-between">
        {cats.map(c => (
          <li class="flex-shrink-0">
            <a href={`/categories/${c.slug}/`} class="group flex w-[84px] flex-col items-center gap-2 rounded-2xl px-2 py-2.5 text-center transition hover:bg-warm-50">
              <span class="grid h-12 w-12 place-items-center rounded-2xl bg-warm-100 text-forest-700 transition group-hover:bg-forest-600 group-hover:text-white"><CategoryIcon slug={c.slug} size={24} /></span>
              <span class="font-body text-[12px] font-semibold leading-tight text-warm-700 group-hover:text-warm-950">{c.data.title.replace(/ (Hotels|Rooms|Camps|Lodges|Bungalows)$/, '')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TRENDING -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20" id="featured">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="font-body text-xs font-bold uppercase tracking-widest text-gold-600">Editors' shortlist</p>
        <h2 class="mt-1 font-display text-3xl font-bold text-warm-950 sm:text-4xl">Stays people screenshot</h2>
      </div>
      <a href="/hotels/" class="hidden whitespace-nowrap font-body text-sm font-semibold text-forest-700 hover:underline sm:block">See all {stats.hotels} stays →</a>
    </div>
    <div class="snap-row scrollbar-hide -mx-4 flex gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 lg:grid-cols-4 lg:gap-6">
      {trending.slice(0, 8).map(h => (
        <div class="w-[78%] flex-shrink-0 sm:w-auto">
          <HotelCard name={h.data.name} destination={h.data.destination} country={h.data.country} description={h.data.description} priceRange={h.data.priceRange} priceIndicator={h.data.priceIndicator} rating={h.data.rating} reviewCount={h.data.reviewCount} highlights={h.data.highlights} bookingUrl={h.data.bookingUrl} slug={h.slug} category={h.data.category} featured={h.data.featured} coverImage={h.data.coverImage} />
        </div>
      ))}
    </div>
    <a href="/hotels/" class="mt-6 block rounded-full border border-warm-300 py-3 text-center font-body text-sm font-semibold text-warm-800 sm:hidden">See all {stats.hotels} stays</a>
  </section>

  <!-- BY BUDGET -->
  <section class="bg-warm-100/70 py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-bold text-warm-950 sm:text-4xl">Pick your budget</h2>
      <p class="mt-2 font-body text-warm-600">Typical nightly rates. Always check live prices for your dates.</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {budgets.map(b => (
          <a href={`/hotels/?price=${b.q}`} class="reveal group relative isolate flex min-h-[190px] flex-col justify-end overflow-hidden rounded-3xl p-6 text-white shadow-card transition hover:shadow-card-hover">
            <img src={resolveImage(undefined, { category: b.art })} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
            <p class="font-body text-xs font-semibold uppercase tracking-wider text-white/80">{b.sub}</p>
            <p class="font-display text-2xl font-bold">{b.label}</p>
            <p class="mt-1 font-body text-sm text-white/80">{b.count} stays →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BROWSE BY TYPE -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="font-display text-3xl font-bold text-warm-950 sm:text-4xl">Browse by kind of stay</h2>
      <a href="/categories/" class="hidden font-body text-sm font-semibold text-forest-700 hover:underline sm:block">All {stats.types} types →</a>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
      {cats.slice(0, 8).map((c, i) => (
        <a href={`/categories/${c.slug}/`} class:list={['reveal group relative isolate overflow-hidden rounded-3xl shadow-card transition hover:shadow-card-hover', i === 0 ? 'col-span-2 row-span-2 aspect-square sm:aspect-auto' : 'aspect-[4/5]']}>
          <img src={resolveImage(c.data.coverImage, { category: c.slug })} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
          <div class="flex h-full flex-col justify-end p-4 text-white sm:p-5">
            <span class="mb-2 grid h-9 w-9 place-items-center rounded-full bg-white/90 text-forest-700"><CategoryIcon slug={c.slug} size={18} /></span>
            <h3 class:list={['font-display font-bold leading-tight', i === 0 ? 'text-2xl sm:text-3xl' : 'text-lg']}>{c.data.title}</h3>
            <p class="font-body text-xs text-white/80">{c.data.stats.hotelCount} stays{i === 0 ? ` · ${c.data.tagline ?? ''}` : ''}</p>
          </div>
        </a>
      ))}
    </div>
    <a href="/categories/" class="mt-6 block rounded-full border border-warm-300 py-3 text-center font-body text-sm font-semibold text-warm-800 sm:hidden">All {stats.types} types</a>
  </section>

  <!-- CONTINENTS -->
  <section class="bg-warm-950 py-14 text-white lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Where in the world?</h2>
      <div class="scrollbar-hide -mx-4 mt-8 flex gap-3 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-4 sm:overflow-visible sm:px-0 lg:grid-cols-7">
        {continents.map(c => (
          <a href={`/destinations/#${c.slug}`} class="group relative isolate aspect-[3/4] w-40 flex-shrink-0 overflow-hidden rounded-2xl sm:w-auto">
            <img src={resolveImage(undefined, { continent: c.slug })} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover transition duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 to-transparent"></div>
            <div class="flex h-full flex-col justify-end p-3">
              <p class="font-display text-base font-bold leading-tight">{c.label}</p>
              <p class="font-body text-xs text-white/70">{c.count} guides</p>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-6 font-body text-sm text-white/60">Or browse <a href="/countries/" class="underline hover:text-white">unusual hotels by country</a>.</p>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="font-body text-xs font-bold uppercase tracking-widest text-gold-600">Why StayAtNiche</p>
        <h2 class="mt-2 font-display text-3xl font-bold leading-tight text-warm-950 sm:text-4xl">Not another list of the same 5-star chains.</h2>
        <p class="mt-4 font-body leading-relaxed text-warm-600">There are over a billion hotel rooms in the world. We only feature the ones with a story: extraordinary setting, architecture or experience.</p>
        <a href="/about/" class="mt-6 inline-flex rounded-full bg-warm-950 px-6 py-3 font-body text-sm font-semibold text-white transition hover:bg-warm-800">How we choose</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {[
          ['Unusual by design', 'A stay makes the list because the place itself is the reason to go: setting, structure or experience.', 'M12 3l2.9 6.6 7.1.7-5.4 4.8 1.7 6.9L12 17.4 5.7 21l1.7-6.9L2 9.3l7.1-.7L12 3z'],
          ['Compare before you book', 'Every stay links to several booking sites so you can pick the best rate for your dates.', 'M4 7h16M4 12h16M4 17h10'],
          ['Transparent about money', 'We earn a commission on some bookings at no cost to you. It is disclosed on every page.', 'M12 8v8m-3-3h6M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0Z'],
        ].map(([t, d, p]) => (
          <div class="reveal rounded-3xl border border-warm-200 bg-white p-6 shadow-soft">
            <span class="mb-4 grid h-11 w-11 place-items-center rounded-2xl bg-forest-50 text-forest-700"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p} /></svg></span>
            <h3 class="font-display text-lg font-bold text-warm-950">{t}</h3>
            <p class="mt-2 font-body text-sm leading-relaxed text-warm-600">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GUIDES -->
  {posts.length > 0 && (
    <section class="border-t border-warm-200 bg-white py-14 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 flex items-end justify-between">
          <h2 class="font-display text-3xl font-bold text-warm-950 sm:text-4xl">Fresh travel guides</h2>
          <a href="/blog/" class="hidden font-body text-sm font-semibold text-forest-700 hover:underline sm:block">All guides →</a>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {posts.map(p => (
            <a href={`/blog/${p.slug}/`} class="reveal group block">
              <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-warm-100 ring-1 ring-black/5">
                <img src={resolveImage(p.data.coverImage?.startsWith('/') ? p.data.coverImage : undefined, { category: p.data.tags.find((t: string) => t.includes('-')) ?? p.data.category })} alt="" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
              </div>
              <p class="mt-3 font-body text-xs font-semibold uppercase tracking-wider text-gold-600">{p.data.category.replace(/-/g, ' ')} · {fmt(p.data.publishedDate)}</p>
              <h3 class="mt-1 font-display text-xl font-bold leading-snug text-warm-950 group-hover:text-forest-700">{p.data.title}</h3>
              <p class="mt-1 line-clamp-2 font-body text-sm text-warm-600">{p.data.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- TRIP ESSENTIALS -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <h2 class="text-center font-display text-3xl font-bold text-warm-950">Plan the rest of the trip</h2>
    <div class="mt-8 grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-5">
      {[
        ['Hotels', 'Compare rates on Expedia', 'https://www.expedia.com/Hotels', 'expedia', '#00356B'],
        ['Tours & activities', 'Local experiences on Klook', 'https://www.klook.com', 'klook', '#FF5722'],
        ['Attraction tickets', 'Skip the line with Tiqets', 'https://www.tiqets.com', 'tiqets', '#6C3AE8'],
        ['Flights', 'Search routes on Kiwi.com', 'https://www.kiwi.com', 'kiwi', '#3D3025'],
      ].map(([t, s, u, k, c]) => (
        <a href={withTracking(u, { campaign: 'homepage-partners', content: k })} target="_blank" rel={AFFILIATE_REL} class="group rounded-3xl border border-warm-200 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-card-hover">
          <span class="mb-3 block h-1.5 w-10 rounded-full" style={`background:${c}`}></span>
          <h3 class="font-display text-lg font-bold text-warm-950">{t}</h3>
          <p class="mt-1 font-body text-sm text-warm-500">{s} <span class="inline-block transition group-hover:translate-x-1">→</span></p>
        </a>
      ))}
    </div>
    <p class="mt-4 text-center font-body text-xs text-warm-400">Affiliate links: we earn a small commission when you book, at no extra cost to you. <a href="/disclosure" class="underline">Learn more</a></p>
  </section>

  <!-- NEWSLETTER -->
  <section class="mx-auto max-w-7xl px-4 pb-14 sm:px-6 lg:px-8 lg:pb-20">
    <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-forest-700 via-forest-800 to-forest-950 px-6 py-12 sm:px-12 lg:py-16">
      <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full bg-gold-400/20 blur-3xl"></div>
      <div class="relative grid items-center gap-8 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl">One unusual hotel, every Friday.</h2>
          <p class="mt-3 font-body text-white/70">A short email with one stay worth knowing about. Unsubscribe in one click.</p>
        </div>
        <form class="flex flex-col gap-3 sm:flex-row" netlify name="newsletter" method="POST" action="/newsletter-success/" data-netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="hidden"><label>Leave empty: <input name="bot-field" /></label></p>
          <label class="sr-only" for="nl-email">Email address</label>
          <input id="nl-email" type="email" name="email" autocomplete="email" required placeholder="you@example.com" class="min-w-0 flex-1 rounded-full border border-white/20 bg-white/10 px-5 py-4 font-body text-sm text-white placeholder-white/50 outline-none focus:border-white/60" />
          <button type="submit" class="rounded-full bg-gold-500 px-7 py-4 font-body text-sm font-bold text-warm-950 transition hover:bg-gold-400">Subscribe</button>
        </form>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-20 sm:px-6 lg:px-8">
    <Faq heading="Unusual hotels: quick answers" items={faq} />
  </section>

</BaseLayout>
