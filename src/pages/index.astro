---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import HotelCard from '../components/HotelCard.astro';
import { getCollection } from 'astro:content';

const allCategories = await getCollection('categories');
const allHotels     = await getCollection('hotels');

const sortedCategories = allCategories.sort((a, b) => a.data.order - b.data.order);
const featuredHotels   = allHotels.filter(h => h.data.featured);
const recentHotels     = allHotels.slice(0, 4);

const stats = {
  categories: allCategories.length,
  hotels: allHotels.length,
  countries: [...new Set(allHotels.map(h => h.data.country))].length,
};

const categoryPills = [
  { href: '/categories/treehouse-hotels', label: '🌳 Treehouses' },
  { href: '/categories/cave-hotels', label: '🪨 Cave Hotels' },
  { href: '/categories/underwater-rooms', label: '🌊 Underwater' },
  { href: '/categories/castle-hotels', label: '🏰 Castles' },
  { href: '/categories/floating-hotels', label: '🛶 Floating' },
  { href: '/categories/bubble-hotels', label: '🫧 Bubbles' },
];

const whyItems = [
  {
    icon: '✦',
    color: 'bg-gold-100 text-gold-600',
    title: 'Genuinely Unique',
    desc: 'Every property offers something you simply cannot experience anywhere else. No generic hotels — ever.',
  },
  {
    icon: '◈',
    color: 'bg-forest-100 text-forest-600',
    title: 'Expert Curation',
    desc: 'Our team researches hundreds of properties to bring you only the extraordinary — vetted for quality and character.',
  },
  {
    icon: '◇',
    color: 'bg-warm-200 text-warm-700',
    title: 'Best Rates Guaranteed',
    desc: 'We partner with Booking.com and other top platforms to surface the best price for each extraordinary property.',
  },
];
---

<BaseLayout
  title="StayAtNiche — The World's Most Extraordinary Stays"
  description="Discover unique hotel stays — treehouses, cave hotels, underwater rooms, castles, and more. Curated niche accommodations for extraordinary travel."
>

  <!-- ═══════════════════════════════════
       HERO
  ═══════════════════════════════════ -->
  <section class="relative bg-warm-50 overflow-hidden pt-10 pb-20">
    <!-- Decorative dot pattern -->
    <div class="dot-pattern absolute inset-0 opacity-100 pointer-events-none" />

    <!-- Decorative circles -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-gold-100/60 rounded-full blur-3xl pointer-events-none" />
    <div class="absolute -bottom-16 -left-16 w-72 h-72 bg-forest-100/50 rounded-full blur-3xl pointer-events-none" />

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2 bg-white border border-warm-200 rounded-full px-4 py-2 mb-8 shadow-soft">
        <span class="w-1.5 h-1.5 rounded-full bg-forest-500 animate-pulse" />
        <span class="font-body text-warm-600 text-sm font-medium">
          {stats.hotels} extraordinary stays across {stats.countries} countries
        </span>
      </div>

      <!-- Headline -->
      <h1 class="font-display text-5xl sm:text-6xl md:text-7xl font-bold text-warm-950 leading-[1.1] mb-6">
        Find Stays That<br />
        <em class="not-italic text-gold-500">Stories</em> Are Made Of
      </h1>

      <p class="font-body text-warm-600 text-lg sm:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
        From treetop suites in Swedish Lapland to underwater bedrooms in the Maldives —
        we curate the world's most unforgettable accommodations.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-12">
        <a
          href="/categories"
          class="inline-flex items-center justify-center gap-2 bg-forest-600 hover:bg-forest-700 text-white font-body font-semibold px-8 py-4 rounded-full text-base transition-all hover:shadow-lg active:scale-95"
        >
          Explore All Categories
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="#featured"
          class="inline-flex items-center justify-center gap-2 bg-white hover:bg-warm-100 text-warm-800 font-body font-semibold px-8 py-4 rounded-full text-base border border-warm-200 transition-all hover:shadow-md"
        >
          View Featured Stays
        </a>
      </div>

      <!-- Category pills -->
      <div class="flex flex-wrap justify-center gap-2">
        {categoryPills.map(p => (
          <a
            href={p.href}
            class="inline-flex items-center gap-1.5 bg-white hover:bg-warm-100 text-warm-700 hover:text-warm-950 font-body text-sm font-medium px-4 py-2 rounded-full border border-warm-200 transition-all hover:shadow-sm hover:-translate-y-0.5"
          >
            {p.label}
          </a>
        ))}
        <a
          href="/categories"
          class="inline-flex items-center gap-1 bg-warm-100 hover:bg-warm-200 text-warm-600 hover:text-warm-900 font-body text-sm font-medium px-4 py-2 rounded-full border border-warm-200 transition-all"
        >
          All types →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       STATS BAR
  ═══════════════════════════════════ -->
  <section class="bg-white border-y border-warm-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-3 gap-4 divide-x divide-warm-200">
        <div class="text-center px-4">
          <div class="font-display text-3xl font-bold text-warm-950">{stats.categories}</div>
          <div class="font-body text-warm-500 text-sm mt-0.5">Niche Categories</div>
        </div>
        <div class="text-center px-4">
          <div class="font-display text-3xl font-bold text-warm-950">{stats.hotels}+</div>
          <div class="font-body text-warm-500 text-sm mt-0.5">Curated Stays</div>
        </div>
        <div class="text-center px-4">
          <div class="font-display text-3xl font-bold text-warm-950">{stats.countries}</div>
          <div class="font-body text-warm-500 text-sm mt-0.5">Countries</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       BROWSE BY CATEGORY
  ═══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="font-body text-forest-600 text-sm font-semibold uppercase tracking-widest mb-2">Browse by Type</p>
        <h2 class="font-display text-4xl font-bold text-warm-950 leading-tight">
          Choose Your<br /><span class="text-gold-500">Adventure</span>
        </h2>
      </div>
      <a
        href="/categories"
        class="hidden sm:inline-flex items-center gap-1.5 font-body text-sm font-semibold text-warm-600 hover:text-warm-950 transition-colors underline underline-offset-4"
      >
        View all {stats.categories} categories →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {sortedCategories.map(category => (
        <CategoryCard
          title={category.data.title}
          description={category.data.description}
          icon={category.data.icon}
          slug={category.slug}
          stats={category.data.stats}
          featured={category.data.featured}
        />
      ))}
    </div>

    <div class="text-center mt-8 sm:hidden">
      <a
        href="/categories"
        class="inline-flex items-center gap-2 border border-warm-300 hover:border-forest-400 text-warm-700 hover:text-forest-700 font-body font-medium px-6 py-3 rounded-full transition-all"
      >
        View all categories →
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       FEATURED STAYS
  ═══════════════════════════════════ -->
  <section id="featured" class="bg-warm-100 border-y border-warm-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="flex items-end justify-between mb-10">
        <div>
          <div class="inline-flex items-center gap-2 mb-2">
            <span class="text-gold-500 text-sm">✦</span>
            <span class="font-body text-sm font-semibold text-warm-600 uppercase tracking-widest">Editor's Selection</span>
          </div>
          <h2 class="font-display text-4xl font-bold text-warm-950">
            Featured <span class="text-gold-500">Stays</span>
          </h2>
        </div>
        <a
          href="/categories"
          class="hidden sm:inline-flex items-center gap-1.5 font-body text-sm font-semibold text-warm-600 hover:text-warm-950 transition-colors underline underline-offset-4"
        >
          Browse all hotels →
        </a>
      </div>

      {featuredHotels.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {featuredHotels.map(hotel => (
            <HotelCard
              name={hotel.data.name}
              destination={hotel.data.destination}
              country={hotel.data.country}
              description={hotel.data.description}
              priceRange={hotel.data.priceRange}
              priceIndicator={hotel.data.priceIndicator}
              rating={hotel.data.rating}
              reviewCount={hotel.data.reviewCount}
              highlights={hotel.data.highlights}
              bookingUrl={hotel.data.bookingUrl}
              slug={hotel.slug}
              category={hotel.data.category}
              featured={hotel.data.featured}
            />
          ))}
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {recentHotels.map(hotel => (
            <HotelCard
              name={hotel.data.name}
              destination={hotel.data.destination}
              country={hotel.data.country}
              description={hotel.data.description}
              priceRange={hotel.data.priceRange}
              priceIndicator={hotel.data.priceIndicator}
              rating={hotel.data.rating}
              reviewCount={hotel.data.reviewCount}
              highlights={hotel.data.highlights}
              bookingUrl={hotel.data.bookingUrl}
              slug={hotel.slug}
              category={hotel.data.category}
              featured={hotel.data.featured}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ═══════════════════════════════════
       INSPIRATION STRIP
  ═══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- Large card -->
      <div class="md:col-span-2 relative bg-gradient-to-br from-forest-600 to-forest-800 rounded-3xl overflow-hidden p-10 flex flex-col justify-end min-h-[280px]">
        <div class="absolute inset-0 opacity-10">
          <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;" />
        </div>
        <div class="absolute top-8 right-8 text-8xl opacity-30 select-none">🌳</div>
        <p class="font-body text-forest-200 text-sm font-semibold uppercase tracking-widest mb-2">Most Popular</p>
        <h3 class="font-display text-3xl font-bold text-white mb-3">Treehouse Hotels</h3>
        <p class="font-body text-forest-100 text-sm leading-relaxed mb-6 max-w-md">
          Suspended between sky and earth — the world's finest treehouse hotels prove that elevation changes everything.
        </p>
        <a
          href="/categories/treehouse-hotels"
          class="inline-flex items-center gap-2 bg-white text-forest-700 font-body font-bold text-sm px-6 py-3 rounded-full transition-all hover:bg-forest-50 hover:shadow-lg w-fit"
        >
          Explore Treehouses →
        </a>
      </div>

      <!-- Two small cards -->
      <div class="flex flex-col gap-6">
        <div class="relative bg-gradient-to-br from-amber-100 to-warm-200 rounded-3xl overflow-hidden p-7 flex flex-col justify-end flex-1 min-h-[120px]">
          <div class="absolute top-4 right-5 text-5xl opacity-50 select-none">🪨</div>
          <p class="font-body text-warm-500 text-xs font-semibold uppercase tracking-widest mb-1">Mysterious</p>
          <h3 class="font-display text-xl font-bold text-warm-900 mb-3">Cave Hotels</h3>
          <a href="/categories/cave-hotels" class="font-body text-sm font-semibold text-warm-700 hover:text-warm-950 flex items-center gap-1 transition-colors">
            Discover →
          </a>
        </div>
        <div class="relative bg-gradient-to-br from-sky-100 to-blue-100 rounded-3xl overflow-hidden p-7 flex flex-col justify-end flex-1 min-h-[120px]">
          <div class="absolute top-4 right-5 text-5xl opacity-50 select-none">🌊</div>
          <p class="font-body text-sky-600 text-xs font-semibold uppercase tracking-widest mb-1">Breathtaking</p>
          <h3 class="font-display text-xl font-bold text-warm-900 mb-3">Underwater Rooms</h3>
          <a href="/categories/underwater-rooms" class="font-body text-sm font-semibold text-sky-700 hover:text-sky-900 flex items-center gap-1 transition-colors">
            Discover →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       WHY STAYATNICHE
  ═══════════════════════════════════ -->
  <section class="bg-warm-100 border-y border-warm-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center mb-12">
        <h2 class="font-display text-4xl font-bold text-warm-950 mb-3">
          Why <span class="text-gold-500">StayAtNiche</span>?
        </h2>
        <p class="font-body text-warm-600 text-lg max-w-xl mx-auto">
          We exist for one reason: to help you experience the places that make your jaw drop and your heart race.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {whyItems.map(item => (
          <div class="bg-white rounded-2xl p-8 shadow-card border border-warm-100">
            <div class:list={['w-12 h-12 rounded-2xl flex items-center justify-center text-xl mb-5', item.color]}>
              {item.icon}
            </div>
            <h3 class="font-display text-xl font-bold text-warm-950 mb-3">{item.title}</h3>
            <p class="font-body text-warm-600 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       NEWSLETTER
  ═══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="bg-gradient-to-br from-warm-950 to-warm-800 rounded-3xl px-8 sm:px-12 py-14 text-center relative overflow-hidden">
      <!-- Decorative -->
      <div class="absolute inset-0 opacity-5 dot-pattern" />
      <div class="absolute top-0 right-0 w-64 h-64 bg-gold-500/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2" />
      <div class="absolute bottom-0 left-0 w-48 h-48 bg-forest-500/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2" />

      <div class="relative">
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 mb-6">
          <span class="text-gold-400 text-sm">✦</span>
          <span class="font-body text-white/80 text-sm">No spam. Extraordinary stays only.</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-white mb-3">
          Never Miss an Extraordinary Stay
        </h2>
        <p class="font-body text-white/60 text-base mb-8 max-w-lg mx-auto">
          Get our weekly hand-picked selection of the world's most unique hotels, straight to your inbox.
        </p>
        <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" netlify name="newsletter" method="POST">
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            class="flex-1 bg-white/10 border border-white/20 focus:border-white/50 text-white placeholder-white/40 font-body px-5 py-3.5 rounded-full outline-none transition-colors text-sm"
          />
          <button
            type="submit"
            class="bg-gold-500 hover:bg-gold-400 text-warm-950 font-body font-bold px-7 py-3.5 rounded-full transition-all hover:shadow-lg active:scale-95 whitespace-nowrap text-sm"
          >
            Subscribe Free
          </button>
        </form>
        <p class="font-body text-white/30 text-xs mt-4">Unsubscribe anytime. We respect your inbox.</p>
      </div>
    </div>
  </section>

</BaseLayout>
