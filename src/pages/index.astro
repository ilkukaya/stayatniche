---
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from '../components/HotelCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import CategoryTile from '../components/CategoryTile.astro';
import StayVisual from '../components/StayVisual.astro';
import Faq from '../components/Faq.astro';
import { getCollection } from 'astro:content';
import { ownPhoto } from '../lib/images';
import { AFFILIATE_REL, withTracking } from '../lib/affiliate';
import { isLive, startPrice, slugify } from '../lib/site';

const hotels = await getCollection('hotels', isLive);
const catsAll = (await getCollection('categories')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const dests = await getCollection('destinations');
const posts = (await getCollection('blog', p => p.data.status !== 'draft'))
  .sort((a, b) => +new Date(b.data.publishedDate) - +new Date(a.data.publishedDate)).slice(0, 3);

const n = (slug: string) => hotels.filter(h => h.data.category === slug).length;
const cats = catsAll.map(c => ({ ...c, count: n(c.slug) })).filter(c => c.count > 0);
const rank = (a: any, b: any) => Number(b.data.featured) - Number(a.data.featured) || b.data.rating - a.data.rating;
const shortlist = [...hotels].sort(rank).slice(0, 8);
const countries = [...new Set(hotels.map(h => h.data.country))].sort();
const stats = { hotels: hotels.length, types: cats.length, countries: countries.length };

// Editorial features: categories that have a real photo, each with its top stays.
const features = cats.filter(c => ownPhoto(c.data.coverImage, c.slug)).slice(0, 2).map(c => ({
  cat: c, photo: ownPhoto(c.data.coverImage, c.slug)!, top: hotels.filter(h => h.data.category === c.slug).sort(rank).slice(0, 5),
}));
const heroPhoto = ownPhoto(catsAll.find(c => c.slug === 'treehouse-hotels')?.data.coverImage, 'treehouse-hotels');

const bands = [
  { label: 'Under $300', q: 'lt300', note: 'Cave rooms, bubble domes, lighthouse keepers’ cottages', test: (p: number) => p < 300 },
  { label: '$300 – $800', q: '300-800', note: 'Treehouses, desert camps, design-led lodges', test: (p: number) => p >= 300 && p <= 800 },
  { label: '$800 +', q: 'gt800', note: 'Underwater suites, private islands, safari camps', test: (p: number) => p > 800 },
].map(b => ({ ...b, count: hotels.filter(h => b.test(startPrice(h.data.priceRange))).length }));

const continents = ['europe', 'africa', 'asia', 'north-america', 'south-america', 'oceania', 'middle-east']
  .map(c => ({ slug: c, label: c.replace(/-/g, ' ').replace(/\b\w/g, m => m.toUpperCase()), count: dests.filter(d => slugify(d.data.continent) === c).length }))
  .filter(c => c.count > 0);

const faq = [
  { q: 'What are the most unusual types of hotels in the world?', a: `StayAtNiche covers ${stats.types} types of unusual stays: ${cats.map(c => c.data.title.toLowerCase()).join(', ')}.` },
  { q: 'Are unusual hotels more expensive than regular hotels?', a: 'Not always. Prices range from around $100 a night for simple cave rooms and glamping domes to $1,000+ for underwater suites and private-island villas. Each listing shows a typical nightly range; always check live rates for your dates.' },
  { q: 'When should I book a treehouse, ice or underwater hotel?', a: 'Book 6 to 12 months ahead for peak seasons. Ice hotels are seasonal (roughly December to April), aurora stays fill up early in winter, and small properties with only a handful of rooms often sell out first.' },
  { q: 'How does StayAtNiche make money?', a: 'We earn a commission when you book through some of our links, at no extra cost to you. Links are marked as sponsored and our scores are editorial. See our affiliate disclosure for the full list of partners.' },
];
const fmt = (d: Date | string) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<BaseLayout
  title="StayAtNiche: The World's Most Extraordinary Stays"
  description="Find unusual hotels worth the trip: treehouses, cave hotels, underwater rooms, safari lodges, ice hotels and more. Compare prices and book with confidence."
  heroImage={heroPhoto ?? undefined}
>

  <!-- HERO: full-bleed photograph, magazine-cover type -->
  <section class="relative isolate -mt-16 flex min-h-[640px] items-end overflow-hidden bg-warm-950 pt-28 sm:pt-16 text-white sm:min-h-[720px] lg:min-h-[88vh]">
    {heroPhoto && <img src={heroPhoto} alt="A treehouse cabin in a pine forest at golden hour" class="absolute inset-0 -z-10 h-full w-full object-cover" fetchpriority="high" width="1280" height="720" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/25 to-black/30"></div>
    <div class="mx-auto w-full max-w-7xl px-4 pb-10 sm:px-6 sm:pb-14 lg:px-8">
      <p class="eyebrow text-white/80">{stats.hotels} stays · {stats.countries} countries · {stats.types} kinds of unusual</p>
      <h1 class="mt-4 max-w-4xl font-display text-[3.4rem] leading-[.92] sm:text-8xl lg:text-[8.5rem]">Hotels worth <span class="italic">the trip.</span></h1>
      <p class="mt-5 max-w-lg font-body text-base leading-relaxed text-white/80 sm:text-lg">Treehouses above the Arctic Circle, rooms under the sea, castles, caves and camps. Chosen for the story, compared for the price.</p>

      <form action="/hotels/" method="get" class="mt-8 max-w-4xl rounded-2xl bg-white p-1.5 text-warm-900 shadow-2xl">
        <div class="grid gap-1 sm:grid-cols-[1.1fr_1fr_.8fr_auto] sm:items-stretch">
          <label class="block rounded-xl px-4 py-2.5 hover:bg-warm-100">
            <span class="block font-body text-[11px] font-semibold text-warm-500">Kind of stay</span>
            <select name="type" class="w-full bg-transparent font-body text-[15px] font-medium text-warm-950 focus:outline-none">
              <option value="">Anything unusual</option>
              {cats.map(c => <option value={c.slug}>{c.data.title}</option>)}
            </select>
          </label>
          <label class="block rounded-xl px-4 py-2.5 hover:bg-warm-100 sm:border-l sm:border-warm-200">
            <span class="block font-body text-[11px] font-semibold text-warm-500">Where</span>
            <input name="q" list="places" autocomplete="off" placeholder="Country or place" class="w-full bg-transparent font-body text-[15px] font-medium text-warm-950 placeholder:text-warm-400 focus:outline-none" />
            <datalist id="places">{countries.map(c => <option value={c} />)}</datalist>
          </label>
          <label class="block rounded-xl px-4 py-2.5 hover:bg-warm-100 sm:border-l sm:border-warm-200">
            <span class="block font-body text-[11px] font-semibold text-warm-500">Budget per night</span>
            <select name="price" class="w-full bg-transparent font-body text-[15px] font-medium text-warm-950 focus:outline-none">
              <option value="">Any budget</option>
              {bands.map(b => <option value={b.q}>{b.label}</option>)}
            </select>
          </label>
          <button type="submit" class="flex items-center justify-center gap-2 rounded-xl bg-forest-700 px-7 py-4 font-body text-[15px] font-semibold text-white transition hover:bg-forest-800">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/></svg>
            Search
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- CATEGORY RAIL -->
  <nav class="sticky top-16 z-30 border-b border-warm-200 bg-warm-50/95 backdrop-blur" aria-label="Kinds of stay">
    <ul class="scrollbar-hide mx-auto flex max-w-7xl gap-6 overflow-x-auto px-4 sm:px-6 lg:justify-between lg:px-8">
      {cats.map(c => (
        <li class="flex-shrink-0">
          <a href={`/hotels/?type=${c.slug}`} class="group flex flex-col items-center gap-1.5 border-b-2 border-transparent pb-3 pt-4 text-warm-500 transition hover:border-warm-300 hover:text-warm-950">
            <CategoryIcon slug={c.slug} size={24} strokeWidth={1.5} />
            <span class="whitespace-nowrap font-body text-xs font-medium">{c.data.title.replace(/ (Hotels|Rooms)$/, '')}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- SHORTLIST -->
  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 lg:px-8 lg:pt-20" id="featured">
    <div class="mb-8 flex items-end justify-between gap-6 border-b border-warm-200 pb-5">
      <div>
        <p class="eyebrow text-gold-600">The shortlist</p>
        <h2 class="mt-2 font-display text-4xl leading-none text-warm-950 sm:text-5xl">Stays people screenshot</h2>
      </div>
      <a href="/hotels/" class="hidden whitespace-nowrap font-body text-sm font-semibold text-warm-950 underline underline-offset-4 sm:block">All {stats.hotels} stays</a>
    </div>
    <div class="snap-row scrollbar-hide -mx-4 flex gap-5 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:gap-y-10 sm:overflow-visible sm:px-0 lg:grid-cols-4">
      {shortlist.map(h => (
        <div class="w-[80%] flex-shrink-0 sm:w-auto">
          <HotelCard name={h.data.name} destination={h.data.destination} country={h.data.country} description={h.data.description} priceRange={h.data.priceRange} priceIndicator={h.data.priceIndicator} rating={h.data.rating} highlights={h.data.highlights} bookingUrl={h.data.bookingUrl} slug={h.slug} category={h.data.category} featured={h.data.featured} coverImage={h.data.coverImage} />
        </div>
      ))}
    </div>
  </section>

  <!-- EDITORIAL FEATURES -->
  {features.map((f, i) => (
    <section class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 lg:px-8 lg:pt-28">
      <div class:list={['grid items-start gap-8 lg:grid-cols-2 lg:gap-16', i % 2 && 'lg:[&>*:first-child]:order-2']}>
        <a href={`/categories/${f.cat.slug}/`} class="group relative block overflow-hidden rounded-xl">
          <img src={f.photo} alt={`${f.cat.data.title}`} class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-[1.03] sm:aspect-[5/4] lg:aspect-[4/5]" loading="lazy" />
        </a>
        <div class="lg:sticky lg:top-40">
          <p class="eyebrow text-gold-600">Collection · {String(i + 1).padStart(2, '0')}</p>
          <h2 class="mt-3 font-display text-5xl leading-[.95] text-warm-950 sm:text-6xl">{f.cat.data.title}</h2>
          <p class="mt-4 max-w-md font-body leading-relaxed text-warm-600">{f.cat.data.description}</p>
          <ol class="mt-8 border-t border-warm-200">
            {f.top.map((h, k) => (
              <li class="border-b border-warm-200">
                <a href={`/hotels/${h.slug}/`} class="group flex items-baseline gap-5 py-4">
                  <span class="font-display text-2xl tabular-nums text-warm-400">{k + 1}</span>
                  <span class="flex-1">
                    <span class="block font-body text-[15px] font-semibold text-warm-950 group-hover:underline group-hover:underline-offset-4">{h.data.name}</span>
                    <span class="block font-body text-sm text-warm-500">{h.data.destination}, {h.data.country}</span>
                  </span>
                  <span class="font-body text-sm tabular-nums text-warm-700">from ${startPrice(h.data.priceRange).toLocaleString('en-US')}</span>
                </a>
              </li>
            ))}
          </ol>
          <a href={`/categories/${f.cat.slug}/`} class="mt-6 inline-flex rounded-full bg-warm-950 px-6 py-3 font-body text-sm font-semibold text-white transition hover:bg-warm-800">See all {f.cat.count} {f.cat.data.title.toLowerCase()}</a>
        </div>
      </div>
    </section>
  ))}

  <!-- KINDS OF STAY -->
  <section class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 lg:px-8 lg:pt-28">
    <div class="mb-8 flex items-end justify-between gap-6 border-b border-warm-200 pb-5">
      <h2 class="font-display text-4xl leading-none text-warm-950 sm:text-5xl">Every kind of unusual</h2>
      <a href="/categories/" class="hidden font-body text-sm font-semibold text-warm-950 underline underline-offset-4 sm:block">All {stats.types} kinds</a>
    </div>
    <div class="grid auto-rows-[190px] grid-cols-2 gap-3 sm:auto-rows-[220px] md:grid-cols-4 lg:gap-4">
      {cats.slice(0, 13).map((c, i) => (
        <CategoryTile slug={c.slug} title={c.data.title} count={c.count} coverImage={c.data.coverImage} tagline={c.data.tagline} big={i === 0} class={i === 0 ? 'col-span-2 row-span-2' : ''} />
      ))}
    </div>
  </section>

  <!-- BUDGET -->
  <section class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 lg:px-8 lg:pt-28">
    <h2 class="border-b border-warm-200 pb-5 font-display text-4xl leading-none text-warm-950 sm:text-5xl">By budget</h2>
    <div class="grid divide-y divide-warm-200 md:grid-cols-3 md:divide-x md:divide-y-0">
      {bands.map((b, i) => (
        <a href={`/hotels/?price=${b.q}`} class:list={['group block py-8', i > 0 && 'md:pl-8', i < 2 && 'md:pr-8']}>
          <p class="font-display text-5xl text-warm-950 transition group-hover:text-forest-700">{b.label}</p>
          <p class="mt-2 font-body text-sm text-warm-500">per night, typical</p>
          <p class="mt-4 font-body text-[15px] leading-relaxed text-warm-700">{b.note}</p>
          <p class="mt-5 font-body text-sm font-semibold text-warm-950">{b.count} stays <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span></p>
        </a>
      ))}
    </div>
  </section>

  <!-- WHERE: typographic index -->
  <section class="mt-20 bg-warm-950 py-16 text-white lg:mt-28 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="eyebrow text-gold-400">Destinations</p>
      <h2 class="mt-2 font-display text-4xl sm:text-5xl">Where in the world?</h2>
      <ul class="mt-10 border-t border-white/15">
        {continents.map(c => (
          <li class="border-b border-white/15">
            <a href={`/destinations/#${c.slug}`} class="group flex items-baseline justify-between gap-4 py-4 sm:py-5">
              <span class="font-display text-4xl leading-none text-white/90 transition group-hover:translate-x-2 group-hover:text-gold-300 sm:text-6xl">{c.label}</span>
              <span class="font-body text-sm tabular-nums text-white/50">{c.count} guides →</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 font-body text-sm text-white/60">Looking for a specific country? <a href="/countries/" class="text-white underline underline-offset-4">Unusual hotels by country</a>.</p>
    </div>
  </section>

  <!-- GUIDES -->
  {posts.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 lg:px-8 lg:pt-28">
      <div class="mb-8 flex items-end justify-between gap-6 border-b border-warm-200 pb-5">
        <h2 class="font-display text-4xl leading-none text-warm-950 sm:text-5xl">Latest guides</h2>
        <a href="/blog/" class="hidden font-body text-sm font-semibold text-warm-950 underline underline-offset-4 sm:block">All guides</a>
      </div>
      <div class="grid gap-10 md:grid-cols-3 md:gap-8">
        {posts.map(p => (
          <a href={`/blog/${p.slug}/`} class="group block">
            <p class="font-body text-xs font-medium uppercase tracking-wider text-warm-500">{p.data.category.replace(/-/g, ' ')} · {fmt(p.data.publishedDate)}</p>
            <h3 class="mt-3 font-display text-3xl leading-[1.05] text-warm-950 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">{p.data.title}</h3>
            <p class="mt-3 line-clamp-3 font-body text-[15px] leading-relaxed text-warm-600">{p.data.excerpt}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- TRIP ESSENTIALS -->
  <section class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 lg:px-8 lg:pt-28">
    <div class="rounded-2xl border border-warm-200 bg-white p-6 sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[1fr_2fr] lg:items-center">
        <div>
          <h2 class="font-display text-4xl leading-none text-warm-950">Plan the rest of the trip</h2>
          <p class="mt-3 font-body text-sm text-warm-500">Partners we use ourselves. Affiliate links, at no extra cost to you. <a href="/disclosure/" class="underline">How this works</a></p>
        </div>
        <div class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-warm-200 bg-warm-200 sm:grid-cols-4">
          {[
            ['Hotels', 'Expedia', 'https://www.expedia.com/Hotels', 'expedia'],
            ['Tours', 'Klook', 'https://www.klook.com', 'klook'],
            ['Tickets', 'Tiqets', 'https://www.tiqets.com', 'tiqets'],
            ['Flights', 'Kiwi.com', 'https://www.kiwi.com', 'kiwi'],
          ].map(([t, s, u, k]) => (
            <a href={withTracking(u, { campaign: 'homepage-partners', content: k })} target="_blank" rel={AFFILIATE_REL} class="group bg-white p-5 transition hover:bg-warm-50">
              <p class="font-display text-2xl text-warm-950">{t}</p>
              <p class="mt-1 font-body text-sm text-warm-500">{s} <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">↗</span></p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pt-20 sm:px-6 lg:px-8">
    <Faq heading="Quick answers" items={faq} />
  </section>

</BaseLayout>
