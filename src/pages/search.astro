---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search unusual hotels, destinations & guides" description="Search StayAtNiche: treehouse hotels, cave hotels, underwater rooms, safari lodges, destinations and travel guides." noIndex={true}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-3xl font-bold text-warm-950 sm:text-4xl">Search</h1>
    <form id="s-form" role="search" class="mt-6" onsubmit="return false">
      <label for="s-q" class="sr-only">Search hotels, destinations and guides</label>
      <input id="s-q" type="search" autocomplete="off" autofocus placeholder="Try “treehouse”, “Iceland” or “honeymoon”…" class="w-full rounded-full border border-warm-300 bg-white px-6 py-4 font-body text-base shadow-soft focus:border-forest-500 focus:outline-none focus:ring-2 focus:ring-forest-200" />
    </form>
    <p id="s-count" class="mt-4 font-body text-sm text-warm-500" aria-live="polite"></p>
    <ul id="s-results" class="mt-4 divide-y divide-warm-200 rounded-2xl border border-warm-200 bg-white"></ul>
  </section>
  <script is:inline>
    (function () {
      var q = document.getElementById('s-q'), out = document.getElementById('s-results'), count = document.getElementById('s-count'), rows = [];
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
      function run() {
        var terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
        if (!terms.length) { out.innerHTML = ''; count.textContent = ''; return; }
        var hits = rows.map(function (r) {
          var t = r[1].toLowerCase(), hay = (r[1] + ' ' + r[3] + ' ' + r[4]).toLowerCase(), score = 0;
          for (var i = 0; i < terms.length; i++) { if (hay.indexOf(terms[i]) < 0) return null; score += t.indexOf(terms[i]) >= 0 ? 3 : 1; }
          return { r: r, s: score };
        }).filter(Boolean).sort(function (a, b) { return b.s - a.s; }).slice(0, 40);
        count.textContent = hits.length ? hits.length + ' result' + (hits.length > 1 ? 's' : '') : 'No results. Try a broader word.';
        out.innerHTML = hits.map(function (h) {
          return '<li><a class="flex items-center justify-between gap-4 p-4 hover:bg-warm-50" href="' + h.r[2] + '"><span><span class="block font-display font-bold text-warm-950">' + esc(h.r[1]) + '</span><span class="block font-body text-sm text-warm-500">' + esc(h.r[3]) + '</span></span><span class="rounded-full bg-warm-100 px-2.5 py-1 font-body text-xs font-semibold text-warm-600">' + h.r[0] + '</span></a></li>';
        }).join('');
      }
      fetch('/search-index.json').then(function (r) { return r.json(); }).then(function (d) { rows = d; var p = new URLSearchParams(location.search).get('q'); if (p) q.value = p; run(); });
      q.addEventListener('input', run);
    })();
  </script>
</BaseLayout>
