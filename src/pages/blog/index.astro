---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const published = allPosts
  .filter(p => p.data.status !== 'draft')
  .sort((a, b) => {
    const dateA = a.data.publishedDate ? new Date(a.data.publishedDate).getTime() : 0;
    const dateB = b.data.publishedDate ? new Date(b.data.publishedDate).getTime() : 0;
    return dateB - dateA;
  });

const featured = published.filter(p => p.data.featured);
const recent   = published.filter(p => !p.data.featured);

const categories = [
  { value: 'destination-guide', label: 'Destination Guides' },
  { value: 'hotel-review', label: 'Hotel Reviews' },
  { value: 'travel-tips', label: 'Travel Tips' },
  { value: 'listicle', label: 'Top Lists' },
  { value: 'luxury-travel', label: 'Luxury Travel' },
  { value: 'itinerary', label: 'Itineraries' },
];
---

<BaseLayout
  title="Travel Blog — Guides, Reviews & Inspiration | StayAtNiche"
  description="Expert travel guides, hotel reviews, itineraries, and inspiration for extraordinary stays around the world."
>
  <!-- Hero -->
  <section class="relative bg-warm-50 overflow-hidden py-16">
    <div class="dot-pattern absolute inset-0 opacity-70 pointer-events-none" />
    <div class="absolute -top-20 -right-20 w-80 h-80 bg-gold-100/60 rounded-full blur-3xl pointer-events-none" />
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <nav class="flex items-center justify-center gap-2 text-warm-500 text-sm font-body mb-8">
        <a href="/" class="hover:text-warm-800 transition-colors">Home</a>
        <span class="text-warm-300">/</span>
        <span class="text-warm-800 font-medium">Blog</span>
      </nav>
      <h1 class="font-display text-5xl font-bold text-warm-950 mb-4">
        Travel <span class="text-gold-500">Inspiration</span>
      </h1>
      <p class="font-body text-warm-600 text-lg max-w-2xl mx-auto">
        Expert guides, hotel reviews, destination inspiration, and the stories behind the world's most extraordinary stays.
      </p>
    </div>
  </section>

  <!-- Category filter pills -->
  <section class="border-b border-warm-200 bg-white sticky top-[104px] z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center gap-2 overflow-x-auto scrollbar-hide">
        <button data-filter="all" class="filter-pill flex-shrink-0 font-body text-xs font-semibold bg-warm-950 text-white px-4 py-2 rounded-full">All</button>
        {categories.map(cat => (
          <button data-filter={cat.value} class="filter-pill flex-shrink-0 font-body text-xs text-warm-600 hover:text-warm-950 border border-warm-200 hover:border-warm-400 px-4 py-2 rounded-full transition-all whitespace-nowrap">
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured articles -->
  {featured.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-gold-500">✦</span>
        <h2 class="font-display text-2xl font-bold text-warm-950">Editor's Picks</h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="featured-grid">
        {featured.slice(0, 2).map(post => (
          <a href={`/blog/${post.slug}`} data-category={post.data.category} class="post-card group bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 border border-warm-100 flex flex-col">
            <div class="relative h-56 bg-gradient-to-br from-warm-100 to-warm-200 overflow-hidden">
              {post.data.coverImage ? (
                <img src={post.data.coverImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center text-warm-300">
                  <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
              {post.data.category && (
                <div class="absolute top-4 left-4 bg-white/90 backdrop-blur text-warm-800 font-body text-xs font-semibold px-3 py-1 rounded-full">
                  {post.data.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}
                </div>
              )}
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <h3 class="font-display text-xl font-bold text-warm-950 group-hover:text-forest-700 transition-colors mb-2 leading-snug">{post.data.title}</h3>
              {post.data.excerpt && <p class="font-body text-warm-600 text-sm leading-relaxed mb-4 line-clamp-3 flex-1">{post.data.excerpt}</p>}
              <div class="flex items-center justify-between mt-auto pt-4 border-t border-warm-100">
                <span class="font-body text-warm-400 text-xs">{post.data.author || 'StayAtNiche Team'}</span>
                {post.data.publishedDate && (
                  <span class="font-body text-warm-400 text-xs">
                    {new Date(post.data.publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- All posts grid -->
  <section class="bg-warm-100 border-y border-warm-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      {published.length === 0 ? (
        <div class="text-center py-20">
          <p class="font-display text-2xl text-warm-400 mb-3">No articles published yet</p>
          <p class="font-body text-warm-500">Check back soon — great content is on its way.</p>
        </div>
      ) : (
        <>
          {recent.length > 0 && <h2 class="font-display text-2xl font-bold text-warm-950 mb-8">All Articles</h2>}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="posts-grid">
            {(recent.length > 0 ? recent : published).map(post => (
              <a href={`/blog/${post.slug}`} data-category={post.data.category} class="post-card group bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 border border-warm-100">
                <div class="relative h-44 bg-gradient-to-br from-warm-100 to-warm-200 overflow-hidden">
                  {post.data.coverImage ? (
                    <img src={post.data.coverImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  ) : (
                    <div class="absolute inset-0 bg-gradient-to-br from-warm-100 to-warm-200" />
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" />
                  {post.data.category && (
                    <div class="absolute bottom-3 left-3 bg-white/90 text-warm-800 font-body text-xs font-semibold px-2.5 py-1 rounded-full">
                      {post.data.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}
                    </div>
                  )}
                </div>
                <div class="p-5">
                  <h3 class="font-display text-base font-bold text-warm-950 group-hover:text-forest-700 transition-colors mb-2 leading-snug line-clamp-2">{post.data.title}</h3>
                  {post.data.excerpt && <p class="font-body text-warm-500 text-sm leading-relaxed line-clamp-2 mb-3">{post.data.excerpt}</p>}
                  <div class="flex items-center justify-between">
                    <span class="font-body text-warm-400 text-xs">{post.data.author || 'StayAtNiche'}</span>
                    {post.data.publishedDate && (
                      <span class="font-body text-warm-400 text-xs">
                        {new Date(post.data.publishedDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                      </span>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
      <p id="no-results" class="hidden text-center py-16 font-body text-warm-400 text-lg">No articles found in this category.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('.post-card');
  const featuredGrid = document.getElementById('featured-grid');
  const noResults = document.getElementById('no-results');

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const filter = pill.dataset.filter ?? 'all';

      // Update active pill styles
      pills.forEach(p => {
        p.classList.remove('bg-warm-950', 'text-white', 'font-semibold');
        p.classList.add('text-warm-600', 'border', 'border-warm-200');
      });
      pill.classList.add('bg-warm-950', 'text-white', 'font-semibold');
      pill.classList.remove('text-warm-600', 'border', 'border-warm-200');

      // Filter cards
      let visible = 0;
      cards.forEach(card => {
        const match = filter === 'all' || card.dataset.category === filter;
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });

      // Show/hide featured section based on filter
      if (featuredGrid) {
        featuredGrid.style.display = filter === 'all' ? '' : 'none';
        featuredGrid.parentElement!.style.display = filter === 'all' ? '' : 'none';
      }

      // No results message
      if (noResults) noResults.classList.toggle('hidden', visible > 0);
    });
  });
</script>
