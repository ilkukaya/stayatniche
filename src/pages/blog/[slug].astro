---
import PostView from '../../views/PostView.astro';
import { localized } from '../../i18n/content';

export async function getStaticPaths() {
  return (await localized('blog', 'en')).map(post => ({ params: { slug: post.slug }, props: { post } }));
}
---
<PostView locale="en" post={Astro.props.post} />
