---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HotelCard from '../../components/HotelCard.astro';
import SocialShare from '../../components/SocialShare.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const allHotels = await getCollection('hotels', h => h.data.status !== 'draft' && h.data.status !== 'archived');
const relatedHotels = post.data.relatedHotels?.length
  ? allHotels.filter(h => post.data.relatedHotels.includes(h.slug))
  : allHotels.filter(h => h.data.featured).slice(0, 4);

const seo = post.data.seo || {};
const metaTitle = seo.metaTitle || post.data.title;
const metaDesc  = seo.metaDescription || post.data.excerpt || '';

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://stayatniche.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://stayatniche.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": `https://stayatniche.com/blog/${post.slug}/` },
  ],
};

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": metaDesc,
  "url": `https://stayatniche.com/blog/${post.slug}`,
  "author": {
    "@type": "Organization",
    "name": post.data.author || "StayAtNiche Team",
  },
  "publisher": {
    "@type": "Organization",
    "name": "StayAtNiche",
    "logo": { "@type": "ImageObject", "url": "https://stayatniche.com/logo.svg" },
  },
  ...(post.data.publishedDate ? { "datePublished": new Date(post.data.publishedDate).toISOString() } : {}),
  ...(post.data.updatedDate ? { "dateModified": new Date(post.data.updatedDate).toISOString() } : {}),
  ...(post.data.coverImage ? { "image": post.data.coverImage.startsWith('http') ? post.data.coverImage : `https://stayatniche.com${post.data.coverImage}` } : {}),
};
---

<BaseLayout title={metaTitle} description={metaDesc} type="article">

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <article>
    <!-- Hero -->
    <section class="relative bg-warm-50 overflow-hidden py-14">
      <div class="dot-pattern absolute inset-0 opacity-60 pointer-events-none" />
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-warm-500 text-sm font-body mb-8">
          <a href="/" class="hover:text-warm-800 transition-colors">Home</a>
          <span class="text-warm-300">/</span>
          <a href="/blog" class="hover:text-warm-800 transition-colors">Blog</a>
          <span class="text-warm-300">/</span>
          <span class="text-warm-700 font-medium line-clamp-1">{post.data.title}</span>
        </nav>

        {post.data.category && (
          <span class="inline-block bg-white border border-warm-200 text-warm-700 font-body text-xs font-semibold px-3 py-1.5 rounded-full mb-5">
            {post.data.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}
          </span>
        )}

        <h1 class="font-display text-4xl sm:text-5xl font-bold text-warm-950 mb-5 leading-tight">
          {post.data.title}
        </h1>

        {post.data.excerpt && (
          <p class="font-body text-warm-600 text-xl leading-relaxed mb-7">{post.data.excerpt}</p>
        )}

        <div class="flex flex-wrap items-center gap-5">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-warm-200 flex items-center justify-center text-warm-700 font-display font-bold text-sm">
              {(post.data.author || 'S').charAt(0)}
            </div>
            <span class="font-body text-warm-600 text-sm">{post.data.author || 'StayAtNiche Team'}</span>
          </div>
          {post.data.publishedDate && (
            <span class="font-body text-warm-400 text-sm">
              {new Date(post.data.publishedDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </span>
          )}
          {post.data.affiliateDisclosure && (
            <span class="inline-flex items-center gap-1 bg-amber-50 border border-amber-200 text-amber-700 font-body text-xs px-3 py-1 rounded-full">
              Contains affiliate links
            </span>
          )}
        </div>

        <div class="mt-5">
          <SocialShare
            title={post.data.title}
            url={`/blog/${post.slug}/`}
            description={post.data.excerpt || ''}
            image={post.data.coverImage || ''}
          />
        </div>
      </div>
    </section>

    <!-- Cover image -->
    {post.data.coverImage && (
      <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-2 mb-12">
        <div class="rounded-3xl overflow-hidden h-72 sm:h-96">
          <img src={post.data.coverImage} alt={post.data.title} class="w-full h-full object-cover" />
        </div>
      </section>
    )}

    <!-- Content -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="prose prose-warm max-w-none
        prose-headings:font-display prose-headings:text-warm-950
        prose-p:font-body prose-p:text-warm-700 prose-p:leading-relaxed
        prose-h2:text-3xl prose-h2:font-bold prose-h2:mt-12 prose-h2:mb-5
        prose-h3:text-2xl prose-h3:font-bold prose-h3:mt-9 prose-h3:mb-4
        prose-strong:text-warm-900 prose-a:text-forest-600 hover:prose-a:underline
        prose-li:text-warm-700 prose-li:font-body prose-blockquote:border-gold-400
        prose-blockquote:text-warm-600 prose-blockquote:font-display prose-blockquote:text-lg">
        <Content />
      </div>
    </section>
  </article>

  <!-- Affiliate partner strip -->
  <section class="border-t border-warm-200 bg-warm-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <p class="font-body text-warm-500 text-xs uppercase tracking-widest font-semibold text-center mb-5">Plan Your Trip</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <a href="https://www.expedia.com/Hotels" target="_blank" rel="noopener noreferrer nofollow sponsored"
          class="flex flex-col items-center text-center bg-white border border-warm-200 hover:border-[#00356B]/30 hover:bg-[#00356B]/5 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 bg-[#00356B] rounded-full flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
          </div>
          <span class="font-body text-xs font-semibold text-warm-800">Hotels</span>
          <span class="font-body text-[10px] text-warm-400 mt-0.5">Expedia</span>
        </a>
        <a href="https://www.klook.com" target="_blank" rel="noopener noreferrer nofollow sponsored"
          class="flex flex-col items-center text-center bg-white border border-warm-200 hover:border-[#FF5722]/30 hover:bg-[#FF5722]/5 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 bg-[#FF5722] rounded-full flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <span class="font-body text-xs font-semibold text-warm-800">Tours</span>
          <span class="font-body text-[10px] text-warm-400 mt-0.5">Klook</span>
        </a>
        <a href="https://tiqets.com" target="_blank" rel="noopener noreferrer nofollow sponsored"
          class="flex flex-col items-center text-center bg-white border border-warm-200 hover:border-[#6C3AE8]/30 hover:bg-[#6C3AE8]/5 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 bg-[#6C3AE8] rounded-full flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M20 12c0-1.1.9-2 2-2V6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v4c1.1 0 2 .9 2 2s-.9 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2z"/></svg>
          </div>
          <span class="font-body text-xs font-semibold text-warm-800">Tickets</span>
          <span class="font-body text-[10px] text-warm-400 mt-0.5">Tiqets</span>
        </a>
        <a href="https://www.kiwi.com" target="_blank" rel="noopener noreferrer nofollow sponsored"
          class="flex flex-col items-center text-center bg-white border border-warm-200 hover:border-warm-400 hover:bg-warm-50 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 bg-warm-800 rounded-full flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
          </div>
          <span class="font-body text-xs font-semibold text-warm-800">Flights</span>
          <span class="font-body text-[10px] text-warm-400 mt-0.5">Kiwi.com</span>
        </a>
      </div>
      <p class="font-body text-warm-400 text-[10px] text-center mt-4">
        Affiliate links — commission earned at no cost to you. <a href="/disclosure" class="underline hover:text-warm-600">Disclosure</a>
      </p>
    </div>
  </section>

  <!-- Related hotels -->
  {relatedHotels.length > 0 && (
    <section class="bg-warm-100 border-t border-warm-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <h2 class="font-display text-2xl font-bold text-warm-950 mb-8">
          Extraordinary <span class="text-gold-500">Stays</span> to Book
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {relatedHotels.map(h => (
            <HotelCard
              name={h.data.name}
              destination={h.data.destination}
              country={h.data.country}
              description={h.data.description}
              priceRange={h.data.priceRange}
              priceIndicator={h.data.priceIndicator}
              rating={h.data.rating}
              reviewCount={h.data.reviewCount}
              highlights={h.data.highlights}
              bookingUrl={h.data.bookingUrl}
              slug={h.slug}
              category={h.data.category}
              featured={h.data.featured}
              coverImage={h.data.coverImage}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
