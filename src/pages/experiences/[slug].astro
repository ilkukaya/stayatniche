---
import ExperienceView from '../../views/ExperienceView.astro';
import { localized } from '../../i18n/content';

export async function getStaticPaths() {
  return (await localized('experiences', 'en')).map(experience => ({ params: { slug: experience.slug }, props: { experience } }));
}
---
<ExperienceView locale="en" experience={Astro.props.experience} />
