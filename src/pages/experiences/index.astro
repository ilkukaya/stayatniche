---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allExperiences = await getCollection('experiences');
const sorted = allExperiences.sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0));

const types = [
  { value: 'guided-tour', label: 'Guided Tours' },
  { value: 'adventure', label: 'Adventure' },
  { value: 'cultural', label: 'Cultural' },
  { value: 'food-drink', label: 'Food & Drink' },
  { value: 'wellness', label: 'Wellness' },
  { value: 'wildlife', label: 'Wildlife' },
  { value: 'water-activity', label: 'Water' },
  { value: 'night-experience', label: 'Night Experiences' },
  { value: 'day-trip', label: 'Day Trips' },
];

const byType = types.reduce((acc, t) => {
  acc[t.value] = sorted.filter(e => e.data.type === t.value);
  return acc;
}, {} as Record<string, typeof sorted>);

const otherTypes = sorted.filter(e => !types.some(t => t.value === e.data.type));
---

<BaseLayout
  title="Experiences — Tours, Activities & Adventures | StayAtNiche"
  description="Book unforgettable experiences around your extraordinary stay — guided tours, wildlife safaris, hot air balloon rides, and more."
>
  <!-- Hero -->
  <section class="relative bg-warm-50 overflow-hidden py-16">
    <div class="dot-pattern absolute inset-0 opacity-70 pointer-events-none" />
    <div class="absolute -top-16 -right-16 w-72 h-72 bg-gold-100/60 rounded-full blur-3xl pointer-events-none" />
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <nav class="flex items-center justify-center gap-2 text-warm-500 text-sm font-body mb-8">
        <a href="/" class="hover:text-warm-800 transition-colors">Home</a>
        <span class="text-warm-300">/</span>
        <span class="text-warm-800 font-medium">Experiences</span>
      </nav>
      <h1 class="font-display text-5xl font-bold text-warm-950 mb-4">
        Beyond the <span class="text-gold-500">Hotel Room</span>
      </h1>
      <p class="font-body text-warm-600 text-lg max-w-2xl mx-auto">
        Curated tours, activities, and adventures to complement your extraordinary stay. From Cappadocia balloon rides to African wildlife safaris.
      </p>
    </div>
  </section>

  <!-- Type filter -->
  <section class="border-b border-warm-200 bg-white sticky top-[104px] z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center gap-2 overflow-x-auto scrollbar-hide">
        <a href="/experiences" class="flex-shrink-0 font-body text-xs font-semibold bg-warm-950 text-white px-4 py-2 rounded-full">All</a>
        {types.filter(t => byType[t.value]?.length > 0).map(t => (
          <a href={`#${t.value}`} class="flex-shrink-0 font-body text-xs text-warm-600 hover:text-warm-950 border border-warm-200 hover:border-warm-400 px-4 py-2 rounded-full transition-all whitespace-nowrap">
            {t.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Experiences grouped by type -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    {sorted.length === 0 ? (
      <div class="text-center py-20">
        <p class="font-display text-2xl text-warm-400 mb-3">Experiences coming soon</p>
        <p class="font-body text-warm-500 mb-8">We're curating the best tours and activities to complement your extraordinary stay.</p>
        <a href="/categories" class="inline-flex items-center gap-2 bg-forest-600 text-white font-body font-semibold px-6 py-3 rounded-full hover:bg-forest-700 transition-colors">
          Browse Hotel Categories
        </a>
      </div>
    ) : (
      <div>
        {types.filter(t => byType[t.value]?.length > 0).map(typeGroup => (
          <div id={typeGroup.value} class="mb-16 scroll-mt-48">
            <div class="flex items-center gap-3 mb-6">
              <h2 class="font-display text-2xl font-bold text-warm-950">{typeGroup.label}</h2>
              <span class="font-body text-warm-400 text-sm">({byType[typeGroup.value].length})</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              {byType[typeGroup.value].map(exp => (
                <a href={`/experiences/${exp.slug}`} class="group bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 border border-warm-100">
                  <div class="relative h-48 bg-gradient-to-br from-warm-100 to-warm-200 overflow-hidden">
                    {exp.data.coverImage ? (
                      <img src={exp.data.coverImage} alt={exp.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                    ) : (
                      <div class="absolute inset-0 bg-gradient-to-br from-forest-100 to-warm-200" />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
                    {exp.data.rating && (
                      <div class="absolute top-3 right-3 flex items-center gap-1 bg-white/90 backdrop-blur text-warm-900 text-sm font-body font-bold px-2.5 py-1 rounded-full">
                        <svg class="w-3.5 h-3.5 text-gold-500 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        {exp.data.rating.toFixed(1)}
                      </div>
                    )}
                  </div>
                  <div class="p-5">
                    <h3 class="font-display text-base font-bold text-warm-950 group-hover:text-forest-700 transition-colors mb-1 leading-snug">{exp.data.title}</h3>
                    {exp.data.destination && <p class="font-body text-warm-400 text-xs mb-2">{exp.data.destination}, {exp.data.country}</p>}
                    {exp.data.description && <p class="font-body text-warm-600 text-sm line-clamp-2 mb-4">{exp.data.description}</p>}
                    <div class="flex items-center justify-between pt-3 border-t border-warm-100">
                      {exp.data.booking?.price && <span class="font-body text-warm-600 text-sm font-semibold">{exp.data.booking.price}</span>}
                      {exp.data.booking?.duration && <span class="font-body text-warm-400 text-xs">{exp.data.booking.duration}</span>}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
        {otherTypes.length > 0 && (
          <div class="mb-16">
            <h2 class="font-display text-2xl font-bold text-warm-950 mb-6">More Experiences</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              {otherTypes.map(exp => (
                <a href={`/experiences/${exp.slug}`} class="group bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 border border-warm-100">
                  <div class="relative h-48 bg-gradient-to-br from-forest-100 to-warm-200 overflow-hidden">
                    {exp.data.coverImage && <img src={exp.data.coverImage} alt={exp.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
                    {exp.data.type && (
                      <div class="absolute bottom-3 left-3 bg-white/90 text-warm-800 font-body text-xs font-semibold px-2.5 py-1 rounded-full capitalize">
                        {exp.data.type.replace(/-/g, ' ')}
                      </div>
                    )}
                  </div>
                  <div class="p-5">
                    <h3 class="font-display text-base font-bold text-warm-950 group-hover:text-forest-700 transition-colors mb-1 leading-snug">{exp.data.title}</h3>
                    {exp.data.destination && <p class="font-body text-warm-400 text-xs mb-2">{exp.data.destination}, {exp.data.country}</p>}
                    {exp.data.description && <p class="font-body text-warm-600 text-sm line-clamp-2 mb-4">{exp.data.description}</p>}
                    <div class="flex items-center justify-between pt-3 border-t border-warm-100">
                      {exp.data.booking?.price && <span class="font-body text-warm-600 text-sm font-semibold">{exp.data.booking.price}</span>}
                      {exp.data.booking?.duration && <span class="font-body text-warm-400 text-xs">{exp.data.booking.duration}</span>}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </section>
</BaseLayout>
