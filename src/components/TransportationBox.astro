---
/**
 * TransportationBox — "How to Get There" section for hotel pages.
 * Shows contextually relevant transport options based on destination country/category.
 * Integrates: Localrent, QEEQ, AutoEurope, EconomyBookings, GetRentacar, BikeBooking,
 *             intui.travel, SEARADAR, Welcome Pickups, KiwiTaxi, GetTransfer,
 *             Aviasales, Kiwi.com
 */

interface Props {
  destination: string;
  country: string;
  category?: string;
}

const { destination, country, category = '' } = Astro.props;

const marker = '478307';
const destEnc = encodeURIComponent(destination);
const countryEnc = encodeURIComponent(country);
const fullEnc = encodeURIComponent(`${destination}, ${country}`);

// --- Region logic ---
// Countries where self-drive / car rental is the primary way to explore
const carRentalFirst = [
  'Iceland', 'Norway', 'Sweden', 'Finland', 'Scotland', 'Ireland',
  'New Zealand', 'Australia', 'Canada', 'United States', 'USA',
  'South Africa', 'Namibia', 'Morocco', 'Portugal', 'Spain',
  'Croatia', 'Greece', 'Italy', 'France', 'Germany', 'Austria',
];

// Countries / categories where bike rental is popular
const bikeRelevant = [
  'Indonesia', 'Thailand', 'Vietnam', 'Cambodia', 'Laos',
  'Portugal', 'Netherlands', 'Denmark', 'Belgium',
];

// Destinations where boat rental is very relevant (coastal/island)
const boatRelevant = [
  'Greece', 'Croatia', 'Montenegro', 'Maldives', 'Indonesia',
  'Philippines', 'Thailand', 'Caribbean', 'French Polynesia',
  'Seychelles', 'Malta',
];

// Categories that strongly suggest car rental
const carCategories = ['desert-camps', 'ice-hotels', 'cliffside-hotels', 'jungle-lodges'];

const isCarFirst = carRentalFirst.includes(country) || carCategories.includes(category);
const showBike = bikeRelevant.includes(country);
const showBoat = boatRelevant.includes(country);

// --- Affiliate links (via tp.media with marker) ---
function tpLink(programId: string, targetUrl: string): string {
  return `https://tp.media/r?marker=${marker}&p=${programId}&u=${encodeURIComponent(targetUrl)}`;
}

// Car rental links (destination-aware search)
const localrentUrl = tpLink('6202', `https://localrent.com/en/?location=${destEnc}`);
const qeeqUrl = tpLink('7033', `https://www.qeeq.com/search?q=${fullEnc}`);
const autoeuropeUrl = tpLink('4531', `https://www.autoeurope.com/?aff=tp&location=${fullEnc}`);
const economybookingsUrl = tpLink('7066', `https://www.economybookings.com/?location=${destEnc}`);
const intuitravelUrl = tpLink('5834', `https://intui.travel/en/?location=${destEnc}`);

// Bike rental
const bikebookingUrl = tpLink('6009', `https://www.bikebooking.com/en/search?location=${fullEnc}`);

// Boat rental
const searadarUrl = tpLink('6890', `https://searadar.com/en/?location=${destEnc}`);

// Transfer links
const welcomePickupsUrl = tpLink('4558', `https://www.welcomepickups.com/transfers/?destination=${destEnc}`);
const kiwitaxiUrl = tpLink('4039', `https://kiwitaxi.com/search?startPlace=${destEnc}`);
const gettransferUrl = tpLink('5976', `https://gettransfer.com/en/search?from=${destEnc}`);

// Flight links
const kiwiUrl = tpLink('4114', `https://www.kiwi.com/en/search/results/anywhere/${fullEnc}/anytime/anytime`);
const aviasalesUrl = `https://www.aviasales.com/search/to/${destEnc}?marker=${marker}`;
---

<div class="bg-white rounded-2xl border border-warm-200 shadow-card p-6">
  <h3 class="font-display text-lg font-bold text-warm-950 mb-1">How to Get There</h3>
  <p class="font-body text-warm-400 text-xs mb-5">Transport options for {destination}, {country}</p>

  <div class="space-y-5">

    {/* ── Flights ── */}
    <div>
      <p class="font-body text-[10px] font-bold uppercase tracking-wider text-warm-400 mb-2">✈ Flights</p>
      <div class="space-y-2">
        <a
          href={kiwiUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="flex items-center justify-between w-full bg-[#00B2A9] hover:bg-[#009d95] text-white font-body font-semibold text-sm px-4 py-3 rounded-xl transition-all group"
        >
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-white/80" fill="currentColor" viewBox="0 0 24 24">
              <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
            </svg>
            <div>
              <div class="font-semibold text-sm">Kiwi.com</div>
              <div class="text-white/60 text-xs">Cheapest routes & combos</div>
            </div>
          </div>
          <svg class="w-4 h-4 text-white/60 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href={aviasalesUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="flex items-center justify-between w-full border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-sm px-4 py-3 rounded-xl transition-all group"
        >
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-warm-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
            </svg>
            <div>
              <div class="font-semibold text-sm">Aviasales</div>
              <div class="text-warm-400 text-xs">Compare 100+ airlines</div>
            </div>
          </div>
          <svg class="w-4 h-4 text-warm-400 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    {/* ── Transfers ── */}
    <div>
      <p class="font-body text-[10px] font-bold uppercase tracking-wider text-warm-400 mb-2">🚕 Airport Transfers</p>
      <div class="space-y-2">
        <a
          href={welcomePickupsUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="flex items-center justify-between w-full bg-[#2563EB] hover:bg-[#1d4ed8] text-white font-body font-semibold text-sm px-4 py-3 rounded-xl transition-all group"
        >
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-white/80" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
            </svg>
            <div>
              <div class="font-semibold text-sm">Welcome Pickups</div>
              <div class="text-white/60 text-xs">Private airport transfers</div>
            </div>
          </div>
          <svg class="w-4 h-4 text-white/60 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <div class="grid grid-cols-2 gap-2">
          <a
            href={kiwitaxiUrl}
            target="_blank"
            rel="noopener noreferrer nofollow sponsored"
            class="flex items-center gap-2 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-xs px-3 py-2.5 rounded-xl transition-all"
          >
            <svg class="w-3.5 h-3.5 text-warm-500 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99z"/>
            </svg>
            KiwiTaxi
          </a>
          <a
            href={gettransferUrl}
            target="_blank"
            rel="noopener noreferrer nofollow sponsored"
            class="flex items-center gap-2 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-xs px-3 py-2.5 rounded-xl transition-all"
          >
            <svg class="w-3.5 h-3.5 text-warm-500 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99z"/>
            </svg>
            GetTransfer
          </a>
        </div>
      </div>
    </div>

    {/* ── Car Rental ── */}
    <div class:list={[isCarFirst ? 'order-first' : '']}>
      <p class="font-body text-[10px] font-bold uppercase tracking-wider text-warm-400 mb-2">🚗 Car Rental</p>
      <div class="space-y-2">
        {isCarFirst ? (
          <>
            <a
              href={localrentUrl}
              target="_blank"
              rel="noopener noreferrer nofollow sponsored"
              class="flex items-center justify-between w-full bg-[#E53E3E] hover:bg-[#c53030] text-white font-body font-semibold text-sm px-4 py-3 rounded-xl transition-all group"
            >
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-white/80" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
                </svg>
                <div>
                  <div class="font-semibold text-sm">Localrent</div>
                  <div class="text-white/60 text-xs">Local agencies · Best prices</div>
                </div>
              </div>
              <svg class="w-4 h-4 text-white/60 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
            <div class="grid grid-cols-2 gap-2">
              <a href={qeeqUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="flex items-center gap-2 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-xs px-3 py-2.5 rounded-xl transition-all">
                <svg class="w-3.5 h-3.5 text-warm-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8z"/></svg>
                QEEQ
              </a>
              <a href={autoeuropeUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="flex items-center gap-2 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-xs px-3 py-2.5 rounded-xl transition-all">
                <svg class="w-3.5 h-3.5 text-warm-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8z"/></svg>
                AutoEurope
              </a>
              <a href={economybookingsUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="flex items-center gap-2 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-xs px-3 py-2.5 rounded-xl transition-all">
                <svg class="w-3.5 h-3.5 text-warm-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8z"/></svg>
                EconomyBookings
              </a>
              <a href={intuitravelUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="flex items-center gap-2 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-xs px-3 py-2.5 rounded-xl transition-all">
                <svg class="w-3.5 h-3.5 text-warm-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8z"/></svg>
                intui.travel
              </a>
            </div>
          </>
        ) : (
          <div class="grid grid-cols-2 gap-2">
            <a href={localrentUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="flex items-center gap-2 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-xs px-3 py-2.5 rounded-xl transition-all">
              <svg class="w-3.5 h-3.5 text-warm-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8z"/></svg>
              Localrent
            </a>
            <a href={qeeqUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="flex items-center gap-2 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-xs px-3 py-2.5 rounded-xl transition-all">
              <svg class="w-3.5 h-3.5 text-warm-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8z"/></svg>
              QEEQ
            </a>
            <a href={autoeuropeUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="flex items-center gap-2 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-xs px-3 py-2.5 rounded-xl transition-all">
              <svg class="w-3.5 h-3.5 text-warm-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8z"/></svg>
              AutoEurope
            </a>
            <a href={economybookingsUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="flex items-center gap-2 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-xs px-3 py-2.5 rounded-xl transition-all">
              <svg class="w-3.5 h-3.5 text-warm-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8z"/></svg>
              EconomyBookings
            </a>
          </div>
        )}
      </div>
    </div>

    {/* ── Bike Rental (conditional) ── */}
    {showBike && (
      <div>
        <p class="font-body text-[10px] font-bold uppercase tracking-wider text-warm-400 mb-2">🛵 Bike & Scooter</p>
        <a
          href={bikebookingUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="flex items-center justify-between w-full border border-warm-200 hover:border-forest-300 hover:bg-forest-50 text-warm-800 font-body font-semibold text-sm px-4 py-3 rounded-xl transition-all group"
        >
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-warm-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M15.5 5.5c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zM5 12c-2.8 0-5 2.2-5 5s2.2 5 5 5 5-2.2 5-5-2.2-5-5-5zm0 8.5c-1.9 0-3.5-1.6-3.5-3.5s1.6-3.5 3.5-3.5 3.5 1.6 3.5 3.5-1.6 3.5-3.5 3.5zm5.8-10l2.4-2.4.8.8c1.3 1.3 3 2.1 5.1 2.1V9c-1.5 0-2.7-.6-3.6-1.5l-1.9-1.9c-.5-.4-1-.6-1.6-.6s-1.1.2-1.4.6L7.8 8.4c-.4.4-.6.9-.6 1.4 0 .6.2 1.1.6 1.4L11 14v5h2v-6.2l-2.2-2.3z"/>
            </svg>
            <div>
              <div class="font-semibold text-sm">BikeBooking</div>
              <div class="text-warm-400 text-xs">Bikes, scooters & motorbikes</div>
            </div>
          </div>
          <svg class="w-4 h-4 text-warm-400 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    )}

    {/* ── Boat Rental (conditional) ── */}
    {showBoat && (
      <div>
        <p class="font-body text-[10px] font-bold uppercase tracking-wider text-warm-400 mb-2">⛵ Boat & Yacht</p>
        <a
          href={searadarUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="flex items-center justify-between w-full bg-[#0EA5E9] hover:bg-[#0284c7] text-white font-body font-semibold text-sm px-4 py-3 rounded-xl transition-all group"
        >
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-white/80" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 21c-1.39 0-2.78-.47-4-1.32-2.44 1.71-5.56 1.71-8 0C6.78 20.53 5.39 21 4 21H2v2h2c1.38 0 2.74-.35 4-.99 2.52 1.29 5.48 1.29 8 0 1.26.64 2.62.99 4 .99h2v-2h-2zM3.95 19H4c1.6 0 3.02-.88 4-2 .98 1.12 2.4 2 4 2s3.02-.88 4-2c.98 1.12 2.4 2 4 2h.05l1.89-6.68c.08-.26.06-.54-.06-.78s-.34-.42-.6-.5L20 11V6c0-1.1-.9-2-2-2h-3V1H9v3H6c-1.1 0-2 .9-2 2v5l-1.29.42c-.26.08-.48.26-.6.5s-.14.52-.06.78L3.95 19zM6 6h12v4.55l-6-2-6 2V6z"/>
            </svg>
            <div>
              <div class="font-semibold text-sm">SEARADAR</div>
              <div class="text-white/60 text-xs">Boats, yachts & water sports</div>
            </div>
          </div>
          <svg class="w-4 h-4 text-white/60 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    )}

  </div>

  <p class="font-body text-warm-400 text-[10px] text-center pt-4 mt-1 border-t border-warm-100 leading-relaxed">
    Affiliate links — we earn a small commission at no extra cost to you.
    <a href="/disclosure" class="underline hover:text-warm-600">Learn more</a>
  </p>
</div>
