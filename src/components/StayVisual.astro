---
/**
 * Image area for a stay. Shows the stay's own photo when one exists; otherwise a free-licensed
 * photo taken near it, labelled with the place ("Around Göreme") so it never passes for the hotel;
 * otherwise a typographic "travel label" in the category's tone, unique per stay (place name).
 */
import CategoryIcon from './CategoryIcon.astro';
import { ownPhoto, areaPhoto, CATEGORY_TONE } from '../lib/images';
import { getLocale, i18n } from '../i18n';
interface Props { slug: string; name: string; category: string; destination: string; country: string; coverImage?: string; eager?: boolean; size?: 'card' | 'hero'; }
const { slug, name, category, destination, country, coverImage, eager = false, size = 'card' } = Astro.props;
const L = i18n(getLocale(Astro.url));
const photo = ownPhoto(coverImage, slug);
const area = photo ? null : areaPhoto(slug);
const [bg, ink] = CATEGORY_TONE[category] ?? ['#E5E2DA', '#2D2A26'];
const place = destination.split(',')[0].trim();
const hero = size === 'hero';
---
{photo ? (
  <img src={photo} alt={`${name}, ${destination}`} class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" width="1200" height="900" />
) : area ? (
  <div class="relative h-full w-full">
    <img src={area} alt={L.t.card.around(place)} class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" width="1200" height="900" />
    <span class:list={['pointer-events-none absolute right-2.5 inline-flex items-center gap-1 rounded-full bg-black/55 font-body font-medium text-white backdrop-blur-sm', hero ? 'bottom-4 px-3 py-1.5 text-xs' : 'bottom-2.5 px-2 py-0.5 text-[11px]']}>
      <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6-5.3-6-10a6 6 0 1 1 12 0c0 4.7-6 10-6 10Z"/><circle cx="12" cy="11" r="2"/></svg>
      {L.t.card.around(place)}
    </span>
  </div>
) : (
  <div class="label-card relative flex h-full w-full flex-col justify-between overflow-hidden" style={`background:${bg};color:${ink}`} role="img" aria-label={`${name}, ${destination}`}>
    <CategoryIcon slug={category} size={hero ? 420 : 220} strokeWidth={0.6} class="pointer-events-none absolute -bottom-[18%] -right-[12%] opacity-[.13] transition-transform duration-700 group-hover:rotate-[-6deg]" />
    <div class:list={['flex items-center justify-between', hero ? 'p-8' : 'p-4']}>
      <span class="eyebrow opacity-70">{L.cat(category, category.replace(/-/g, ' '))}</span>
      <CategoryIcon slug={category} size={hero ? 28 : 18} strokeWidth={1.6} />
    </div>
    <div class={hero ? 'p-8' : 'p-4 pt-0'}>
      <p class:list={['font-display leading-[.95]', hero ? 'text-6xl sm:text-7xl' : 'text-[2.1rem]']}>{place}</p>
      <p class:list={['mt-1 font-body font-medium opacity-70', hero ? 'text-base' : 'text-xs']}>{country}</p>
    </div>
  </div>
)}
