---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/categories', label: 'Categories' },
];
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-stone-950/90 backdrop-blur-md border-b border-stone-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-2xl">✦</span>
        <span class="font-display text-xl font-bold text-gold-400 group-hover:text-gold-300 transition-colors">
          StayAtNiche
        </span>
      </a>

      <!-- Nav -->
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'font-body text-sm tracking-wide transition-colors',
              currentPath === link.href
                ? 'text-gold-400'
                : 'text-stone-300 hover:text-gold-400'
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <a
        href="/categories"
        class="hidden md:inline-flex items-center gap-2 bg-gold-500 hover:bg-gold-400 text-stone-950 font-body font-semibold text-sm px-4 py-2 rounded-full transition-colors"
      >
        Explore Stays
      </a>

      <!-- Mobile menu button -->
      <button
        class="md:hidden text-stone-300 hover:text-gold-400"
        id="mobile-menu-toggle"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="md:hidden hidden bg-stone-950 border-t border-stone-800" id="mobile-menu">
    <div class="px-4 py-4 space-y-3">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="block font-body text-stone-300 hover:text-gold-400 py-2 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/categories"
        class="block w-full text-center bg-gold-500 hover:bg-gold-400 text-stone-950 font-body font-semibold text-sm px-4 py-2 rounded-full transition-colors mt-2"
      >
        Explore Stays
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
