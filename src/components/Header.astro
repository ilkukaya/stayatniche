---
import CategoryIcon from './CategoryIcon.astro';

const navLinks = [
  { href: '/destinations', label: 'Destinations' },
  { href: '/experiences',  label: 'Experiences' },
  { href: '/blog',         label: 'Blog' },
];

const categories = [
  { slug: 'treehouse-hotels',    label: 'Treehouse hotels',    desc: 'Sleep up in the canopy' },
  { slug: 'cave-hotels',         label: 'Cave hotels',         desc: 'Rooms carved from rock' },
  { slug: 'underwater-rooms',    label: 'Underwater rooms',    desc: 'Wake up under the sea' },
  { slug: 'castle-hotels',       label: 'Castle hotels',       desc: 'Stay the weekend, knight' },
  { slug: 'floating-hotels',     label: 'Floating hotels',     desc: 'Rooms right on the water' },
  { slug: 'bubble-hotels',       label: 'Bubble hotels',       desc: 'Transparent stargazing domes' },
  { slug: 'cliffside-hotels',    label: 'Cliffside hotels',    desc: 'Built into the edge' },
  { slug: 'desert-camps',        label: 'Desert camps',        desc: 'Dunes and quiet skies' },
  { slug: 'jungle-lodges',       label: 'Jungle lodges',       desc: 'Deep in the rainforest' },
  { slug: 'ice-hotels',          label: 'Ice hotels',          desc: 'Sculpted fresh every winter' },
  { slug: 'safari-lodges',       label: 'Safari lodges',       desc: 'Wake to lions at dawn' },
  { slug: 'overwater-bungalows', label: 'Overwater bungalows', desc: 'Lagoon life, elevated' },
  { slug: 'lighthouse-hotels',   label: 'Lighthouse hotels',   desc: 'Beacon views, sea air' },
  { slug: 'train-hotels',        label: 'Train hotels',        desc: 'Legendary rail journeys' },
];

const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-white/98 backdrop-blur-md border-b border-warm-200/80 shadow-sm"
  id="site-header"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group flex-shrink-0" aria-label="StayAtNiche — home">
        <svg class="w-5 h-5 text-gold-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l2.9 6.6 7.1.7-5.4 4.8 1.7 6.9L12 17.4 5.7 21l1.7-6.9L2 9.3l7.1-.7L12 2z"/>
        </svg>
        <span class="font-display text-xl font-bold text-warm-950 group-hover:text-warm-700 transition-colors">
          StayAtNiche
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1">

        <!-- Categories mega dropdown -->
        <div class="relative group" id="categories-dropdown">
          <button
            class:list={[
              'flex items-center gap-1 font-body text-sm font-medium px-3 py-2 rounded-lg transition-colors',
              currentPath.startsWith('/categories')
                ? 'text-warm-950 bg-warm-100'
                : 'text-warm-600 hover:text-warm-950 hover:bg-warm-50',
            ]}
          >
            Categories
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Mega dropdown panel -->
          <div
            class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-[680px] bg-white rounded-2xl shadow-[0_8px_40px_rgba(0,0,0,0.12)] border border-warm-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0 pointer-events-none group-hover:pointer-events-auto"
            id="mega-menu"
          >
            <div class="p-5">
              <div class="flex items-center justify-between mb-4">
                <p class="font-body text-xs font-semibold uppercase tracking-widest text-warm-400">Browse all types</p>
                <a href="/categories" class="font-body text-xs font-semibold text-forest-600 hover:text-forest-700 transition-colors">
                  View all →
                </a>
              </div>
              <div class="grid grid-cols-3 gap-1">
                {categories.map(cat => (
                  <a
                    href={`/categories/${cat.slug}`}
                    class="group/item flex items-start gap-2.5 p-2.5 rounded-xl hover:bg-warm-50 transition-colors"
                  >
                    <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-warm-100 group-hover/item:bg-forest-100 text-forest-600 flex-shrink-0 transition-colors">
                      <CategoryIcon slug={cat.slug} size={14} />
                    </span>
                    <div>
                      <div class="font-body text-sm font-semibold text-warm-900 group-hover/item:text-forest-700 transition-colors leading-snug">
                        {cat.label}
                      </div>
                      <div class="font-body text-xs text-warm-400 leading-snug mt-0.5">
                        {cat.desc}
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
            <!-- Bottom CTA bar -->
            <div class="border-t border-warm-100 px-5 py-3 bg-warm-50/60 rounded-b-2xl flex items-center justify-between">
              <p class="font-body text-xs text-warm-500">Not sure where to start?</p>
              <a
                href="/categories"
                class="inline-flex items-center gap-1.5 bg-forest-600 hover:bg-forest-700 text-white font-body font-semibold text-xs px-4 py-2 rounded-full transition-colors"
              >
                Explore all categories →
              </a>
            </div>
          </div>
        </div>

        <!-- Other nav links -->
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'font-body text-sm font-medium px-3 py-2 rounded-lg transition-colors',
              currentPath === link.href || currentPath.startsWith(link.href + '/')
                ? 'text-warm-950 bg-warm-100'
                : 'text-warm-600 hover:text-warm-950 hover:bg-warm-50',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA -->
      <a
        href="/categories"
        class="hidden md:inline-flex items-center gap-1.5 bg-forest-600 hover:bg-forest-700 text-white font-body font-semibold text-sm px-5 py-2.5 rounded-full transition-all hover:shadow-md active:scale-95"
      >
        Find Your Stay
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <button
        class="md:hidden text-warm-700 p-1.5 rounded-lg hover:bg-warm-100 transition-colors"
        id="mobile-menu-toggle"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" id="icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-5 h-5 hidden" id="icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="md:hidden hidden bg-white border-t border-warm-100 max-h-[80vh] overflow-y-auto" id="mobile-menu">
    <div class="px-4 py-3 space-y-0.5">
      <a href="/categories" class="flex items-center justify-between font-body text-warm-700 hover:text-warm-950 hover:bg-warm-50 py-2.5 px-3 rounded-xl transition-colors text-sm font-semibold">
        All Categories
        <svg class="w-4 h-4 text-warm-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      {navLinks.map(link => (
        <a
          href={link.href}
          class="flex items-center font-body text-warm-600 hover:text-warm-950 hover:bg-warm-50 py-2.5 px-3 rounded-xl transition-colors text-sm font-medium"
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="px-4 pb-3 border-t border-warm-100 pt-3">
      <p class="text-warm-400 text-xs font-body px-3 mb-2 uppercase tracking-wider font-semibold">Quick browse</p>
      <div class="flex flex-wrap gap-1.5 px-1">
        {categories.map(cat => (
          <a
            href={`/categories/${cat.slug}`}
            class="font-body text-xs text-warm-600 hover:text-warm-950 bg-warm-100 hover:bg-warm-200 px-3 py-1.5 rounded-full transition-colors"
          >
            {cat.label}
          </a>
        ))}
      </div>
    </div>
    <div class="px-4 pb-4 pt-2">
      <a
        href="/categories"
        class="block w-full text-center bg-forest-600 hover:bg-forest-700 text-white font-body font-semibold text-sm px-4 py-3 rounded-full transition-colors"
      >
        Find Your Stay
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const iconO  = document.getElementById('icon-open');
  const iconC  = document.getElementById('icon-close');
  toggle?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    iconO?.classList.toggle('hidden', !hidden);
    iconC?.classList.toggle('hidden', hidden);
  });
</script>
