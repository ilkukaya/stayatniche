---
import CategoryIcon from './CategoryIcon.astro';
import { getCollection } from 'astro:content';
import { isLive } from '../lib/site';
import { ownPhoto } from '../lib/images';

const hotels = await getCollection('hotels', isLive);
const count = (slug: string) => hotels.filter(h => h.data.category === slug).length;
const cats = (await getCollection('categories'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map(c => ({ slug: c.slug, label: c.data.title, n: count(c.slug), img: ownPhoto(c.data.coverImage, c.slug), tagline: c.data.tagline ?? '' }));

const navLinks = [
  { href: '/hotels/', label: 'Explore' },
  { href: '/countries/', label: 'Countries' },
  { href: '/destinations/', label: 'Destinations' },
  { href: '/blog/', label: 'Guides' },
];
const path = Astro.url.pathname;
const on = (h: string) => path === h || path.startsWith(h);
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-warm-200 bg-warm-50/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex-shrink-0 font-display text-[26px] leading-none text-warm-950" aria-label="StayAtNiche home">
      StayAt<span class="italic text-gold-600">Niche</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      <div class="relative" data-dropdown>
        <button type="button" aria-haspopup="menu" aria-expanded="false" data-dropdown-toggle
          class:list={['flex items-center gap-1 rounded-full px-3.5 py-2 font-body text-[14px] font-medium transition-colors', on('/categories') ? 'bg-warm-200/70 text-warm-950' : 'text-warm-700 hover:text-warm-950']}>
          Stays
          <svg class="h-3.5 w-3.5 transition-transform duration-200" data-dropdown-chevron fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div role="menu" data-dropdown-panel class="pointer-events-none invisible absolute left-0 top-full w-[760px] translate-y-1 pt-3 opacity-0 transition-all duration-200">
          <div class="rounded-2xl border border-warm-200 bg-white p-3 shadow-card-hover">
            <div class="grid grid-cols-2 gap-1">
              {cats.map(c => (
                <a href={`/categories/${c.slug}/`} role="menuitem" class="group/i flex items-center gap-3 rounded-xl p-2 transition-colors hover:bg-warm-100">
                  <span class="h-12 w-16 flex-shrink-0 overflow-hidden rounded-lg bg-warm-100">
                    {c.img ? <img src={c.img} alt="" class="h-full w-full object-cover transition duration-500 group-hover/i:scale-110" loading="lazy" width="128" height="96" /> : <span class="grid h-full w-full place-items-center text-forest-700"><CategoryIcon slug={c.slug} size={18} /></span>}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-body text-sm font-semibold text-warm-950">{c.label}</span>
                    <span class="block truncate font-body text-xs text-warm-500">{c.tagline}</span>
                  </span>
                  <span class="rounded-full bg-warm-100 px-2 py-0.5 font-body text-xs tabular-nums text-warm-600 group-hover/i:bg-white">{c.n}</span>
                </a>
              ))}
            </div>
            <a href="/categories/" class="mt-2 flex items-center justify-between rounded-xl bg-warm-950 px-4 py-3 font-body text-sm font-semibold text-white hover:bg-warm-800">Browse all kinds of stay <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
      {navLinks.map(l => (
        <a href={l.href} class:list={['rounded-full px-3.5 py-2 font-body text-[14px] font-medium transition-colors', on(l.href) ? 'bg-warm-200/70 text-warm-950' : 'text-warm-700 hover:text-warm-950']}>{l.label}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <a href="/search/" class="hidden items-center gap-2 rounded-full border border-warm-300 bg-white py-2 pl-3.5 pr-4 font-body text-sm text-warm-500 transition hover:border-warm-500 lg:flex">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/></svg>
        Search stays &amp; places
      </a>
      <a href="/search/" aria-label="Search" class="rounded-full p-2.5 text-warm-800 hover:bg-warm-200/60 lg:hidden"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/></svg></a>
      <a href="/saved/" aria-label="Saved stays" class="relative hidden rounded-full p-2.5 text-warm-800 hover:bg-warm-200/60 md:block">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3 5.5 6.2 5.5c1.9 0 3.2 1 3.8 2 .6-1 1.9-2 3.8-2 3.2 0 5 3.1 3.7 6.3C19.5 16.4 12 21 12 21Z"/></svg>
        <span data-saved-count class="absolute right-0.5 top-0.5 hidden h-4 min-w-4 rounded-full bg-gold-500 px-1 text-center font-body text-[10px] font-semibold leading-4 text-white"></span>
      </a>
      <button id="mobile-menu-toggle" aria-label="Menu" aria-controls="mobile-menu" class="rounded-full p-2.5 text-warm-800 hover:bg-warm-200/60 md:hidden">
        <svg class="h-5 w-5" id="icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="hidden h-5 w-5" id="icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden max-h-[80vh] overflow-y-auto border-t border-warm-200 bg-warm-50 md:hidden">
    <nav class="px-4 py-4" aria-label="Mobile">
      {[...navLinks, { href: '/about/', label: 'About' }].map(l => (
        <a href={l.href} class="flex items-center justify-between border-b border-warm-200 py-3.5 font-display text-2xl text-warm-950">{l.label}<span class="font-body text-base text-warm-400" aria-hidden="true">→</span></a>
      ))}
      <p class="eyebrow mt-6 mb-3 text-warm-500">Kinds of stay</p>
      <div class="grid grid-cols-2 gap-2">
        {cats.map(c => (
          <a href={`/categories/${c.slug}/`} class="flex items-center gap-2.5 rounded-xl border border-warm-200 bg-white p-1.5 pr-3 font-body text-sm font-medium text-warm-800">{c.img ? <img src={c.img} alt="" class="h-9 w-9 rounded-lg object-cover" loading="lazy" width="72" height="72" /> : <CategoryIcon slug={c.slug} size={16} class="text-forest-700" />}{c.label}</a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  // ── Mobile menu ───────────────────────────────────────────────
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const iconO  = document.getElementById('icon-open');
  const iconC  = document.getElementById('icon-close');
  toggle?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    iconO?.classList.toggle('hidden', !hidden);
    iconC?.classList.toggle('hidden', hidden);
  });

  // ── Desktop mega-dropdown ─────────────────────────────────────
  // Hover-open on fine pointers, click-to-pin/toggle on coarse. Keeps
  // the panel visible while the cursor travels the transparent bridge
  // between button and menu (pt-2 on the panel). Outside click / Escape
  // closes.
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((root) => {
    const btn    = root.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    const panel  = root.querySelector<HTMLElement>('[data-dropdown-panel]');
    const chev   = root.querySelector<SVGElement>('[data-dropdown-chevron]');
    if (!btn || !panel) return;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;
    let pinned = false;

    const open = () => {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      panel.classList.remove('opacity-0', 'invisible', 'translate-y-1', 'pointer-events-none');
      panel.classList.add('opacity-100', 'visible', 'translate-y-0');
      chev?.classList.add('rotate-180');
      btn.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      panel.classList.add('opacity-0', 'invisible', 'translate-y-1', 'pointer-events-none');
      panel.classList.remove('opacity-100', 'visible', 'translate-y-0');
      chev?.classList.remove('rotate-180');
      btn.setAttribute('aria-expanded', 'false');
      pinned = false;
    };
    const scheduleClose = () => {
      if (pinned) return;
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = setTimeout(close, 150);
    };

    // Hover intent (desktop)
    root.addEventListener('mouseenter', open);
    root.addEventListener('mouseleave', scheduleClose);

    // Click pins the menu open (works on touch and keyboard too)
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      if (pinned) { close(); }
      else { pinned = true; open(); }
    });

    // Outside click closes a pinned menu
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });

    // Escape key closes + returns focus to trigger
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        close();
        btn.focus();
      }
    });
  });
</script>
