---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/categories', label: 'Categories' },
  { href: '/destinations', label: 'Destinations' },
  { href: '/blog', label: 'Blog' },
];

const categoryStrip = [
  { href: '/categories/treehouse-hotels', label: '🌳 Treehouses' },
  { href: '/categories/cave-hotels', label: '🪨 Cave Hotels' },
  { href: '/categories/underwater-rooms', label: '🌊 Underwater' },
  { href: '/categories/castle-hotels', label: '🏰 Castles' },
  { href: '/categories/floating-hotels', label: '🛶 Floating' },
  { href: '/categories/bubble-hotels', label: '🫧 Bubble Domes' },
  { href: '/categories/cliffside-hotels', label: '⛰️ Cliffsides' },
  { href: '/categories/desert-camps', label: '🏜️ Desert Camps' },
  { href: '/categories/safari-lodges', label: '🦁 Safari Lodges' },
  { href: '/categories/overwater-bungalows', label: '🌺 Overwater' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-warm-200 shadow-soft" id="site-header">
  <!-- Main nav row -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group flex-shrink-0">
        <span class="text-gold-500 text-lg leading-none">✦</span>
        <span class="font-display text-xl font-bold text-warm-950 group-hover:text-warm-700 transition-colors">
          StayAtNiche
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-7">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'font-body text-sm font-medium transition-colors relative pb-0.5',
              currentPath === link.href
                ? 'text-warm-950 after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:rounded-full after:bg-gold-500'
                : 'text-warm-600 hover:text-warm-950',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA -->
      <a
        href="/categories"
        class="hidden md:inline-flex items-center gap-1.5 bg-forest-600 hover:bg-forest-700 text-white font-body font-semibold text-sm px-5 py-2.5 rounded-full transition-all hover:shadow-md active:scale-95"
      >
        Find Your Stay
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <button
        class="md:hidden text-warm-700 hover:text-warm-950 p-1.5 rounded-lg hover:bg-warm-100 transition-colors"
        id="mobile-menu-toggle"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" id="icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-5 h-5 hidden" id="icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Category strip (desktop only) -->
  <div class="hidden md:block border-t border-warm-100 bg-warm-50/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-0.5 overflow-x-auto scrollbar-hide py-1.5">
        {categoryStrip.map(cat => (
          <a
            href={cat.href}
            class:list={[
              'flex-shrink-0 font-body text-xs font-medium px-3 py-1.5 rounded-full transition-all whitespace-nowrap',
              currentPath === cat.href
                ? 'bg-gold-100 text-gold-700'
                : 'text-warm-600 hover:text-warm-950 hover:bg-warm-200',
            ]}
          >
            {cat.label}
          </a>
        ))}
        <a
          href="/categories"
          class="flex-shrink-0 font-body text-xs font-semibold text-forest-600 hover:text-forest-700 px-3 py-1.5 ml-2 underline underline-offset-2 whitespace-nowrap"
        >
          All categories →
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="md:hidden hidden bg-white border-t border-warm-200 shadow-lg" id="mobile-menu">
    <div class="px-4 py-3 space-y-0.5">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="flex items-center gap-2 font-body text-warm-700 hover:text-warm-950 hover:bg-warm-50 py-2.5 px-3 rounded-xl transition-colors text-sm font-medium"
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="px-4 pb-3 border-t border-warm-100 mt-1 pt-3">
      <p class="text-warm-400 text-xs font-body px-3 mb-2 uppercase tracking-wider font-medium">Browse by type</p>
      <div class="flex flex-wrap gap-1.5 px-1">
        {categoryStrip.slice(0, 6).map(cat => (
          <a
            href={cat.href}
            class="font-body text-xs text-warm-600 hover:text-warm-950 bg-warm-100 hover:bg-warm-200 px-3 py-1.5 rounded-full transition-colors"
          >
            {cat.label}
          </a>
        ))}
      </div>
    </div>
    <div class="px-4 pb-4">
      <a
        href="/categories"
        class="block w-full text-center bg-forest-600 hover:bg-forest-700 text-white font-body font-semibold text-sm px-4 py-3 rounded-full transition-colors"
      >
        Find Your Stay
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const iconO  = document.getElementById('icon-open');
  const iconC  = document.getElementById('icon-close');
  toggle?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    iconO?.classList.toggle('hidden', !hidden);
    iconC?.classList.toggle('hidden', hidden);
  });
</script>
