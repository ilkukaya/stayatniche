---
interface Props {
  title: string;
  description: string;
  icon: string;
  slug: string;
  stats: {
    hotelCount: number;
    avgPrice: number;
    topDestination: string;
  };
  featured?: boolean;
}

const { title, description, icon, slug, stats, featured } = Astro.props;
---

<a
  href={`/categories/${slug}`}
  class="group relative block bg-stone-900 rounded-2xl overflow-hidden border border-stone-800 hover:border-gold-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-gold-500/10"
>
  <!-- Image placeholder with gradient -->
  <div class="relative h-48 bg-gradient-to-br from-stone-800 to-stone-900 overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center">
      <span class="text-7xl opacity-30 group-hover:opacity-50 transition-opacity duration-300 group-hover:scale-110 transform inline-block">
        {icon}
      </span>
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-900 via-transparent to-transparent" />
    {featured && (
      <div class="absolute top-3 right-3 bg-gold-500 text-stone-950 text-xs font-body font-bold px-2 py-1 rounded-full">
        Featured
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="p-6">
    <div class="flex items-start justify-between gap-3 mb-3">
      <h3 class="font-display text-xl font-bold text-white group-hover:text-gold-400 transition-colors">
        {title}
      </h3>
      <span class="text-2xl flex-shrink-0">{icon}</span>
    </div>

    <p class="font-body text-stone-400 text-sm leading-relaxed mb-5 line-clamp-2">
      {description}
    </p>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-3 pt-4 border-t border-stone-800">
      <div class="text-center">
        <div class="font-display text-lg font-bold text-gold-400">{stats.hotelCount}</div>
        <div class="font-body text-stone-500 text-xs">Stays</div>
      </div>
      <div class="text-center">
        <div class="font-display text-lg font-bold text-gold-400">${stats.avgPrice}</div>
        <div class="font-body text-stone-500 text-xs">Avg/Night</div>
      </div>
      <div class="text-center">
        <div class="font-display text-sm font-bold text-gold-400 leading-tight">{stats.topDestination.split(',')[0]}</div>
        <div class="font-body text-stone-500 text-xs">Top Dest.</div>
      </div>
    </div>

    <!-- Arrow -->
    <div class="flex items-center gap-1 mt-4 text-gold-400 text-sm font-body font-medium group-hover:gap-2 transition-all">
      <span>Explore stays</span>
      <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </div>
</a>
