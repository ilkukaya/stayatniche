---
interface Props {
  title: string;
  description: string;
  icon?: string;
  coverImage?: string;
  slug: string;
  stats: {
    hotelCount: number;
    avgPrice: number;
    topDestination: string;
  };
  featured?: boolean;
}

const { title, description, icon, coverImage, slug, stats, featured } = Astro.props;

// Fallback colors per category when no image
const fallbacks: Record<string, { from: string; to: string }> = {
  'treehouse-hotels':    { from: 'from-forest-100',  to: 'to-forest-200' },
  'cave-hotels':         { from: 'from-warm-200',    to: 'to-warm-300' },
  'underwater-rooms':    { from: 'from-sky-100',     to: 'to-sky-200' },
  'castle-hotels':       { from: 'from-purple-100',  to: 'to-purple-200' },
  'floating-hotels':     { from: 'from-teal-100',    to: 'to-teal-200' },
  'bubble-hotels':       { from: 'from-pink-100',    to: 'to-pink-200' },
  'cliffside-hotels':    { from: 'from-orange-100',  to: 'to-orange-200' },
  'desert-camps':        { from: 'from-amber-100',   to: 'to-amber-200' },
  'jungle-lodges':       { from: 'from-green-100',   to: 'to-green-200' },
  'ice-hotels':          { from: 'from-blue-100',    to: 'to-blue-200' },
  'safari-lodges':       { from: 'from-yellow-100',  to: 'to-yellow-200' },
  'overwater-bungalows': { from: 'from-rose-100',    to: 'to-rose-200' },
};
const fb = fallbacks[slug] || { from: 'from-warm-100', to: 'to-warm-200' };
---

<a
  href={`/categories/${slug}`}
  class="group block bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 border border-warm-100"
>
  <!-- Image area -->
  <div class="relative h-48 overflow-hidden">
    {coverImage ? (
      <img
        src={coverImage}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class:list={['w-full h-full bg-gradient-to-br flex items-center justify-center', fb.from, fb.to]}>
        {icon && <span class="text-6xl opacity-40 select-none">{icon}</span>}
      </div>
    )}

    <!-- Gradient fade into card content -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent" />

    <!-- Title overlaid on image bottom -->
    <div class="absolute bottom-0 inset-x-0 p-4">
      <h3 class="font-display text-xl font-bold text-white leading-tight drop-shadow-sm">
        {title}
      </h3>
    </div>

    {featured && (
      <div class="absolute top-3 left-3 bg-gold-500 text-white text-xs font-body font-bold px-3 py-1 rounded-full shadow-sm">
        Editor's Pick
      </div>
    )}

    <div class="absolute top-3 right-3 bg-white/80 backdrop-blur-sm rounded-full px-2.5 py-1 text-xs font-body font-semibold text-warm-800 shadow-sm">
      {stats.hotelCount} stays
    </div>
  </div>

  <!-- Card content -->
  <div class="px-5 pb-5 pt-4">
    <p class="font-body text-warm-600 text-sm leading-relaxed mb-4 line-clamp-2">
      {description}
    </p>

    <!-- Stats row -->
    <div class="grid grid-cols-3 gap-2 py-3 border-t border-b border-warm-100 mb-4">
      <div class="text-center">
        <div class="font-display text-base font-bold text-warm-900">{stats.hotelCount}</div>
        <div class="font-body text-warm-400 text-xs">Stays</div>
      </div>
      <div class="text-center border-x border-warm-100">
        <div class="font-display text-base font-bold text-warm-900">${stats.avgPrice}</div>
        <div class="font-body text-warm-400 text-xs">Avg/Night</div>
      </div>
      <div class="text-center">
        <div class="font-display text-sm font-bold text-warm-900 leading-tight truncate">{stats.topDestination.split(',')[0]}</div>
        <div class="font-body text-warm-400 text-xs">Top Dest.</div>
      </div>
    </div>

    <!-- CTA -->
    <div class="flex items-center justify-between">
      <span class="font-body text-sm font-semibold text-forest-600 group-hover:text-forest-700 flex items-center gap-1 transition-colors">
        Explore stays
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
      <span class="font-body text-xs text-warm-400">{stats.topDestination.split(',')[0]}</span>
    </div>
  </div>
</a>
