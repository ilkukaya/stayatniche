---
import CategoryIcon from './CategoryIcon.astro';
import { resolveImage, sizedImage } from '../lib/images';

interface Props {
  title: string;
  description: string;
  icon?: string;
  coverImage?: string;
  slug: string;
  stats: {
    hotelCount: number;
    avgPrice: number;
    topDestination: string;
  };
  featured?: boolean;
}

const { title, description, coverImage, slug, stats, featured } = Astro.props;

const imageUrl   = resolveImage(coverImage, { category: slug });
const srcMobile  = sizedImage(imageUrl, 600);
const srcDesktop = sizedImage(imageUrl, 900);
const topDest    = stats.topDestination.split(',')[0];
---

<a
  href={`/categories/${slug}`}
  class="group block bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 border border-warm-100 focus-visible:ring-2 focus-visible:ring-forest-500 focus-visible:ring-offset-2"
>
  <!-- Image area -->
  <div class="relative h-48 overflow-hidden bg-warm-100">
    <img
      src={srcMobile}
      srcset={`${srcMobile} 600w, ${srcDesktop} 900w`}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      alt={`${title} — ${topDest}`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
      decoding="async"
      width="600"
      height="400"
    />

    <!-- Readability gradient -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/10 to-transparent" />

    <!-- Category icon chip (top-left) -->
    <div class="absolute top-3 left-3 flex items-center gap-1.5 bg-white/90 backdrop-blur-sm text-warm-900 rounded-full px-3 py-1 shadow-sm">
      <CategoryIcon slug={slug} size={14} class="text-forest-600" />
      <span class="font-body text-xs font-semibold">{stats.hotelCount} stays</span>
    </div>

    <!-- Title overlaid on image bottom -->
    <div class="absolute bottom-0 inset-x-0 p-4">
      <h3 class="font-display text-xl font-bold text-white leading-tight drop-shadow-sm">
        {title}
      </h3>
    </div>

    {featured && (
      <div class="absolute top-3 right-3 bg-gold-500 text-white text-[10px] font-body font-bold uppercase tracking-widest px-2.5 py-1 rounded-full shadow-sm">
        Editor's Pick
      </div>
    )}
  </div>

  <!-- Card content -->
  <div class="px-5 pb-5 pt-4">
    <p class="font-body text-warm-600 text-sm leading-relaxed mb-4 line-clamp-2">
      {description}
    </p>

    <!-- Stats row -->
    <div class="grid grid-cols-3 gap-2 py-3 border-t border-b border-warm-100 mb-4">
      <div class="text-center">
        <div class="font-display text-base font-bold text-warm-900">{stats.hotelCount}</div>
        <div class="font-body text-warm-400 text-xs">Stays</div>
      </div>
      <div class="text-center border-x border-warm-100">
        <div class="font-display text-base font-bold text-warm-900">${stats.avgPrice}</div>
        <div class="font-body text-warm-400 text-xs">From / night</div>
      </div>
      <div class="text-center">
        <div class="font-display text-sm font-bold text-warm-900 leading-tight truncate">{topDest}</div>
        <div class="font-body text-warm-400 text-xs">Top spot</div>
      </div>
    </div>

    <!-- CTA -->
    <div class="flex items-center justify-between">
      <span class="font-body text-sm font-semibold text-forest-600 group-hover:text-forest-700 flex items-center gap-1 transition-colors">
        See the stays
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </div>
</a>
