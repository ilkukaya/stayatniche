---
/**
 * TravelServicesBox — Essential travel services widget.
 * Used in hotel page sidebar or page bottom.
 * Integrates: Airalo, Yesim, Saily, Drimsim (eSIM), EKTA (insurance),
 *             Radical Storage (luggage), NordVPN (VPN),
 *             AirHelp, Compensair (flight compensation)
 */

interface Props {
  destination: string;
  country: string;
}

const { destination, country } = Astro.props;

const marker = '478307';
const destEnc = encodeURIComponent(destination);

function tpLink(programId: string, targetUrl: string): string {
  return `https://tp.media/r?marker=${marker}&p=${programId}&u=${encodeURIComponent(targetUrl)}`;
}

// eSIM — prioritise by region (Southeast/South Asia, Africa: eSIM extra important)
const esimPriorityCountries = [
  'Indonesia', 'Thailand', 'Vietnam', 'Cambodia', 'Laos', 'Myanmar',
  'Philippines', 'Sri Lanka', 'India', 'Nepal', 'Bangladesh',
  'Kenya', 'Tanzania', 'Morocco', 'Egypt', 'Ethiopia',
  'Japan', 'South Korea', 'Taiwan', 'China',
];
const esimFirst = esimPriorityCountries.includes(country);

// Affiliate links
const airaloUrl = tpLink('6445', 'https://www.airalo.com');
const yesimUrl = tpLink('6781', 'https://yesim.app');
const sailyUrl = tpLink('7102', 'https://saily.com');
const drimsimUrl = tpLink('5823', 'https://drimsim.com');

const ektaUrl = tpLink('5784', 'https://ekta.travel');
const nordvpnUrl = tpLink('5847', 'https://nordvpn.com');
const radicalStorageUrl = tpLink('6203', `https://radicalstorage.com/?city=${destEnc}`);
const airhelpUrl = tpLink('4044', 'https://www.airhelp.com');
const compensairUrl = tpLink('5952', 'https://compensair.com');
---

<div class="bg-white rounded-2xl border border-warm-200 shadow-card p-6">
  <h3 class="font-display text-lg font-bold text-warm-950 mb-1">Travel Essentials</h3>
  <p class="font-body text-warm-400 text-xs mb-5">Services to make your trip smoother</p>

  <div class="space-y-5">

    {/* ── eSIM & Connectivity ── */}
    <div class:list={[esimFirst ? 'order-first' : '']}>
      <p class="font-body text-[10px] font-bold uppercase tracking-wider text-warm-400 mb-2">📱 eSIM & Mobile Data</p>
      <div class="space-y-2">
        <a
          href={airaloUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="flex items-center justify-between w-full bg-[#6748FF] hover:bg-[#5538e8] text-white font-body font-semibold text-sm px-4 py-3 rounded-xl transition-all group"
        >
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-white/80" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/>
            </svg>
            <div>
              <div class="font-semibold text-sm">Airalo</div>
              <div class="text-white/60 text-xs">eSIM for 200+ countries</div>
            </div>
          </div>
          <svg class="w-4 h-4 text-white/60 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <div class="grid grid-cols-3 gap-2">
          <a
            href={yesimUrl}
            target="_blank"
            rel="noopener noreferrer nofollow sponsored"
            class="flex flex-col items-center gap-1 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-700 font-body font-semibold text-xs px-2 py-2.5 rounded-xl transition-all text-center"
          >
            <svg class="w-3.5 h-3.5 text-warm-400" fill="currentColor" viewBox="0 0 24 24"><path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99z"/></svg>
            Yesim
          </a>
          <a
            href={sailyUrl}
            target="_blank"
            rel="noopener noreferrer nofollow sponsored"
            class="flex flex-col items-center gap-1 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-700 font-body font-semibold text-xs px-2 py-2.5 rounded-xl transition-all text-center"
          >
            <svg class="w-3.5 h-3.5 text-warm-400" fill="currentColor" viewBox="0 0 24 24"><path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99z"/></svg>
            Saily
          </a>
          <a
            href={drimsimUrl}
            target="_blank"
            rel="noopener noreferrer nofollow sponsored"
            class="flex flex-col items-center gap-1 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-700 font-body font-semibold text-xs px-2 py-2.5 rounded-xl transition-all text-center"
          >
            <svg class="w-3.5 h-3.5 text-warm-400" fill="currentColor" viewBox="0 0 24 24"><path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99z"/></svg>
            Drimsim
          </a>
        </div>
      </div>
    </div>

    {/* ── Travel Insurance ── */}
    <div>
      <p class="font-body text-[10px] font-bold uppercase tracking-wider text-warm-400 mb-2">🛡 Travel Insurance</p>
      <a
        href={ektaUrl}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
        class="flex items-center justify-between w-full bg-[#059669] hover:bg-[#047857] text-white font-body font-semibold text-sm px-4 py-3 rounded-xl transition-all group"
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-white/80" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
          </svg>
          <div>
            <div class="font-semibold text-sm">EKTA Travel Insurance</div>
            <div class="text-white/60 text-xs">Medical, cancellation & more</div>
          </div>
        </div>
        <svg class="w-4 h-4 text-white/60 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    {/* ── Luggage Storage ── */}
    <div>
      <p class="font-body text-[10px] font-bold uppercase tracking-wider text-warm-400 mb-2">🧳 Luggage Storage</p>
      <a
        href={radicalStorageUrl}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
        class="flex items-center justify-between w-full border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body font-semibold text-sm px-4 py-3 rounded-xl transition-all group"
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-warm-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20 6h-2.18c.07-.44.18-.86.18-1.3C18 2.12 15.89 0 13.3 0c-1.3 0-2.49.52-3.3 1.44C8.85.15 7.28 0 6 0 3.79 0 2 1.79 2 4c0 .44.1.86.18 1.3H0v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zM9.5 2.3c.5-.19 1.03-.3 1.5-.3C12.88 2 14 3.12 14 4.5c0 .48-.14.93-.38 1.5H9.18C9.06 5.5 9 5 9 4.5c0-.86.19-1.67.5-2.2z"/>
          </svg>
          <div>
            <div class="font-semibold text-sm">Radical Storage</div>
            <div class="text-warm-400 text-xs">Store bags near {destination}</div>
          </div>
        </div>
        <svg class="w-4 h-4 text-warm-400 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    {/* ── VPN ── */}
    <div>
      <p class="font-body text-[10px] font-bold uppercase tracking-wider text-warm-400 mb-2">🔒 Online Security</p>
      <a
        href={nordvpnUrl}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
        class="flex items-center justify-between w-full bg-[#4687FF] hover:bg-[#3472e8] text-white font-body font-semibold text-sm px-4 py-3 rounded-xl transition-all group"
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-white/80" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
          </svg>
          <div>
            <div class="font-semibold text-sm">NordVPN</div>
            <div class="text-white/60 text-xs">Stay safe on public Wi-Fi</div>
          </div>
        </div>
        <svg class="w-4 h-4 text-white/60 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    {/* ── Flight Compensation ── */}
    <div>
      <p class="font-body text-[10px] font-bold uppercase tracking-wider text-warm-400 mb-2">✈ Flight Delayed or Cancelled?</p>
      <div class="grid grid-cols-2 gap-2">
        <a
          href={airhelpUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="flex flex-col items-start gap-1 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body text-xs px-3 py-3 rounded-xl transition-all"
        >
          <span class="font-semibold">AirHelp</span>
          <span class="text-warm-400">Claim up to €600</span>
        </a>
        <a
          href={compensairUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="flex flex-col items-start gap-1 border border-warm-200 hover:border-warm-300 bg-warm-50 hover:bg-warm-100 text-warm-800 font-body text-xs px-3 py-3 rounded-xl transition-all"
        >
          <span class="font-semibold">Compensair</span>
          <span class="text-warm-400">Free claim check</span>
        </a>
      </div>
    </div>

  </div>

  <p class="font-body text-warm-400 text-[10px] text-center pt-4 mt-1 border-t border-warm-100 leading-relaxed">
    Affiliate links — we earn a small commission at no extra cost to you.
    <a href="/disclosure" class="underline hover:text-warm-600">Learn more</a>
  </p>
</div>
