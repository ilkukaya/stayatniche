---
/** Trip services with partner logos and clear calls to action (all tracked affiliate links). */
import { tpLink } from '../lib/affiliate';
import PartnerLogo from './PartnerLogo.astro';
import { getLocale, i18n } from '../i18n';
interface Props { destination: string; country: string; subId: string; compact?: boolean }
const { destination, country, subId } = Astro.props;
const place = destination.split(',')[0].trim();
const t = (p: string, u: string) => tpLink(p, u, `essentials_${subId}`);
const L = i18n(getLocale(Astro.url));
const E = L.t.essentials;
const where = L.country(country);
// Klook is the approved partner for everything around the stay (Travelpayouts); its search
// pages work for any place name, so each item is a Klook search for this place or country.
const klook = (q: string) => t('', `https://www.klook.com/en-US/search-results/?query=${encodeURIComponent(q)}`);
const mk = (k: keyof typeof E.items, href: string) => ({ ...E.items[k], desc: E.items[k].desc(where), brand: 'Klook', logo: 'klook', href });
const groups = [
  { title: E.groups.during, items: [
    mk('tours', klook(`${place}, ${country}`)),
    mk('tickets', klook(`${place} attractions`)),
    mk('transfer', klook(`${place} airport transfer`)),
  ]},
  { title: E.groups.before, items: [
    mk('esim', klook(`${country} eSIM`)),
    mk('car', klook(`${country} car rental`)),
  ]},
];
---
<section aria-labelledby="essentials-h">
  <div class="flex flex-wrap items-end justify-between gap-2">
    <h2 id="essentials-h" class="font-display text-3xl leading-none text-warm-950">{E.title}</h2>
    <p class="font-body text-xs text-warm-500">{E.disclaimer}</p>
  </div>
  <p class="mt-2 font-body text-sm text-warm-600">{E.intro(place === country ? where : `${place}, ${where}`)}</p>
  <div class="mt-6 space-y-6 sm:space-y-7">
    {groups.map(g => (
      <div>
        <p class="eyebrow mb-3 text-warm-500">{g.title}</p>
        <ul class="grid grid-cols-3 gap-2 sm:gap-3">
          {g.items.map(it => (
            <li class="h-full"><a href={it.href} target="_blank" rel="noopener noreferrer nofollow sponsored" data-partner={it.logo}
              class="group relative flex h-full flex-col rounded-2xl border border-warm-200 bg-white p-3 transition duration-200 hover:-translate-y-0.5 hover:border-warm-300 hover:shadow-card sm:p-4">
              <svg viewBox="0 0 24 24" class="absolute right-2.5 top-2.5 h-3.5 w-3.5 text-warm-400 sm:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
              <span class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-3">
                <PartnerLogo partner={it.logo} name={it.brand} size={44} class="!h-10 !w-10 sm:!h-11 sm:!w-11" />
                <span class="w-full min-w-0 sm:w-auto">
                  <span class="block font-body text-[13px] font-semibold leading-tight text-warm-950 sm:text-[15px]">{it.label}</span>
                  <span class="mt-0.5 block truncate font-body text-[11px] text-warm-500 sm:text-xs">{E.with(it.brand)}</span>
                </span>
              </span>
              <span class="mt-3 hidden flex-1 font-body text-[13px] leading-snug text-warm-600 sm:block">{it.desc}</span>
              <span class="mt-4 hidden items-center justify-between gap-2 rounded-xl bg-forest-50 px-3.5 py-2.5 font-body text-sm font-semibold text-forest-800 transition group-hover:bg-forest-700 group-hover:text-white sm:inline-flex">
                {it.cta}
                <svg viewBox="0 0 24 24" class="h-4 w-4 flex-shrink-0 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
