---
/** Shared template for programmatic "unusual hotels in X" pages: comparison table + cards + FAQ + schema. */
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from './HotelCard.astro';
import Faq from './Faq.astro';
import AdSlot from './AdSlot.astro';
import { withTracking } from '../lib/affiliate';
import { SITE, startPrice } from '../lib/site';

interface Props {
  title: string;        // H1
  metaTitle: string;
  metaDescription: string;
  intro: string;
  path: string;         // e.g. /countries/norway/
  hotels: any[];        // collection entries
  crumbs: { name: string; url: string }[];
  faq: { q: string; a: string }[];
  searchPlace: string;  // for the Expedia CTA
  related?: { label: string; url: string }[];
}
const { title, metaTitle, metaDescription, intro, path, hotels, crumbs, faq, searchPlace, related = [] } = Astro.props;

const sorted = [...hotels].sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.rating - a.data.rating);
const label = ['', 'Budget', 'Moderate', 'Upscale', 'Luxury', 'Ultra-luxury'];
const ld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ name: 'Home', url: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE + c.url })) },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: title, numberOfItems: sorted.length, itemListElement: sorted.map((h, i) => ({ '@type': 'ListItem', position: i + 1, name: h.data.name, url: `${SITE}/hotels/${h.slug}/` })) },
];
---
<BaseLayout title={metaTitle} description={metaDescription} jsonLd={ld}>
  <section class="bg-warm-50 pt-8 pb-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap gap-1.5 font-body text-sm text-warm-500">
        <a href="/" class="hover:text-warm-800">Home</a>
        {crumbs.map((c, i) => (<><span class="text-warm-300">/</span>{i === crumbs.length - 1 ? <span class="font-medium text-warm-800">{c.name}</span> : <a href={c.url} class="hover:text-warm-800">{c.name}</a>}</>))}
      </nav>
      <h1 class="max-w-3xl font-display text-4xl font-bold leading-tight text-warm-950 sm:text-5xl">{title}</h1>
      <p class="mt-4 max-w-3xl font-body text-lg leading-relaxed text-warm-700">{intro}</p>
      <p class="mt-3 font-body text-xs text-warm-400">Editor-ranked. Some links are affiliate links; see our <a href="/disclosure" class="underline">disclosure</a>. Prices are typical nightly ranges; check live rates.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <h2 class="mb-4 font-display text-2xl font-bold text-warm-950">Compare at a glance</h2>
    <div class="overflow-x-auto rounded-2xl border border-warm-200 bg-white shadow-soft">
      <table class="w-full min-w-[820px] text-left font-body text-sm">
        <thead class="bg-warm-100 text-xs uppercase tracking-wider text-warm-600"><tr>
          <th class="px-4 py-3">Stay</th><th class="px-4 py-3">Where</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Typical price / night</th><th class="px-4 py-3">Best for</th><th class="px-4 py-3"></th>
        </tr></thead>
        <tbody class="divide-y divide-warm-100">
          {sorted.map(h => (
            <tr class="hover:bg-warm-50">
              <td class="min-w-[9rem] px-4 py-3 font-display font-bold text-warm-950"><a href={`/hotels/${h.slug}/`}>{h.data.name}</a></td>
              <td class="px-4 py-3 text-warm-600">{h.data.destination}</td>
              <td class="px-4 py-3 capitalize text-warm-600">{h.data.category.replace(/-/g, ' ')}</td>
              <td class="px-4 py-3 text-warm-700">{h.data.priceRange} <span class="text-xs text-warm-400">({label[h.data.priceIndicator]})</span></td>
              <td class="px-4 py-3 text-warm-600">{h.data.bestFor.filter((x: string) => x.length <= 32).slice(0, 2).join(', ')}</td>
              <td class="px-4 py-3 text-right"><a href={withTracking(h.data.bookingUrl, { campaign: 'roundup-table', content: h.slug })} target="_blank" rel="noopener noreferrer nofollow sponsored" class="whitespace-nowrap rounded-full bg-forest-600 px-4 py-2 text-xs font-semibold text-white hover:bg-forest-700">Check rates</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-2 font-body text-xs text-warm-400 sm:hidden">Swipe the table sideways to see all columns.</p>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-6 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {sorted.map(h => (
        <HotelCard name={h.data.name} destination={h.data.destination} country={h.data.country} description={h.data.description} priceRange={h.data.priceRange} priceIndicator={h.data.priceIndicator} rating={h.data.rating} reviewCount={h.data.reviewCount} highlights={h.data.highlights} bookingUrl={h.data.bookingUrl} slug={h.slug} category={h.data.category} featured={h.data.featured} coverImage={h.data.coverImage} />
      ))}
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <AdSlot slot="category-inline" />
    <div class="my-8 rounded-2xl border border-warm-200 bg-warm-100 p-6 text-center">
      <p class="font-display text-xl font-bold text-warm-950">Want more options around {searchPlace}?</p>
      <div class="mt-4 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={withTracking(`https://www.expedia.com/Hotel-Search?destination=${encodeURIComponent(searchPlace)}&adults=2`, { campaign: 'roundup-cta', content: path })} target="_blank" rel="noopener noreferrer nofollow sponsored" class="rounded-full bg-[#00356B] px-6 py-3 font-body text-sm font-bold text-white">Compare hotels on Expedia</a>
        <a href={withTracking(`https://www.klook.com/en-US/search-results/?query=${encodeURIComponent(searchPlace)}`, { campaign: 'roundup-cta', content: path })} target="_blank" rel="noopener noreferrer nofollow sponsored" class="rounded-full bg-[#FF5722] px-6 py-3 font-body text-sm font-bold text-white">Find tours &amp; activities</a>
      </div>
    </div>
    <Faq items={faq} heading="Quick answers" />
    {related.length > 0 && (
      <div class="mb-16">
        <h2 class="mb-3 font-display text-xl font-bold text-warm-950">Keep exploring</h2>
        <div class="flex flex-wrap gap-2">{related.map(r => <a href={r.url} class="rounded-full border border-warm-200 bg-white px-4 py-2 font-body text-sm text-warm-700 hover:border-forest-400 hover:text-forest-700">{r.label}</a>)}</div>
      </div>
    )}
  </div>
</BaseLayout>
