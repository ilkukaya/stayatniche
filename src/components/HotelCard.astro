---
interface Props {
  name: string;
  destination: string;
  country: string;
  description: string;
  priceRange: string;
  priceIndicator: number;
  rating: number;
  reviewCount: number;
  highlights: string[];
  bookingUrl: string;
  slug: string;
  category: string;
  featured?: boolean;
}

const {
  name,
  destination,
  country,
  description,
  priceRange,
  priceIndicator,
  rating,
  reviewCount,
  highlights,
  bookingUrl,
  slug,
  category,
  featured,
} = Astro.props;

const priceSymbols = '💰'.repeat(priceIndicator);
const categoryIcons: Record<string, string> = {
  'treehouse-hotels': '🌳',
  'cave-hotels': '🏔️',
  'underwater-rooms': '🌊',
  'castle-hotels': '🏰',
  'floating-hotels': '🚢',
  'bubble-hotels': '🔮',
};
const categoryIcon = categoryIcons[category] || '✦';
---

<article class="group bg-stone-900 rounded-2xl overflow-hidden border border-stone-800 hover:border-gold-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-gold-500/10 flex flex-col">
  <!-- Image area -->
  <div class="relative h-52 bg-gradient-to-br from-stone-800 to-stone-900 flex-shrink-0 overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center">
      <span class="text-8xl opacity-20 group-hover:opacity-30 transition-opacity group-hover:scale-110 transform inline-block duration-300">
        {categoryIcon}
      </span>
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-900 via-transparent to-transparent" />
    {featured && (
      <div class="absolute top-3 left-3 bg-gold-500 text-stone-950 text-xs font-body font-bold px-2 py-1 rounded-full">
        Featured
      </div>
    )}
    <!-- Rating badge -->
    <div class="absolute top-3 right-3 bg-stone-950/80 backdrop-blur-sm text-gold-400 text-sm font-display font-bold px-2 py-1 rounded-lg flex items-center gap-1">
      <svg class="w-3.5 h-3.5 text-gold-400 fill-current" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
      {rating}
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-1">
    <div class="flex-1">
      <!-- Location -->
      <div class="flex items-center gap-1 text-stone-500 text-xs font-body mb-2">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{destination}, {country}</span>
      </div>

      <h3 class="font-display text-xl font-bold text-white group-hover:text-gold-400 transition-colors mb-2">
        <a href={`/hotels/${slug}`}>{name}</a>
      </h3>

      <p class="font-body text-stone-400 text-sm leading-relaxed mb-4 line-clamp-2">
        {description}
      </p>

      <!-- Highlights -->
      {highlights.slice(0, 2).map(h => (
        <div class="flex items-center gap-2 text-stone-400 text-xs font-body mb-1">
          <span class="text-gold-500">✓</span>
          <span>{h}</span>
        </div>
      ))}
    </div>

    <!-- Footer -->
    <div class="mt-5 pt-4 border-t border-stone-800 flex items-center justify-between gap-3">
      <div>
        <div class="font-body text-stone-400 text-xs">From</div>
        <div class="font-display text-white font-bold">{priceRange.split(' - ')[0]}</div>
        <div class="font-body text-stone-500 text-xs">per night</div>
      </div>
      <div class="flex flex-col gap-2 items-end">
        <a
          href={`/hotels/${slug}`}
          class="font-body text-sm text-stone-300 hover:text-gold-400 transition-colors underline underline-offset-2"
        >
          View details
        </a>
        <a
          href={bookingUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="bg-gold-500 hover:bg-gold-400 text-stone-950 font-body font-semibold text-sm px-4 py-2 rounded-full transition-colors whitespace-nowrap"
        >
          Check Rates
        </a>
      </div>
    </div>
  </div>
</article>
