---
import { resolveImage, sizedImage, fallbackImage } from '../lib/images';
import { withTracking, AFFILIATE_REL } from '../lib/affiliate';
import { startPrice } from '../lib/site';

interface Props {
  name: string;
  destination: string;
  country: string;
  description: string;
  priceRange: string;
  priceIndicator: number;
  rating: number;
  reviewCount?: number;
  highlights: string[];
  bookingUrl: string;
  slug: string;
  category: string;
  featured?: boolean;
  coverImage?: string;
  class?: string;
}

const {
  name, destination, country, priceRange, priceIndicator, rating, highlights,
  bookingUrl, slug, category, featured, coverImage, class: cls = '',
} = Astro.props;

const from = startPrice(priceRange);
const categoryLabel = category?.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()) ?? 'Unique stay';
const img = resolveImage(coverImage, { category, slug });
const bookUrl = withTracking(bookingUrl, { campaign: 'hotel-card', content: slug });
---

<article
  class:list={['hotel-card group relative flex flex-col', cls]}
  data-hotel
  data-slug={slug}
  data-name={name.toLowerCase()}
  data-place={`${destination} ${country}`.toLowerCase()}
  data-cat={category}
  data-price={from}
  data-rating={rating}
  data-featured={featured ? 1 : 0}
>
  <div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-warm-100 ring-1 ring-black/5">
    <img
      src={sizedImage(img, 800)}
      data-fb-src={fallbackImage({ category })}
      alt={`${name}, ${destination}`}
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
      loading="lazy"
      decoding="async"
      width="800"
      height="600"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-black/10"></div>

    {featured && (
      <span class="absolute left-3 top-3 rounded-full bg-white/95 px-2.5 py-1 font-body text-[11px] font-bold uppercase tracking-wider text-warm-900 shadow-sm">Editor's pick</span>
    )}

    <button
      type="button"
      data-save={slug}
      aria-pressed="false"
      aria-label={`Save ${name}`}
      class="save-btn absolute right-3 top-3 z-20 grid h-9 w-9 place-items-center rounded-full bg-white/90 text-warm-700 shadow-sm backdrop-blur transition hover:scale-110 hover:bg-white"
    >
      <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3 5.5 6.2 5.5c1.9 0 3.2 1 3.8 2 .6-1 1.9-2 3.8-2 3.2 0 5 3.1 3.7 6.3C19.5 16.4 12 21 12 21Z"/></svg>
    </button>

    <span class="absolute bottom-3 left-3 rounded-full bg-black/55 px-2.5 py-1 font-body text-[11px] font-semibold capitalize text-white backdrop-blur">{categoryLabel}</span>
  </div>

  <div class="pt-3">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-[17px] font-bold leading-snug text-warm-950">
        <a href={`/hotels/${slug}/`} class="after:absolute after:inset-0 after:z-10 after:content-['']">{name}</a>
      </h3>
      {rating != null && (
        <span class="flex flex-shrink-0 items-center gap-1 font-body text-sm font-semibold text-warm-900">
          <svg class="h-3.5 w-3.5 text-gold-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1l2.6 5.9 6.4.6-4.9 4.3 1.5 6.2L10 15l-5.6 2.9 1.5-6.2L1 7.5l6.4-.6L10 1z"/></svg>
          {rating.toFixed(1)}
        </span>
      )}
    </div>
    <p class="mt-0.5 truncate font-body text-sm text-warm-500">{destination}, {country}</p>
    {highlights?.[0] && <p class="mt-0.5 line-clamp-1 font-body text-sm text-warm-500">{highlights[0]}</p>}
    <div class="mt-2 flex items-center justify-between gap-2">
      <p class="font-body text-sm text-warm-600"><span class="font-display text-base font-bold text-warm-950">{from ? `$${from.toLocaleString('en-US')}` : 'See rates'}</span>{from ? <span> / night</span> : null}</p>
      {bookUrl && (
        <a href={bookUrl} target="_blank" rel={AFFILIATE_REL} class="relative z-20 rounded-full border border-warm-300 px-3 py-1.5 font-body text-xs font-semibold text-warm-800 transition hover:border-forest-600 hover:bg-forest-600 hover:text-white">Check rates</a>
      )}
    </div>
  </div>
</article>
