---
interface Props {
  name: string;
  destination: string;
  country: string;
  description: string;
  priceRange: string;
  priceIndicator: number;
  rating: number;
  reviewCount: number;
  highlights: string[];
  bookingUrl: string;
  slug: string;
  category: string;
  featured?: boolean;
  coverImage?: string;
}

const {
  name, destination, country, description,
  priceRange, priceIndicator, rating, reviewCount,
  highlights, bookingUrl, slug, category, featured, coverImage,
} = Astro.props;

const startingPrice = priceRange ? priceRange.split(/\s[-–]\s/)[0].replace('$', '').trim() : '—';

const categoryMeta: Record<string, { color: string; bg: string; fallback: string }> = {
  'treehouse-hotels':    { color: 'text-forest-700', bg: 'bg-forest-50',  fallback: 'from-forest-100 to-forest-200' },
  'cave-hotels':         { color: 'text-warm-700',   bg: 'bg-warm-100',   fallback: 'from-warm-200 to-warm-300' },
  'underwater-rooms':    { color: 'text-sky-700',    bg: 'bg-sky-50',     fallback: 'from-sky-100 to-sky-200' },
  'castle-hotels':       { color: 'text-purple-700', bg: 'bg-purple-50',  fallback: 'from-purple-100 to-purple-200' },
  'floating-hotels':     { color: 'text-teal-700',   bg: 'bg-teal-50',    fallback: 'from-teal-100 to-teal-200' },
  'bubble-hotels':       { color: 'text-pink-700',   bg: 'bg-pink-50',    fallback: 'from-pink-100 to-pink-200' },
  'cliffside-hotels':    { color: 'text-orange-700', bg: 'bg-orange-50',  fallback: 'from-orange-100 to-orange-200' },
  'desert-camps':        { color: 'text-amber-700',  bg: 'bg-amber-50',   fallback: 'from-amber-100 to-amber-200' },
  'jungle-lodges':       { color: 'text-green-700',  bg: 'bg-green-50',   fallback: 'from-green-100 to-green-200' },
  'ice-hotels':          { color: 'text-blue-700',   bg: 'bg-blue-50',    fallback: 'from-blue-100 to-blue-200' },
  'safari-lodges':       { color: 'text-yellow-700', bg: 'bg-yellow-50',  fallback: 'from-yellow-100 to-yellow-200' },
  'overwater-bungalows': { color: 'text-rose-700',   bg: 'bg-rose-50',    fallback: 'from-rose-100 to-rose-200' },
  'lighthouse-hotels':   { color: 'text-sky-700',    bg: 'bg-sky-50',     fallback: 'from-sky-100 to-sky-200' },
  'train-hotels':        { color: 'text-violet-700', bg: 'bg-violet-50',  fallback: 'from-violet-100 to-violet-200' },
};
const meta = categoryMeta[category] || { color: 'text-gold-700', bg: 'bg-gold-50', fallback: 'from-warm-100 to-warm-200' };
const ratingDisplay = rating?.toFixed(1) ?? '—';
const categoryLabel = category?.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) ?? 'Unique Stay';
---

<article class="group bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 flex flex-col border border-warm-100">

  <!-- Image -->
  <a href={`/hotels/${slug}`} class="block relative h-52 overflow-hidden flex-shrink-0">
    {coverImage ? (
      <img src={coverImage} alt={name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
    ) : (
      <div class:list={['absolute inset-0 bg-gradient-to-br', meta.fallback]} />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-warm-950/30 via-transparent to-transparent" />
    {featured && (
      <div class="absolute top-3 left-3 flex items-center gap-1 bg-gold-500 text-white text-xs font-body font-semibold px-2.5 py-1 rounded-full shadow-sm">
        ✦ Featured
      </div>
    )}
    {rating && (
      <div class="absolute top-3 right-3 flex items-center gap-1 bg-white/90 backdrop-blur-sm text-warm-900 text-sm font-body font-bold px-2.5 py-1 rounded-full shadow-sm">
        <svg class="w-3.5 h-3.5 text-gold-500 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        {ratingDisplay}
      </div>
    )}
  </a>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-center justify-between mb-3">
      <span class:list={['text-xs font-body font-semibold px-2.5 py-1 rounded-full', meta.color, meta.bg]}>
        {categoryLabel}
      </span>
      <span class="text-xs font-body text-warm-500 flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        {destination}
      </span>
    </div>

    <h3 class="font-display text-lg font-bold text-warm-950 group-hover:text-forest-700 transition-colors mb-2 leading-snug">
      <a href={`/hotels/${slug}`}>{name}</a>
    </h3>
    <p class="font-body text-warm-600 text-sm leading-relaxed mb-3 line-clamp-2 flex-1">{description}</p>

    {highlights?.[0] && (
      <div class="flex items-start gap-1.5 text-xs font-body text-warm-600 mb-1">
        <span class="text-forest-500 font-bold mt-0.5 flex-shrink-0">✓</span>
        <span>{highlights[0]}</span>
      </div>
    )}
    {highlights?.[1] && (
      <div class="flex items-start gap-1.5 text-xs font-body text-warm-500 mb-4">
        <span class="text-forest-400 font-bold mt-0.5 flex-shrink-0">✓</span>
        <span>{highlights[1]}</span>
      </div>
    )}

    <div class="mt-auto pt-4 border-t border-warm-100 flex items-center justify-between gap-2">
      <div>
        <span class="font-body text-warm-400 text-xs">From</span>
        <div class="font-display text-xl font-bold text-warm-950">${startingPrice}</div>
        <span class="font-body text-warm-400 text-xs">/ night</span>
      </div>
      <div class="flex flex-col items-end gap-1.5">
        <a href={`/hotels/${slug}`} class="font-body text-xs text-warm-500 hover:text-warm-800 transition-colors underline underline-offset-2">Read review</a>
        {bookingUrl && (
          <a
            href={bookingUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="inline-flex items-center gap-1.5 bg-forest-600 hover:bg-forest-700 text-white font-body font-semibold text-sm px-4 py-2 rounded-full transition-all hover:shadow-md active:scale-95 whitespace-nowrap"
          >
            Check Rates
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        )}
      </div>
    </div>
  </div>
</article>
