---
import { resolveImage, sizedImage } from '../lib/images';
import { withTracking, AFFILIATE_REL } from '../lib/affiliate';

interface Props {
  name: string;
  destination: string;
  country: string;
  description: string;
  priceRange: string;
  priceIndicator: number;
  rating: number;
  reviewCount: number;
  highlights: string[];
  bookingUrl: string;
  slug: string;
  category: string;
  featured?: boolean;
  coverImage?: string;
}

const {
  name, destination, country, description,
  priceRange, rating, reviewCount,
  highlights, bookingUrl, slug, category, featured, coverImage,
} = Astro.props;

const startingPrice = priceRange ? priceRange.split(/\s[-–]\s/)[0].replace('$', '').trim() : '—';

const categoryMeta: Record<string, { color: string; bg: string }> = {
  'treehouse-hotels':    { color: 'text-forest-700', bg: 'bg-forest-50' },
  'cave-hotels':         { color: 'text-warm-700',   bg: 'bg-warm-100'  },
  'underwater-rooms':    { color: 'text-sky-700',    bg: 'bg-sky-50'    },
  'castle-hotels':       { color: 'text-purple-700', bg: 'bg-purple-50' },
  'floating-hotels':     { color: 'text-teal-700',   bg: 'bg-teal-50'   },
  'bubble-hotels':       { color: 'text-pink-700',   bg: 'bg-pink-50'   },
  'cliffside-hotels':    { color: 'text-orange-700', bg: 'bg-orange-50' },
  'desert-camps':        { color: 'text-amber-700',  bg: 'bg-amber-50'  },
  'jungle-lodges':       { color: 'text-green-700',  bg: 'bg-green-50'  },
  'ice-hotels':          { color: 'text-blue-700',   bg: 'bg-blue-50'   },
  'safari-lodges':       { color: 'text-yellow-700', bg: 'bg-yellow-50' },
  'overwater-bungalows': { color: 'text-rose-700',   bg: 'bg-rose-50'   },
  'lighthouse-hotels':   { color: 'text-sky-700',    bg: 'bg-sky-50'    },
  'train-hotels':        { color: 'text-violet-700', bg: 'bg-violet-50' },
};
const meta = categoryMeta[category] || { color: 'text-gold-700', bg: 'bg-gold-50' };
const ratingDisplay = rating?.toFixed(1) ?? '—';
const categoryLabel = category?.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) ?? 'Unique Stay';

const imageUrl  = resolveImage(coverImage, { category, slug });
const src400    = sizedImage(imageUrl, 400);
const src800    = sizedImage(imageUrl, 800);
const bookUrl   = withTracking(bookingUrl, { campaign: 'hotel-card', content: slug });
---

<article class="group bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 flex flex-col border border-warm-100">

  <!-- Image -->
  <a href={`/hotels/${slug}`} class="block relative h-52 overflow-hidden flex-shrink-0 bg-warm-100">
    <img
      src={src400}
      srcset={`${src400} 400w, ${src800} 800w`}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
      alt={`${name}, ${destination}`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
      decoding="async"
      width="400"
      height="208"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-warm-950/30 via-transparent to-transparent" />

    {featured && (
      <div class="absolute top-3 left-3 inline-flex items-center gap-1 bg-gold-500 text-white text-[11px] font-body font-bold uppercase tracking-widest px-2.5 py-1 rounded-full shadow-sm">
        <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1l2.6 5.9 6.4.6-4.9 4.3 1.5 6.2L10 15l-5.6 2.9 1.5-6.2L1 7.5l6.4-.6L10 1z"/></svg>
        Featured
      </div>
    )}

    {rating != null && (
      <div class="absolute top-3 right-3 flex items-center gap-1 bg-white/95 backdrop-blur-sm text-warm-900 text-sm font-body font-bold px-2.5 py-1 rounded-full shadow-sm">
        <svg class="w-3.5 h-3.5 text-gold-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1l2.6 5.9 6.4.6-4.9 4.3 1.5 6.2L10 15l-5.6 2.9 1.5-6.2L1 7.5l6.4-.6L10 1z"/></svg>
        {ratingDisplay}
      </div>
    )}
  </a>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class:list={['text-xs font-body font-semibold px-2.5 py-1 rounded-full', meta.color, meta.bg]}>
        {categoryLabel}
      </span>
      <span class="text-xs font-body text-warm-500 flex items-center gap-1 min-w-0">
        <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span class="truncate">{destination}</span>
      </span>
    </div>

    <h3 class="font-display text-lg font-bold text-warm-950 group-hover:text-forest-700 transition-colors mb-2 leading-snug">
      <a href={`/hotels/${slug}`}>{name}</a>
    </h3>
    <p class="font-body text-warm-600 text-sm leading-relaxed mb-3 line-clamp-2 flex-1">{description}</p>

    {highlights?.[0] && (
      <div class="flex items-start gap-1.5 text-xs font-body text-warm-600 mb-1">
        <svg class="w-3.5 h-3.5 text-forest-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
        <span>{highlights[0]}</span>
      </div>
    )}
    {highlights?.[1] && (
      <div class="flex items-start gap-1.5 text-xs font-body text-warm-500 mb-4">
        <svg class="w-3.5 h-3.5 text-forest-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
        <span>{highlights[1]}</span>
      </div>
    )}

    <div class="mt-auto pt-4 border-t border-warm-100 flex items-end justify-between gap-2">
      <div>
        <span class="font-body text-warm-400 text-xs">From</span>
        <div class="font-display text-xl font-bold text-warm-950 leading-none">${startingPrice}</div>
        <span class="font-body text-warm-400 text-xs">/ night</span>
      </div>
      <div class="flex flex-col items-end gap-1.5">
        <a href={`/hotels/${slug}`} class="font-body text-xs text-warm-500 hover:text-warm-800 transition-colors underline underline-offset-2">Read review</a>
        {bookUrl && (
          <a
            href={bookUrl}
            target="_blank"
            rel={AFFILIATE_REL}
            data-label={`${reviewCount ?? 0} reviews`}
            class="inline-flex items-center gap-1.5 bg-forest-600 hover:bg-forest-700 text-white font-body font-semibold text-sm px-4 py-2 rounded-full transition-all hover:shadow-md active:scale-95 whitespace-nowrap"
          >
            Check rates
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        )}
      </div>
    </div>
  </div>
</article>
