---
/** The "niche" mark: an arched recess with a warm light inside. */
interface Props { size?: number; class?: string; tone?: 'dark' | 'light' }
const { size = 28, class: cls = '', tone = 'dark' } = Astro.props;
const bg = tone === 'dark' ? '#133B2F' : '#FAF9F6';
const fg = tone === 'dark' ? '#FAF9F6' : '#133B2F';
---
<svg width={size} height={size} viewBox="0 0 64 64" class={cls} aria-hidden="true">
  <rect width="64" height="64" rx="14" fill={bg} />
  <path d="M20 50V28a12 12 0 0 1 24 0v22" fill="none" stroke={fg} stroke-width="4.5" stroke-linecap="round" />
  <path d="M14 50h36" stroke={fg} stroke-width="4.5" stroke-linecap="round" />
  <circle cx="32" cy="36" r="4.2" fill="#DF7A48" />
</svg>
