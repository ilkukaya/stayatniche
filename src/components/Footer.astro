---
import { getEntry } from 'astro:content';
import BrandMark from './BrandMark.astro';

const nav = (await getEntry('settings', 'navigation').catch(() => null))?.data ?? {};
const soc = (await getEntry('settings', 'social').catch(() => null))?.data ?? {};
const year = new Date().getFullYear();
const columns = (nav.footerColumns as any[]) ?? [];
const social = Object.entries(soc as Record<string, string>)
  .filter(([, u]) => typeof u === 'string' && u.startsWith('http'))
  .map(([k, u]) => ({ label: k === 'twitter' ? 'X' : k[0].toUpperCase() + k.slice(1), url: u }));
---

<footer class="mt-24 bg-warm-950 text-warm-300">
  <div class="mx-auto max-w-7xl px-4 pb-10 pt-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 border-b border-white/10 pb-12 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-3"><BrandMark size={40} tone="light" /><span class="font-display text-4xl leading-none text-white">StayAt<span class="italic text-gold-400">Niche</span></span></a>
        <p class="mt-4 max-w-md font-display text-2xl leading-snug text-warm-200">Hotels worth the trip. Treehouses, caves, rooms under the sea, and everything in between.</p>
      </div>
      <div>
        <p class="eyebrow text-warm-400">The Friday letter</p>
        <p class="mt-2 font-body text-sm text-warm-400">One unusual stay a week. No spam, unsubscribe in one click.</p>
        <form class="mt-4 flex gap-2" netlify name="footer-newsletter" method="POST" action="/newsletter-success/" data-netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="footer-newsletter" />
          <p class="hidden"><label>Leave empty: <input name="bot-field" /></label></p>
          <label for="ft-email" class="sr-only">Email address</label>
          <input id="ft-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com" class="min-w-0 flex-1 rounded-full border border-white/15 bg-white/5 px-5 py-3 font-body text-sm text-white placeholder-warm-500 outline-none focus:border-white/40" />
          <button type="submit" class="rounded-full bg-white px-5 py-3 font-body text-sm font-semibold text-warm-950 transition hover:bg-gold-100">Subscribe</button>
        </form>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-8 py-12 md:grid-cols-3">
      {columns.map((col: any) => (
        <div>
          <h3 class="eyebrow mb-4 text-warm-500">{col.title}</h3>
          <ul class="space-y-2.5">
            {col.links.map((l: any) => (
              <li><a href={l.url} class="font-body text-sm text-warm-300 transition hover:text-white">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="flex flex-col gap-4 border-t border-white/10 pt-8 font-body text-xs text-warm-500 md:flex-row md:items-center md:justify-between">
      <p>© {year} StayAtNiche. Some links are affiliate links: we may earn a commission at no extra cost to you. <a href="/disclosure/" class="underline hover:text-white">Disclosure</a> · <a href="/privacy/" class="underline hover:text-white">Privacy</a> · <a href="/photo-credits/" class="underline hover:text-white">Photo credits</a></p>
      {social.length > 0 && (
        <ul class="flex gap-4">{social.map(s => <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="hover:text-white">{s.label}</a></li>)}</ul>
      )}
    </div>
  </div>
</footer>
