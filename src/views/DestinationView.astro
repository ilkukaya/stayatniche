---
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from '../components/HotelCard.astro';
import { withTracking, AFFILIATE_REL } from '../lib/affiliate';
import { resolveImage, sizedImage } from '../lib/images';
import { SITE } from '../lib/site';
import { i18n, type Locale } from '../i18n';
import { localized, entryAlternates, type Localized } from '../i18n/content';

interface Props { locale: Locale; dest: Localized<'destinations'> }
const { dest } = Astro.props;
const L = i18n(Astro.props.locale);
const { t } = L;
const D = t.destination;
const { Content } = await dest.render();

const allHotels = await localized('hotels', L.locale);
const localHotels = allHotels.filter(h =>
  h.en.country?.toLowerCase() === dest.en.name?.toLowerCase() ||
  h.en.destination?.toLowerCase().includes(dest.en.name?.toLowerCase() ?? '')
);

const seo = dest.data.seo || {};
const metaTitle = seo.metaTitle || D.metaTitle(dest.data.name);
const metaDesc  = seo.metaDescription || dest.data.description || '';

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.common.home, "item": SITE + L.path('home') },
    { "@type": "ListItem", "position": 2, "name": t.nav.destinations, "item": SITE + L.path('destinations') },
    { "@type": "ListItem", "position": 3, "name": dest.data.name, "item": SITE + L.path('destinations', dest.slug) },
  ],
};

const destinationTypeMap: Record<string, string> = {
  country: "Country",
  city: "City",
  region: "TouristDestination",
  island: "TouristDestination",
};

const heroImage = resolveImage(dest.data.heroImage || dest.data.coverImage, {
  slug: dest.slug,
  continent: dest.data.continent,
});
const heroImageLg = sizedImage(heroImage, 1600);
const heroImageOg = sizedImage(heroImage, 1200);

const destJsonLd = {
  "@context": "https://schema.org",
  "@type": destinationTypeMap[dest.data.type] || "TouristDestination",
  "name": dest.data.name,
  "description": metaDesc,
  "url": SITE + L.path('destinations', dest.slug),
  "inLanguage": L.intl,
  "image": heroImageOg,
  ...(dest.data.coordinates ? {
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": dest.data.coordinates.lat,
      "longitude": dest.data.coordinates.lng,
    }
  } : {}),
  ...(dest.data.bestTimeToVisit ? {
    "touristType": dest.data.bestTimeToVisit.summary
  } : {}),
};
---

<BaseLayout title={metaTitle} description={metaDesc} image={heroImageOg} heroImage={heroImageLg} type="article" alternates={await entryAlternates('destinations', 'destinations', dest.slug)}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(destJsonLd)} />

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="h-72 sm:h-[460px] relative bg-warm-100">
      <img
        src={heroImageLg}
        srcset={`${sizedImage(heroImage, 1000)} 1000w, ${heroImageLg} 1600w`}
        sizes="100vw"
        alt={dest.data.name}
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-warm-950/70 via-warm-950/20 to-transparent" />
      <div class="absolute bottom-0 inset-x-0 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
        <nav class="flex items-center gap-2 text-white/70 text-sm font-body mb-4" aria-label={t.common.breadcrumb}>
          <a href={L.path('home')} class="hover:text-white transition-colors">{t.common.home}</a>
          <span>/</span>
          <a href={L.path('destinations')} class="hover:text-white transition-colors">{t.nav.destinations}</a>
          <span>/</span>
          <span class="text-white">{dest.data.name}</span>
        </nav>
        {dest.data.type && (
          <span class="inline-block bg-white/20 backdrop-blur text-white font-body text-xs font-semibold px-3 py-1 rounded-full mb-3">{t.destinations.types[dest.data.type as keyof typeof t.destinations.types]}</span>
        )}
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-white drop-shadow">{dest.data.name}</h1>
      </div>
    </div>
  </section>

  <!-- Content grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <!-- Main content -->
      <div class="lg:col-span-2">
        {dest.data.description && (
          <p class="font-body text-warm-700 text-xl leading-relaxed mb-10">{dest.data.description}</p>
        )}

        {dest.data.mustSee && dest.data.mustSee.length > 0 && (
          <div class="mb-10">
            <h2 class="font-display text-2xl font-bold text-warm-950 mb-5">{D.dontMiss}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {dest.data.mustSee.map((item: string) => (
                <div class="flex items-start gap-3 bg-white rounded-xl border border-warm-100 p-4 shadow-soft">
                  <span class="mt-2 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold-500" aria-hidden="true"></span>
                  <span class="font-body text-warm-700 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {dest.data.travelTips && dest.data.travelTips.length > 0 && (
          <div class="mb-10">
            <h2 class="font-display text-2xl font-bold text-warm-950 mb-5">{D.tips}</h2>
            {dest.data.travelTips.map((tip: string) => (
              <div class="flex items-start gap-3 mb-3">
                <svg class="w-4 h-4 text-forest-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                <span class="font-body text-warm-700 text-sm leading-relaxed">{tip}</span>
              </div>
            ))}
          </div>
        )}

        <div class="prose prose-warm max-w-none
          prose-headings:font-display prose-headings:text-warm-950
          prose-p:font-body prose-p:text-warm-700 prose-p:leading-relaxed
          prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-10 prose-h2:mb-4
          prose-strong:text-warm-900 prose-a:text-forest-600 hover:prose-a:underline">
          <Content />
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-5">
        {dest.data.bestTimeToVisit && (
          <div class="bg-white rounded-2xl border border-warm-200 shadow-card p-6">
            <h3 class="font-display text-base font-bold text-warm-950 mb-3">{D.bestTime}</h3>
            <p class="font-body text-forest-700 text-sm font-semibold mb-2">{dest.data.bestTimeToVisit.summary}</p>
            {dest.data.bestTimeToVisit.details && (
              <p class="font-body text-warm-600 text-xs leading-relaxed">{dest.data.bestTimeToVisit.details}</p>
            )}
          </div>
        )}

        {dest.data.essentials && (
          <div class="bg-white rounded-2xl border border-warm-200 shadow-card p-6">
            <h3 class="font-display text-base font-bold text-warm-950 mb-4">{D.essentials}</h3>
            <div class="space-y-3">
              {dest.data.essentials.currency && (
                <div class="flex justify-between text-sm">
                  <span class="font-body text-warm-500">{D.currency}</span>
                  <span class="font-body text-warm-800 font-medium">{dest.data.essentials.currency}</span>
                </div>
              )}
              {dest.data.essentials.language && (
                <div class="flex justify-between text-sm">
                  <span class="font-body text-warm-500">{D.language}</span>
                  <span class="font-body text-warm-800 font-medium">{dest.data.essentials.language}</span>
                </div>
              )}
              {dest.data.essentials.timezone && (
                <div class="flex justify-between text-sm">
                  <span class="font-body text-warm-500">{D.timezone}</span>
                  <span class="font-body text-warm-800 font-medium">{dest.data.essentials.timezone}</span>
                </div>
              )}
              {dest.data.essentials.plugType && (
                <div class="flex justify-between text-sm">
                  <span class="font-body text-warm-500">{D.plug}</span>
                  <span class="font-body text-warm-800 font-medium">{dest.data.essentials.plugType}</span>
                </div>
              )}
              {dest.data.essentials.visaInfo && (
                <div class="pt-2 border-t border-warm-100">
                  <p class="font-body text-warm-500 text-xs mb-1">{D.visa}</p>
                  <p class="font-body text-warm-700 text-xs leading-relaxed">{dest.data.essentials.visaInfo}</p>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- Book the trip (neutral partner list) -->
        {(() => {
          const place = encodeURIComponent(`${dest.en.name}${dest.en.country && dest.en.country !== dest.en.name ? ', ' + dest.en.country : ''}`);
          const items = [
            [t.home.partners.hotels, 'Expedia', `https://www.expedia.com/Hotel-Search?destination=${place}&adults=2`],
            [t.essentials.items.tours.label, 'Klook', `https://www.klook.com/en-US/search-results/?query=${place}`],
            [t.essentials.items.tickets.label, 'Tiqets', `https://tiqets.com/en/search/?q=${place}`],
            [t.essentials.items.flights.label, 'Kiwi.com', `https://www.kiwi.com/en/search/results/anywhere/${place}/anytime/anytime`],
          ];
          return (
            <div class="rounded-2xl border border-warm-200 bg-white p-5">
              <p class="eyebrow text-warm-500">{D.bookTrip}</p>
              <ul class="mt-2 divide-y divide-warm-200">
                {items.map(([label, brand, url]) => (
                  <li><a href={withTracking(url, { campaign: 'destination', content: dest.slug })} target="_blank" rel={AFFILIATE_REL} class="group flex items-center justify-between py-3">
                    <span><span class="block font-body text-sm font-semibold text-warm-950">{label}</span><span class="block font-body text-xs text-warm-500">{brand}</span></span>
                    <span class="text-warm-400 group-hover:text-warm-950" aria-hidden="true">↗</span>
                  </a></li>
                ))}
              </ul>
              <p class="mt-2 font-body text-[11px] text-warm-400">{D.affiliate}</p>
            </div>
          );
        })()}

        <!-- Browse stays CTA -->
        <div class="bg-forest-50 border border-forest-100 rounded-2xl p-5">
          <h3 class="font-display text-base font-bold text-warm-950 mb-2">{D.placesToSleep}</h3>
          <p class="font-body text-warm-600 text-sm mb-3">{D.handPicked(dest.data.name)}</p>
          <a href={L.path('categories')} class="block w-full text-center bg-forest-600 hover:bg-forest-700 text-white font-body font-semibold text-sm px-4 py-3 rounded-full transition-colors">
            {D.browseCategories}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hotels in this destination -->
  {localHotels.length > 0 && (
    <section class="bg-warm-100 border-t border-warm-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <h2 class="font-display text-2xl font-bold text-warm-950 mb-8">
          {D.placesToStay(dest.data.name)}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {localHotels.map(h => (
            <HotelCard
              name={h.data.name}
              destination={h.data.destination}
              country={h.data.country}
              description={h.data.description}
              priceRange={h.data.priceRange}
              priceIndicator={h.data.priceIndicator}
              rating={h.data.rating}
              reviewCount={h.data.reviewCount}
              highlights={h.data.highlights}
              bookingUrl={h.data.bookingUrl}
              slug={h.slug}
              category={h.data.category}
              featured={h.data.featured}
              coverImage={h.data.coverImage}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
