---
import HotelRoundup from '../components/HotelRoundup.astro';
import { startPrice } from '../lib/site';
import { i18n, type Locale } from '../i18n';
import { countrySlug, roundupAlternates } from '../i18n/roundups';

interface Props { locale: Locale; cat: string; country: string; hs: any[]; catTitle: string; slug: string }
const { cat, country: enCountry, hs, catTitle, slug } = Astro.props;
const L = i18n(Astro.props.locale);
const { t } = L;
const B = t.best;
const country = L.country(enCountry);
const cheapest = [...hs].sort((a, b) => startPrice(a.data.priceRange) - startPrice(b.data.priceRange))[0];
const top = [...hs].sort((a, b) => b.data.rating - a.data.rating)[0];
const cheapFrom = L.range(cheapest.data.priceRange.split(/\s[-–]\s/)[0]);
const faq = B.faq({ cat: catTitle, country, names: hs.map((h: any) => h.data.name), top: top.data.name, topWhere: top.data.destination, cheapFrom, cheapest: cheapest.data.name });
const path = L.path('best', slug);
---
<HotelRoundup
  title={B.title(catTitle, country)}
  metaTitle={B.metaTitle(catTitle, country, hs.length)}
  metaDescription={B.metaDescription(catTitle, country, hs.slice(0, 3).map((h: any) => h.data.name))}
  intro={B.intro(catTitle, country, hs.length, top.data.name, top.data.destination, cheapest.data.name)}
  path={path}
  hotels={hs}
  crumbs={[{ name: t.hotel.categories, url: L.path('categories') }, { name: catTitle, url: L.path('categories', cat) }, { name: country, url: path }]}
  faq={faq}
  searchPlace={enCountry}
  related={[{ label: B.allCat(catTitle), url: L.path('categories', cat) }, { label: B.allIn(country), url: L.path('countries', countrySlug(L.locale, enCountry)) }]}
  alternates={await roundupAlternates('best', enCountry, cat)}
/>
