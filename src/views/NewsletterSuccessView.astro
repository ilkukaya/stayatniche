---
import BaseLayout from '../layouts/BaseLayout.astro';
import { i18n, type Locale } from '../i18n';
import { allAlternates } from '../i18n/content';
interface Props { locale: Locale }
const L = i18n(Astro.props.locale);
const N = L.t.newsletter;
---
<BaseLayout title={N.successTitle} description={N.successText} noIndex={true} alternates={allAlternates('newsletter-success')}>
  <section class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
    <p class="eyebrow text-gold-600">{N.successEyebrow}</p>
    <h1 class="mt-4 font-display text-5xl leading-[.95] text-warm-950 sm:text-6xl">{N.successTitle}</h1>
    <p class="mt-5 font-body text-lg text-warm-600">{N.successText}</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href={L.path('hotels')} class="rounded-full bg-forest-700 px-7 py-3.5 font-body text-sm font-semibold text-white hover:bg-forest-800">{L.t.saved.explore}</a>
      <a href={L.path('home')} class="rounded-full border border-warm-300 bg-white px-7 py-3.5 font-body text-sm font-semibold text-warm-900 hover:border-warm-500">{N.backHome}</a>
    </div>
  </section>
</BaseLayout>
