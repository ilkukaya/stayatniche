# ── HotelLook / Travelpayouts API ─────────────────────────────
HOTELLOOK_API_TOKEN=your_hotellook_api_token_here

# ── Newsletter Provider ──────────────────────────────────────
# Options: "beehiiv" | "mailchimp" | "brevo" | "none"
NEWSLETTER_PROVIDER=none

# Beehiiv (free up to 2,500 subscribers — recommended)
BEEHIIV_API_KEY=
BEEHIIV_PUB_ID=

# Mailchimp (free up to 500 contacts)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER=

# Brevo / Sendinblue (300 emails/day free)
BREVO_API_KEY=
BREVO_LIST_ID=

# ── Analytics ────────────────────────────────────────────────
# Set these in src/content/settings/analytics.json or as env vars
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GTM_CONTAINER_ID=GTM-XXXXXXX
# CLARITY_PROJECT_ID=
# PLAUSIBLE_DOMAIN=stayatniche.com
